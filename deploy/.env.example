# Copy to .env next to compose.yml and replace every value marked CHANGE-ME.
# Nothing in this file is a real secret.

# The URL agents, the CLI and git use to reach the server, no trailing slash. With the caddy
# profile this is https://<your domain>; without it, the address BEE_API_PORT is published on.
BEE_PUBLIC_URL=http://localhost:7420

# Image tags to run (build them with `docker compose build`, or point at a registry).
BEE_SERVER_IMAGE=bee-server:latest
BEE_WEB_IMAGE=bee-web:latest

# Postgres (the compose service). CHANGE-ME: any long random string; keep it URL-safe.
POSTGRES_USER=bee
POSTGRES_PASSWORD=CHANGE-ME-postgres-password
POSTGRES_DB=bee
BEE_POSTGRES_URL=postgres://bee:CHANGE-ME-postgres-password@postgres:5432/bee
# Forge tables, in their own schema of the same database. Keep the password equal to the one above.
BEE_FORGE_DATABASE=postgres://bee:CHANGE-ME-postgres-password@postgres:5432/bee?schema=bee_forge

# S3-compatible storage (the compose `s3` service, or your own). CHANGE-ME: access key 3+ chars,
# secret key 8+ chars. The compose service takes these as its root credentials.
BEE_S3_ENDPOINT=http://s3:9000
BEE_S3_BUCKET=bee
BEE_S3_ACCESS_KEY=CHANGE-ME-s3-access-key
BEE_S3_SECRET_KEY=CHANGE-ME-s3-secret-key

# Token signing key: 64 hex digits. CHANGE-ME: generate with `openssl rand -hex 32`.
# Losing it signs everyone out; changing it invalidates every issued token.
BEE_SIGNING_KEY_HEX=CHANGE-ME-64-hex-digits

# URL signing key for blob, CI transfer and media links: 64 hex digits. CHANGE-ME: generate a
# second value with `openssl rand -hex 32`; do not reuse the token signing key.
BEE_URL_KEY_HEX=CHANGE-ME-url-key-hex-digits

# Host ports. The server (API, git over HTTP, MCP) is published on the loopback interface by
# default; set BEE_API_BIND=0.0.0.0 to reach it from other machines without a proxy.
BEE_API_BIND=127.0.0.1
BEE_API_PORT=7420
BEE_WEB_PORT=3100
# Git over SSH (published on every interface).
BEE_SSH_PORT=2222

# Caddy profile only: the domain Caddy gets a certificate for, and the host ports it listens on.
BEE_DOMAIN=bee.example.com
BEE_HTTP_PORT=80
BEE_HTTPS_PORT=443
