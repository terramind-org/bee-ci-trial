{
  "$id": "https://bee.dev/schemas/v1/cli/git.credential.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Output of `bee git credential --json`: one such document with `schema` = bee.v1.git.credential. Git credential helper: answers git with the bee token for this endpoint. Errors print a document matching schemas/v1/error.schema.json.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "answered": {
          "description": "True when `get` returned a credential.",
          "type": "boolean"
        },
        "operation": {
          "enum": [
            "get",
            "store",
            "erase"
          ]
        },
        "password": {
          "description": "The token.",
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "required": [
        "operation",
        "answered"
      ],
      "type": "object"
    },
    "schema": {
      "const": "bee.v1.git.credential"
    }
  },
  "required": [
    "schema",
    "data"
  ],
  "title": "bee git credential",
  "type": "object"
}
