      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateSecretScanningPatternRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateSecretScanningPattern.\n\nOneof `scope`: at most one of `org`, `repo` is set.",
  "properties": {
    "afterRegex": {
      "type": "string"
    },
    "beforeRegex": {
      "type": "string"
    },
    "mustMatch": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "mustNotMatch": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "published": {
      "type": "boolean"
    },
    "pushProtection": {
      "type": "boolean"
    },
    "regex": {
      "type": "string"
    },
    "repo": {
