{
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.WorkflowCache.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One `actions/cache` entry. Entries are scoped by ref: a job reads its own ref's entries,\nthen its base ref's, then the default ref's.",
  "properties": {
    "committed": {
      "type": "boolean"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "key": {
      "type": "string"
    },
    "lastAccessedAt": {
      "format": "date-time",
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "sizeBytes": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "version": {
      "description": "hash of paths and compression, set by the cache client",
      "type": "string"
    }
  },
  "title": "bee.v1.WorkflowCache",
  "type": "object"
}
