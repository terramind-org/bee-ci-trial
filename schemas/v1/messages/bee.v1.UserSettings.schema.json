{
  "$defs": {
    "bee.v1.KeyValue": {
      "description": "A key/value pair with a string value (metadata, custom properties, variables).",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "bee.v1.KeyValue",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UserSettings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Account-wide preferences.",
  "properties": {
    "accessibility": {
      "description": "e.g. \"reduce_motion\"=\"true\"",
      "items": {
        "$ref": "#/$defs/bee.v1.KeyValue"
      },
      "type": "array"
    },
    "darkTheme": {
      "type": "string"
    },
    "diffView": {
      "description": "\"unified\" or \"split\"",
      "type": "string"
    },
    "editorIndent": {
      "description": "e.g. \"spaces:2\", \"tabs:8\"",
      "type": "string"
    },
    "keyboardShortcuts": {
      "description": "action -> key binding; empty value disables",
      "items": {
        "$ref": "#/$defs/bee.v1.KeyValue"
      },
      "type": "array"
    },
    "keyboardShortcutsEnabled": {
      "type": "boolean"
    },
    "lightTheme": {
      "type": "string"
    },
    "locale": {
      "description": "BCP 47",
      "type": "string"
    },
    "showPrivateContributions": {
      "type": "boolean"
    },
    "theme": {
      "description": "\"light\", \"dark\", \"system\", or a named theme",
      "type": "string"
    },
    "timeZone": {
      "description": "IANA name",
      "type": "string"
    },
    "vigilantMode": {
      "description": "flag unsigned changesets as unverified",
      "type": "boolean"
    }
  },
  "title": "bee.v1.UserSettings",
  "type": "object"
}
