{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SponsorFrequency": {
      "description": "How often a tier or sponsorship is paid.",
      "enum": [
        "SPONSOR_FREQUENCY_UNSPECIFIED",
        "SPONSOR_FREQUENCY_MONTHLY",
        "SPONSOR_FREQUENCY_ONE_TIME"
      ],
      "title": "bee.v1.SponsorFrequency",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateSponsorTierRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateSponsorTier.",
  "properties": {
    "amountCents": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "customAmount": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "frequency": {
      "$ref": "#/$defs/bee.v1.SponsorFrequency"
    },
    "login": {
      "description": "maintainee; empty = the caller",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "publish": {
      "description": "false creates a draft",
      "type": "boolean"
    },
    "sponsorOnlyRepos": {
      "items": {
        "$ref": "#/$defs/bee.v1.RepoRef"
      },
      "type": "array"
    },
    "welcomeMessage": {
      "type": "string"
    }
  },
  "title": "bee.v1.CreateSponsorTierRequest",
  "type": "object"
}
