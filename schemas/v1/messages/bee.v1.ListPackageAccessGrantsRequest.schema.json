  "properties": {
    "ecosystem": {
      "$ref": "#/$defs/bee.v1.PackageEcosystem"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    }
  },
  "title": "bee.v1.ListPackageAccessGrantsRequest",
  "type": "object"
}
