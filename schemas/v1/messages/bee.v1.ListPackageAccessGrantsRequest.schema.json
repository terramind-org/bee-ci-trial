      "enum": [
        "PACKAGE_ECOSYSTEM_UNSPECIFIED",
        "PACKAGE_ECOSYSTEM_CONTAINER",
        "PACKAGE_ECOSYSTEM_NPM",
        "PACKAGE_ECOSYSTEM_MAVEN",
        "PACKAGE_ECOSYSTEM_NUGET",
        "PACKAGE_ECOSYSTEM_RUBYGEMS",
        "PACKAGE_ECOSYSTEM_CARGO"
      ],
      "title": "bee.v1.PackageEcosystem",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListPackageAccessGrantsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
