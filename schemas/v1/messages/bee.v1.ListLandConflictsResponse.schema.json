{
  "$defs": {
    "bee.v1.Conflict": {
      "properties": {
        "base": {
          "$ref": "#/$defs/bee.v1.ConflictSide"
        },
        "hunks": {
          "items": {
            "$ref": "#/$defs/bee.v1.ConflictHunk"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.ConflictKind"
        },
        "ours": {
          "$ref": "#/$defs/bee.v1.ConflictSide"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "theirs": {
          "$ref": "#/$defs/bee.v1.ConflictSide"
        }
      },
      "title": "bee.v1.Conflict",
      "type": "object"
    },
    "bee.v1.ConflictHunk": {
      "properties": {
        "baseLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oursLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oursStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "theirsLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "theirsStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.ConflictHunk",
      "type": "object"
    },
    "bee.v1.ConflictKind": {
      "enum": [
        "CONFLICT_KIND_UNSPECIFIED",
        "CONFLICT_KIND_CONTENT",
        "CONFLICT_KIND_ADD_ADD",
        "CONFLICT_KIND_MODIFY_DELETE",
        "CONFLICT_KIND_SYMLINK",
        "CONFLICT_KIND_BINARY",
        "CONFLICT_KIND_REDACTED",
        "CONFLICT_KIND_MODE",
        "CONFLICT_KIND_FILE_DIRECTORY"
      ],
      "title": "bee.v1.ConflictKind",
      "type": "string"
    },
    "bee.v1.ConflictSet": {
      "description": "Structured conflicts: the server never writes markers (SPEC §7.3.2).",
      "properties": {
        "base": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "cleanEntries": {
          "items": {
            "$ref": "#/$defs/bee.v1.DeltaEntry"
          },
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/bee.v1.Conflict"
          },
          "type": "array"
        },
        "ours": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "theirs": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        }
      },
      "title": "bee.v1.ConflictSet",
      "type": "object"
    },
    "bee.v1.ConflictSide": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.Mode"
        }
      },
      "title": "bee.v1.ConflictSide",
      "type": "object"
    },
    "bee.v1.DeltaEntry": {
      "description": "Oneof `op`: at most one of `put`, `delete` is set.",
      "properties": {
        "delete": {
          "type": "boolean"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "put": {
          "$ref": "#/$defs/bee.v1.Put"
        }
      },
      "title": "bee.v1.DeltaEntry",
      "type": "object"
    },
    "bee.v1.LandConflict": {
      "description": "A conflict from a land, rebase or merge queue run, held for a resolver (SPEC §11.6).",
      "properties": {
        "changeRequestId": {
          "type": "string"
        },
        "conflicts": {
          "$ref": "#/$defs/bee.v1.ConflictSet"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "errorReason": {
          "description": "set when a submitted resolution was refused",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "repoId": {
          "type": "string"
        },
        "resolution": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "resolver": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.LandConflictState"
        }
      },
      "title": "bee.v1.LandConflict",
      "type": "object"
    },
    "bee.v1.LandConflictState": {
      "description": "State of a conflict waiting for a resolver.",
      "enum": [
        "LAND_CONFLICT_STATE_UNSPECIFIED",
        "LAND_CONFLICT_STATE_OPEN",
        "LAND_CONFLICT_STATE_RESOLUTION_SUBMITTED",
        "LAND_CONFLICT_STATE_RESOLVED",
        "LAND_CONFLICT_STATE_ABANDONED"
      ],
      "title": "bee.v1.LandConflictState",
      "type": "string"
    },
    "bee.v1.Mode": {
      "description": "File mode as stored in trees (SPEC §4.2).",
      "enum": [
        "MODE_UNSPECIFIED",
        "MODE_FILE",
        "MODE_EXECUTABLE",
        "MODE_SYMLINK",
        "MODE_TREE"
      ],
      "title": "bee.v1.Mode",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.Put": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.Mode"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Put",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListLandConflictsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "conflicts": {
      "items": {
        "$ref": "#/$defs/bee.v1.LandConflict"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListLandConflictsResponse",
  "type": "object"
}
