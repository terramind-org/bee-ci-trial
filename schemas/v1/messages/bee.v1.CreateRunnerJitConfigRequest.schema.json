{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.RunnerScope": {
      "description": "Names the repo or org that owns runners.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/bee.v1.RunnerScopeKind"
        },
        "org": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.RunnerScope",
      "type": "object"
    },
    "bee.v1.RunnerScopeKind": {
      "description": "Whether a runner resource belongs to a repo or an org.",
      "enum": [
        "RUNNER_SCOPE_KIND_UNSPECIFIED",
        "RUNNER_SCOPE_KIND_REPO",
        "RUNNER_SCOPE_KIND_ORG"
      ],
      "title": "bee.v1.RunnerScopeKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateRunnerJitConfigRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateRunnerJitConfig.",
  "properties": {
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "runnerGroupId": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.RunnerScope"
    },
    "workFolder": {
      "type": "string"
    }
  },
  "title": "bee.v1.CreateRunnerJitConfigRequest",
  "type": "object"
}
