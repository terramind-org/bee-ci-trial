{
  "$defs": {
    "bee.v1.SearchQualifier": {
      "description": "A parsed qualifier, e.g. `-label:bug` is key \"label\", value \"bug\", negated.",
      "properties": {
        "key": {
          "description": "empty for free-text terms",
          "type": "string"
        },
        "negated": {
          "type": "boolean"
        },
        "range": {
          "$ref": "#/$defs/bee.v1.SearchRange",
          "description": "position in the query string"
        },
        "regex": {
          "description": "value was /.../",
          "type": "boolean"
        },
        "resolved": {
          "description": "e.g. \"@me\" resolved to a login",
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "bee.v1.SearchQualifier",
      "type": "object"
    },
    "bee.v1.SearchQueryError": {
      "description": "A query error with its position.",
      "properties": {
        "message": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/bee.v1.SearchRange"
        },
        "subcode": {
          "description": "e.g. \"unknown_qualifier\", \"bad_regex\", \"unbalanced_paren\"",
          "type": "string"
        }
      },
      "title": "bee.v1.SearchQueryError",
      "type": "object"
    },
    "bee.v1.SearchRange": {
      "description": "A byte range within a line or text, half-open, in UTF-8 bytes.",
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.SearchRange",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ParseSearchQueryResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ParseSearchQuery.",
  "properties": {
    "errors": {
      "items": {
        "$ref": "#/$defs/bee.v1.SearchQueryError"
      },
      "type": "array"
    },
    "normalized": {
      "description": "canonical form of a valid query",
      "type": "string"
    },
    "qualifiers": {
      "items": {
        "$ref": "#/$defs/bee.v1.SearchQualifier"
      },
      "type": "array"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.ParseSearchQueryResponse",
  "type": "object"
}
