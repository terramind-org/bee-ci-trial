{
  "$defs": {
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    },
    "bee.v1.EnterpriseTwoFactorRequirement": {
      "description": "Whether members of an org or enterprise must use two-factor authentication.",
      "properties": {
        "noncompliantCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "required": {
          "type": "boolean"
        },
        "requiredSince": {
          "format": "date-time",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/bee.v1.EnterpriseScope"
        },
        "secureMethodsOnly": {
          "description": "passkeys and security keys only, no SMS or TOTP",
          "type": "boolean"
        }
      },
      "title": "bee.v1.EnterpriseTwoFactorRequirement",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateTwoFactorRequirementResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for UpdateTwoFactorRequirement.",
  "properties": {
    "removedPrincipalIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "requirement": {
      "$ref": "#/$defs/bee.v1.EnterpriseTwoFactorRequirement"
    }
  },
  "title": "bee.v1.UpdateTwoFactorRequirementResponse",
  "type": "object"
}
