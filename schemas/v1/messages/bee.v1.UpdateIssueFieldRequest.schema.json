{
  "$defs": {
    "bee.v1.IssueFieldIteration": {
      "description": "One iteration of an iteration issue field.",
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "durationDays": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "server-assigned; send empty to create",
          "type": "string"
        },
        "startOn": {
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.IssueFieldIteration",
      "type": "object"
    },
    "bee.v1.IssueFieldOption": {
      "description": "One choice of a single-select issue field.",
      "properties": {
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "description": "server-assigned; send empty to create",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "title": "bee.v1.IssueFieldOption",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateIssueFieldRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateIssueField.",
  "properties": {
    "description": {
      "type": "string"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "id": {
      "type": "string"
    },
    "issueTypeIds": {
      "description": "replaces when `set_issue_type_ids`",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "iterations": {
      "description": "replaces the iteration list when `set_iterations`",
      "items": {
        "$ref": "#/$defs/bee.v1.IssueFieldIteration"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "options": {
      "description": "replaces the option list when `set_options`",
      "items": {
        "$ref": "#/$defs/bee.v1.IssueFieldOption"
      },
      "type": "array"
    },
    "org": {
      "type": "string"
    },
    "setIssueTypeIds": {
      "type": "boolean"
    },
    "setIterations": {
      "type": "boolean"
    },
    "setOptions": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.UpdateIssueFieldRequest",
  "type": "object"
}
