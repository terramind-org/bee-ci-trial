{
  "$defs": {
    "bee.v1.ChangeId": {
      "description": "16-byte stable identity of a piece of work (SPEC §3.3).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ChangeId",
      "type": "object"
    },
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.DeltaEntry": {
      "description": "Oneof `op`: at most one of `put`, `delete` is set.",
      "properties": {
        "delete": {
          "type": "boolean"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "put": {
          "$ref": "#/$defs/bee.v1.Put"
        }
      },
      "title": "bee.v1.DeltaEntry",
      "type": "object"
    },
    "bee.v1.LocalCheck": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "title": "bee.v1.LocalCheck",
      "type": "object"
    },
    "bee.v1.MetaExtension": {
      "description": "An extension entry in Meta, keyed by a small integer (SPEC §4.3).",
      "properties": {
        "key": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.MetaExtension",
      "type": "object"
    },
    "bee.v1.Mode": {
      "description": "File mode as stored in trees (SPEC §4.2).",
      "enum": [
        "MODE_UNSPECIFIED",
        "MODE_FILE",
        "MODE_EXECUTABLE",
        "MODE_SYMLINK",
        "MODE_TREE"
      ],
      "title": "bee.v1.Mode",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Provenance": {
      "description": "Provenance claims recorded in Meta (SPEC §10.4).",
      "properties": {
        "checksRun": {
          "items": {
            "$ref": "#/$defs/bee.v1.LocalCheck"
          },
          "type": "array"
        },
        "cost": {
          "$ref": "#/$defs/bee.v1.Cost"
        },
        "model": {
          "type": "string"
        },
        "principalChain": {
          "description": "filled by the server",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "promptDigest": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "title": "bee.v1.Provenance",
      "type": "object"
    },
    "bee.v1.Put": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.Mode"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Put",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Signature": {
      "properties": {
        "name": {
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        },
        "tzOffsetMinutes": {
          "format": "int32",
          "type": "integer"
        }
      },
      "title": "bee.v1.Signature",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateChangesetRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "allowEmpty": {
      "type": "boolean"
    },
    "author": {
      "type": "string"
    },
    "authorTime": {
      "$ref": "#/$defs/bee.v1.Signature"
    },
    "changeId": {
      "$ref": "#/$defs/bee.v1.ChangeId"
    },
    "committer": {
      "description": "defaults to the author",
      "type": "string"
    },
    "committerTime": {
      "$ref": "#/$defs/bee.v1.Signature"
    },
    "delta": {
      "items": {
        "$ref": "#/$defs/bee.v1.DeltaEntry"
      },
      "type": "array"
    },
    "expectedRootTree": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "When set, the computed root tree must equal this id or the RPC fails with ROOT_TREE_MISMATCH."
    },
    "extensions": {
      "items": {
        "$ref": "#/$defs/bee.v1.MetaExtension"
      },
      "type": "array"
    },
    "importMode": {
      "description": "Importer mode (SPEC §17.4): keeps the supplied meta verbatim. Needs ref-admin and write on `/`.",
      "type": "boolean"
    },
    "message": {
      "type": "string"
    },
    "parents": {
      "items": {
        "$ref": "#/$defs/bee.v1.ObjectId"
      },
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/bee.v1.Provenance"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.CreateChangesetRequest",
  "type": "object"
}
