{
  "$defs": {
    "bee.v1.AgentRunBudget": {
      "description": "Spending and time limits for a run.",
      "properties": {
        "maxChangesets": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxDurationSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxInputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxLanded": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUsdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.AgentRunBudget",
      "type": "object"
    },
    "bee.v1.AgentRunScope": {
      "description": "The access a run's token is attenuated to; never broader than the starter's.",
      "properties": {
        "actions": {
          "description": "read, commit, land, review, lease",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "readPaths": {
          "description": "prefixes; empty = inherit",
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "description": "patterns, e.g. \"ws/*\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "writePaths": {
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.AgentRunScope",
      "type": "object"
    },
    "bee.v1.AgentTask": {
      "description": "The task given to a run.",
      "properties": {
        "alert": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "SECURITY_FIX"
        },
        "changeRequest": {
          "description": "CR number, for REVIEW and REVISE",
          "type": "string"
        },
        "contextBundleIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "issue": {
          "description": "issue number, for ISSUE",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.AgentTaskKind"
        },
        "postId": {
          "description": "ADOPT_EVALUATE: the post to evaluate",
          "type": "string"
        },
        "prompt": {
          "description": "FREEFORM, or extra guidance for other kinds",
          "type": "string"
        }
      },
      "title": "bee.v1.AgentTask",
      "type": "object"
    },
    "bee.v1.AgentTaskKind": {
      "description": "What a run is asked to do.",
      "enum": [
        "AGENT_TASK_KIND_UNSPECIFIED",
        "AGENT_TASK_KIND_ISSUE",
        "AGENT_TASK_KIND_REVIEW",
        "AGENT_TASK_KIND_FREEFORM",
        "AGENT_TASK_KIND_SECURITY_FIX",
        "AGENT_TASK_KIND_REVISE",
        "AGENT_TASK_KIND_ADOPT_EVALUATE"
      ],
      "title": "bee.v1.AgentTaskKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.StartAgentRunRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for StartAgentRun.",
  "properties": {
    "agentPrincipalId": {
      "description": "empty = create or reuse the caller's default agent",
      "type": "string"
    },
    "baseRef": {
      "description": "empty = default branch",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/bee.v1.AgentRunBudget"
    },
    "idempotencyKey": {
      "description": "same key returns the existing run",
      "type": "string"
    },
    "machineType": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "runtimeId": {
      "description": "empty = repo default",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.AgentRunScope"
    },
    "task": {
      "$ref": "#/$defs/bee.v1.AgentTask"
    }
  },
  "title": "bee.v1.StartAgentRunRequest",
  "type": "object"
}
