{
  "$defs": {
    "bee.v1.MilestoneState": {
      "description": "Open or closed state of a milestone.",
      "enum": [
        "MILESTONE_STATE_UNSPECIFIED",
        "MILESTONE_STATE_OPEN",
        "MILESTONE_STATE_CLOSED"
      ],
      "title": "bee.v1.MilestoneState",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.Milestone.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A repo milestone with progress.",
  "properties": {
    "closedAt": {
      "format": "date-time",
      "type": "string"
    },
    "closedItems": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "dueOn": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "number": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "openItems": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.MilestoneState"
    },
    "title": {
      "type": "string"
    }
  },
  "title": "bee.v1.Milestone",
  "type": "object"
}
