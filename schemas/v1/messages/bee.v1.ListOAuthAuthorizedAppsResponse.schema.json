{
  "$defs": {
    "bee.v1.OAuthClientKind": {
      "description": "Which kind of client an OAuth token or grant belongs to.",
      "enum": [
        "OAUTH_CLIENT_KIND_UNSPECIFIED",
        "OAUTH_CLIENT_KIND_OAUTH_APP",
        "OAUTH_CLIENT_KIND_APP"
      ],
      "title": "bee.v1.OAuthClientKind",
      "type": "string"
    },
    "bee.v1.OAuthGrant": {
      "description": "A user's standing grant to an OAuth client.",
      "properties": {
        "clientId": {
          "type": "string"
        },
        "clientKind": {
          "$ref": "#/$defs/bee.v1.OAuthClientKind"
        },
        "clientName": {
          "type": "string"
        },
        "grantedAt": {
          "format": "date-time",
          "type": "string"
        },
        "lastUsedAt": {
          "format": "date-time",
          "type": "string"
        },
        "owner": {
          "description": "client owner",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.OAuthGrant",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListOAuthAuthorizedAppsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListOAuthAuthorizedApps.",
  "properties": {
    "grants": {
      "items": {
        "$ref": "#/$defs/bee.v1.OAuthGrant"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListOAuthAuthorizedAppsResponse",
  "type": "object"
}
