{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SwarmRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SwarmRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.DecideSwarmJoinRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accept": {
      "type": "boolean"
    },
    "joinId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "swarm": {
      "$ref": "#/$defs/bee.v1.SwarmRef"
    }
  },
  "title": "bee.v1.DecideSwarmJoinRequest",
  "type": "object"
}
