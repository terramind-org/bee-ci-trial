          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "bee.v1.KeyValue",
      "type": "object"
    },
    "bee.v1.MetricSample": {
      "description": "One sample.",
      "properties": {
        "time": {
          "format": "date-time",
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "title": "bee.v1.MetricSample",
      "type": "object"
    },
    "bee.v1.MetricSeries": {
      "description": "One labelled series.",
