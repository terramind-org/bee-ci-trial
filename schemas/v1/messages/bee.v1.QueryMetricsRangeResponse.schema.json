          },
          "type": "array"
        }
      },
      "title": "bee.v1.MetricSeries",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.QueryMetricsRangeResponse.schema.json",
