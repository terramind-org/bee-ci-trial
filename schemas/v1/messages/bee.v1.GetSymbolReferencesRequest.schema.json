{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Revision": {
      "description": "A revision expression: ref name, ref@version, changeset id or unique prefix.",
      "properties": {
        "expr": {
          "type": "string"
        }
      },
      "title": "bee.v1.Revision",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetSymbolReferencesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GetSymbolReferences.",
  "properties": {
    "at": {
      "$ref": "#/$defs/bee.v1.Revision"
    },
    "column": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "crossRepo": {
      "type": "boolean"
    },
    "includeDeclaration": {
      "type": "boolean"
    },
    "line": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "path": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.GetSymbolReferencesRequest",
  "type": "object"
}
