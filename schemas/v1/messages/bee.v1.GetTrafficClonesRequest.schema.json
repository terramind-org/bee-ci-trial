{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.TrafficInterval": {
      "description": "Bucket size for traffic series.",
      "enum": [
        "TRAFFIC_INTERVAL_UNSPECIFIED",
        "TRAFFIC_INTERVAL_DAY",
        "TRAFFIC_INTERVAL_WEEK"
      ],
      "title": "bee.v1.TrafficInterval",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetTrafficClonesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GetTrafficClones.",
  "properties": {
    "interval": {
      "$ref": "#/$defs/bee.v1.TrafficInterval"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.GetTrafficClonesRequest",
  "type": "object"
}
