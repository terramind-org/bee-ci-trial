{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetNetworkGraphRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GetNetworkGraph.",
  "properties": {
    "includeForks": {
      "type": "boolean"
    },
    "maxNodes": {
      "description": "0 = server default",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "refs": {
      "description": "empty = all branches and tags",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "since": {
      "format": "date-time",
      "type": "string"
    },
    "until": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.GetNetworkGraphRequest",
  "type": "object"
}
