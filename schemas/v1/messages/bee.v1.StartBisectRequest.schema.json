{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.StartBisectRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bad": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "empty = the ref tip"
    },
    "checkName": {
      "type": "string"
    },
    "good": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "empty = the last changeset where the check passed"
    },
    "manual": {
      "description": "driven by MarkBisect instead of CI probes",
      "type": "boolean"
    },
    "openRevert": {
      "type": "boolean"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.StartBisectRequest",
  "type": "object"
}
