{
  "$defs": {
    "bee.v1.MinimizedReason": {
      "description": "Why a comment is minimized (PRODUCT §4.21).",
      "enum": [
        "MINIMIZED_REASON_UNSPECIFIED",
        "MINIMIZED_REASON_SPAM",
        "MINIMIZED_REASON_ABUSE",
        "MINIMIZED_REASON_OFF_TOPIC",
        "MINIMIZED_REASON_OUTDATED",
        "MINIMIZED_REASON_DUPLICATE",
        "MINIMIZED_REASON_RESOLVED"
      ],
      "title": "bee.v1.MinimizedReason",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.ReactionContent": {
      "description": "Reaction emoji, matching GitHub's fixed set.",
      "enum": [
        "REACTION_CONTENT_UNSPECIFIED",
        "REACTION_CONTENT_THUMBS_UP",
        "REACTION_CONTENT_THUMBS_DOWN",
        "REACTION_CONTENT_LAUGH",
        "REACTION_CONTENT_HOORAY",
        "REACTION_CONTENT_CONFUSED",
        "REACTION_CONTENT_HEART",
        "REACTION_CONTENT_ROCKET",
        "REACTION_CONTENT_EYES"
      ],
      "title": "bee.v1.ReactionContent",
      "type": "string"
    },
    "bee.v1.ReactionGroup": {
      "description": "Count of one reaction on a subject, and whether the caller is among them.",
      "properties": {
        "content": {
          "$ref": "#/$defs/bee.v1.ReactionContent"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "viewerReacted": {
          "type": "boolean"
        }
      },
      "title": "bee.v1.ReactionGroup",
      "type": "object"
    },
    "bee.v1.ReviewComment": {
      "properties": {
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fileLevel": {
          "description": "anchored to the file, not to lines",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "inReplyTo": {
          "description": "comment id this replies to",
          "type": "string"
        },
        "minimizedReason": {
          "$ref": "#/$defs/bee.v1.MinimizedReason"
        },
        "outdated": {
          "description": "the anchored lines changed in a later revision",
          "type": "boolean"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReactionGroup"
          },
          "type": "array"
        },
        "revision": {
          "description": "revision the anchor was last valid on",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "side": {
          "description": "\"old\" | \"new\"",
          "type": "string"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "suggestion": {
          "$ref": "#/$defs/bee.v1.Suggestion",
          "description": "a suggested replacement for the anchored lines"
        },
        "threadId": {
          "type": "string"
        }
      },
      "title": "bee.v1.ReviewComment",
      "type": "object"
    },
    "bee.v1.Suggestion": {
      "description": "Replacement text for the lines a review comment anchors to.",
      "properties": {
        "applied": {
          "type": "boolean"
        },
        "appliedIn": {
          "$ref": "#/$defs/bee.v1.ObjectId",
          "description": "changeset that applied it"
        },
        "replacement": {
          "description": "new content for start_line..end_line, without trailing newline",
          "type": "string"
        }
      },
      "title": "bee.v1.Suggestion",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ReviewThread.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A review thread: a line or file comment and its replies.",
  "properties": {
    "changeRequestId": {
      "type": "string"
    },
    "comments": {
      "items": {
        "$ref": "#/$defs/bee.v1.ReviewComment"
      },
      "type": "array"
    },
    "endLine": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "outdated": {
      "type": "boolean"
    },
    "path": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "resolved": {
      "type": "boolean"
    },
    "resolvedBy": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "revision": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "side": {
      "type": "string"
    },
    "startLine": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.ReviewThread",
  "type": "object"
}
