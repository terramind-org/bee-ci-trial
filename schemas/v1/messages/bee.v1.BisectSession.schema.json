{
  "$defs": {
    "bee.v1.Bisect": {
      "description": "A bisect of a landed range for a failing post-land check (SPEC §11.6).",
      "properties": {
        "bad": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "checkName": {
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "firstBad": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "good": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "repoId": {
          "type": "string"
        },
        "revertChangeRequestId": {
          "description": "revert CR opened (or landed) for first_bad",
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.BisectState"
        },
        "tested": {
          "items": {
            "$ref": "#/$defs/bee.v1.ObjectId"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.Bisect",
      "type": "object"
    },
    "bee.v1.BisectOutcome": {
      "description": "A manual mark or a probe's result.",
      "enum": [
        "BISECT_OUTCOME_UNSPECIFIED",
        "BISECT_OUTCOME_GOOD",
        "BISECT_OUTCOME_BAD",
        "BISECT_OUTCOME_SKIP"
      ],
      "title": "bee.v1.BisectOutcome",
      "type": "string"
    },
    "bee.v1.BisectProbe": {
      "description": "One probe or mark of a session.",
      "properties": {
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "outcome": {
          "$ref": "#/$defs/bee.v1.BisectOutcome"
        },
        "probeId": {
          "description": "the prober's handle (a workflow run id for CI probes)",
          "type": "string"
        },
        "round": {
          "description": "0 = history or a mark",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "source": {
          "description": "\"probe\", \"history\" or the principal that marked it",
          "type": "string"
        }
      },
      "title": "bee.v1.BisectProbe",
      "type": "object"
    },
    "bee.v1.BisectState": {
      "description": "State of a bisect.",
      "enum": [
        "BISECT_STATE_UNSPECIFIED",
        "BISECT_STATE_RUNNING",
        "BISECT_STATE_FOUND",
        "BISECT_STATE_INCONCLUSIVE",
        "BISECT_STATE_CANCELLED",
        "BISECT_STATE_FLAKY"
      ],
      "title": "bee.v1.BisectState",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.BisectSession.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A bisect session in full.",
  "properties": {
    "bisect": {
      "$ref": "#/$defs/bee.v1.Bisect"
    },
    "candidates": {
      "description": "oldest first; the last is the failing changeset",
      "items": {
        "$ref": "#/$defs/bee.v1.ObjectId"
      },
      "type": "array"
    },
    "culpritAuthor": {
      "type": "string"
    },
    "culpritChangeRequestId": {
      "type": "string"
    },
    "failingUrl": {
      "type": "string"
    },
    "mode": {
      "description": "\"auto\" or \"manual\"",
      "type": "string"
    },
    "note": {
      "description": "why it ended as it did, and what happened to the revert",
      "type": "string"
    },
    "probes": {
      "items": {
        "$ref": "#/$defs/bee.v1.BisectProbe"
      },
      "type": "array"
    },
    "revertLanded": {
      "type": "boolean"
    },
    "rounds": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.BisectSession",
  "type": "object"
}
