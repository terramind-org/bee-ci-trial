{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Secret": {
      "description": "Secret metadata. The value is never returned by any RPC.",
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "name": {
          "description": "upper snake case, unique within the scope",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/bee.v1.SecretScope"
        },
        "selectedRepoCount": {
          "description": "when visibility is SELECTED",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "updatedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "visibility": {
          "$ref": "#/$defs/bee.v1.SecretVisibility"
        }
      },
      "title": "bee.v1.Secret",
      "type": "object"
    },
    "bee.v1.SecretScope": {
      "description": "Names a secret or variable scope. Fill the fields the kind needs: ORG uses `org`; REPO uses\n`repo`; ENVIRONMENT uses `repo` and `environment`; WORKSPACE_USER and AGENT use\n`principal_id` (and `org` when the agent is org-owned).",
      "properties": {
        "environment": {
          "description": "environment name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SecretScopeKind"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        },
        "principalId": {
          "description": "user or agent ULID",
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SecretScope",
      "type": "object"
    },
    "bee.v1.SecretScopeKind": {
      "description": "Where a secret or variable lives.",
      "enum": [
        "SECRET_SCOPE_KIND_UNSPECIFIED",
        "SECRET_SCOPE_KIND_ORG",
        "SECRET_SCOPE_KIND_REPO",
        "SECRET_SCOPE_KIND_ENVIRONMENT",
        "SECRET_SCOPE_KIND_WORKSPACE_USER",
        "SECRET_SCOPE_KIND_AGENT"
      ],
      "title": "bee.v1.SecretScopeKind",
      "type": "string"
    },
    "bee.v1.SecretVisibility": {
      "description": "Which repos can read an org-level (or workspace-user) secret or variable.",
      "enum": [
        "SECRET_VISIBILITY_UNSPECIFIED",
        "SECRET_VISIBILITY_ALL",
        "SECRET_VISIBILITY_PRIVATE",
        "SECRET_VISIBILITY_SELECTED"
      ],
      "title": "bee.v1.SecretVisibility",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListSecretsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListSecrets.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "secrets": {
      "items": {
        "$ref": "#/$defs/bee.v1.Secret"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListSecretsResponse",
  "type": "object"
}
