{
  "$defs": {
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.ModelFinishReason": {
      "description": "Why generation stopped.",
      "enum": [
        "MODEL_FINISH_REASON_UNSPECIFIED",
        "MODEL_FINISH_REASON_STOP",
        "MODEL_FINISH_REASON_LENGTH",
        "MODEL_FINISH_REASON_TOOL_CALLS",
        "MODEL_FINISH_REASON_CONTENT_FILTER"
      ],
      "title": "bee.v1.ModelFinishReason",
      "type": "string"
    },
    "bee.v1.ModelToolCall": {
      "description": "A tool call the model made.",
      "properties": {
        "arguments": {
          "description": "JSON",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "title": "bee.v1.ModelToolCall",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ModelInferenceChunk.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One streamed piece of an inference response.",
  "properties": {
    "contentDelta": {
      "type": "string"
    },
    "cost": {
      "$ref": "#/$defs/bee.v1.Cost",
      "description": "set on the last chunk"
    },
    "finishReason": {
      "$ref": "#/$defs/bee.v1.ModelFinishReason",
      "description": "set on the last chunk"
    },
    "id": {
      "type": "string"
    },
    "toolCalls": {
      "description": "complete tool calls, sent when known",
      "items": {
        "$ref": "#/$defs/bee.v1.ModelToolCall"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ModelInferenceChunk",
  "type": "object"
}
