{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SecurityAdvisoryCredit": {
      "description": "A principal or team credited on, or collaborating on, an advisory.",
      "properties": {
        "principalId": {
          "type": "string"
        },
        "role": {
          "description": "\"finder\", \"reporter\", \"remediation_developer\", \"collaborator\"",
          "type": "string"
        },
        "teamId": {
          "type": "string"
        }
      },
      "title": "bee.v1.SecurityAdvisoryCredit",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.AddSecurityAdvisoryCollaboratorRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for AddSecurityAdvisoryCollaborator.",
  "properties": {
    "collaborator": {
      "$ref": "#/$defs/bee.v1.SecurityAdvisoryCredit"
    },
    "ghsaId": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.AddSecurityAdvisoryCollaboratorRequest",
  "type": "object"
}
