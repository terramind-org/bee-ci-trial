{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateWorkspaceRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateWorkspace.",
  "properties": {
    "devcontainerPath": {
      "description": "empty = \".devcontainer/devcontainer.json\"",
      "type": "string"
    },
    "idempotencyKey": {
      "type": "string"
    },
    "idleTimeoutSeconds": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "machineType": {
      "type": "string"
    },
    "name": {
      "description": "empty = generated",
      "type": "string"
    },
    "ownerPrincipalId": {
      "description": "agent owned by the caller; empty = caller",
      "type": "string"
    },
    "ref": {
      "description": "empty = default branch",
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "retentionSeconds": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "sparsePaths": {
      "items": {
        "contentEncoding": "base64",
        "type": "string"
      },
      "type": "array"
    },
    "usePrebuild": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.CreateWorkspaceRequest",
  "type": "object"
}
