        "RUNNER_ARCH_X64",
        "RUNNER_ARCH_ARM64"
      ],
      "title": "bee.v1.RunnerArch",
      "type": "string"
    },
    "bee.v1.RunnerOs": {
      "description": "Operating system of a runner or machine class.",
      "enum": [
        "RUNNER_OS_UNSPECIFIED",
        "RUNNER_OS_LINUX",
        "RUNNER_OS_MACOS",
        "RUNNER_OS_WINDOWS"
      ],
      "title": "bee.v1.RunnerOs",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateRunnerCustomImageRequest.schema.json",
