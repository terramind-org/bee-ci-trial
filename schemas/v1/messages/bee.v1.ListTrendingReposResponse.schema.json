{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SearchRange": {
      "description": "A byte range within a line or text, half-open, in UTF-8 bytes.",
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.SearchRange",
      "type": "object"
    },
    "bee.v1.SearchRepoHit": {
      "description": "A repo search result.",
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "forkCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "fullName": {
          "type": "string"
        },
        "isFork": {
          "type": "boolean"
        },
        "isTemplate": {
          "type": "boolean"
        },
        "licenseSpdxId": {
          "type": "string"
        },
        "openIssueCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "primaryLanguage": {
          "type": "string"
        },
        "pushedAt": {
          "format": "date-time",
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "score": {
          "type": "number"
        },
        "starCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "textMatches": {
          "items": {
            "$ref": "#/$defs/bee.v1.SearchTextMatch"
          },
          "type": "array"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "visibility": {
          "description": "\"public\", \"internal\", \"private\"",
          "type": "string"
        }
      },
      "title": "bee.v1.SearchRepoHit",
      "type": "object"
    },
    "bee.v1.SearchTextMatch": {
      "description": "Highlighted text for a matched field.",
      "properties": {
        "field": {
          "description": "e.g. \"title\", \"body\"",
          "type": "string"
        },
        "fragment": {
          "type": "string"
        },
        "ranges": {
          "description": "within fragment",
          "items": {
            "$ref": "#/$defs/bee.v1.SearchRange"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.SearchTextMatch",
      "type": "object"
    },
    "bee.v1.TrendingRepo": {
      "description": "A trending repo with its window activity.",
      "properties": {
        "builtBy": {
          "description": "top contributors",
          "items": {
            "$ref": "#/$defs/bee.v1.Principal"
          },
          "type": "array"
        },
        "forksInWindow": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "rank": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.SearchRepoHit"
        },
        "starsInWindow": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.TrendingRepo",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListTrendingReposResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListTrendingRepos.",
  "properties": {
    "computedAt": {
      "format": "date-time",
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "repos": {
      "items": {
        "$ref": "#/$defs/bee.v1.TrendingRepo"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListTrendingReposResponse",
  "type": "object"
}
