{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SetResolverHookRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agentPrincipalId": {
      "type": "string"
    },
    "autoLand": {
      "type": "boolean"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "secret": {
      "description": "HMAC key for deliveries; write-only",
      "type": "string"
    },
    "timeoutSeconds": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "url": {
      "type": "string"
    }
  },
  "title": "bee.v1.SetResolverHookRequest",
  "type": "object"
}
