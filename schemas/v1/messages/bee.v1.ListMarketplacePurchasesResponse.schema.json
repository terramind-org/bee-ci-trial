{
  "$defs": {
    "bee.v1.MarketplaceBillingCycle": {
      "description": "Billing cycle of a purchase.",
      "enum": [
        "MARKETPLACE_BILLING_CYCLE_UNSPECIFIED",
        "MARKETPLACE_BILLING_CYCLE_MONTHLY",
        "MARKETPLACE_BILLING_CYCLE_YEARLY"
      ],
      "title": "bee.v1.MarketplaceBillingCycle",
      "type": "string"
    },
    "bee.v1.MarketplacePurchase": {
      "description": "An org's purchase of a plan.",
      "properties": {
        "billingCycle": {
          "$ref": "#/$defs/bee.v1.MarketplaceBillingCycle"
        },
        "cancelledAt": {
          "format": "date-time",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "freeTrialEndsAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "listingId": {
          "type": "string"
        },
        "nextBillingAt": {
          "format": "date-time",
          "type": "string"
        },
        "onFreeTrial": {
          "type": "boolean"
        },
        "org": {
          "type": "string"
        },
        "pendingCancellation": {
          "description": "ends at next_billing_at",
          "type": "boolean"
        },
        "planId": {
          "type": "string"
        },
        "purchasedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "unitCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.MarketplacePurchase",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListMarketplacePurchasesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListMarketplacePurchases.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "purchases": {
      "items": {
        "$ref": "#/$defs/bee.v1.MarketplacePurchase"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListMarketplacePurchasesResponse",
  "type": "object"
}
