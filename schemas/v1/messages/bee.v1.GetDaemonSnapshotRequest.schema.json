{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetDaemonSnapshotRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sparsePrefixes": {
      "description": "the scope the daemon serves; empty = whole repo",
      "items": {
        "contentEncoding": "base64",
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.GetDaemonSnapshotRequest",
  "type": "object"
}
