{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.SymbolInfo": {
      "description": "A symbol definition.",
      "properties": {
        "container": {
          "description": "enclosing symbol name",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SymbolKind"
        },
        "language": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qualifiedName": {
          "description": "e.g. \"billing::invoice::Invoice::total\"",
          "type": "string"
        },
        "signature": {
          "description": "one-line declaration text",
          "type": "string"
        }
      },
      "title": "bee.v1.SymbolInfo",
      "type": "object"
    },
    "bee.v1.SymbolKind": {
      "description": "Kind of a code symbol.",
      "enum": [
        "SYMBOL_KIND_UNSPECIFIED",
        "SYMBOL_KIND_FILE",
        "SYMBOL_KIND_MODULE",
        "SYMBOL_KIND_NAMESPACE",
        "SYMBOL_KIND_PACKAGE",
        "SYMBOL_KIND_CLASS",
        "SYMBOL_KIND_METHOD",
        "SYMBOL_KIND_PROPERTY",
        "SYMBOL_KIND_FIELD",
        "SYMBOL_KIND_CONSTRUCTOR",
        "SYMBOL_KIND_ENUM",
        "SYMBOL_KIND_INTERFACE",
        "SYMBOL_KIND_FUNCTION",
        "SYMBOL_KIND_VARIABLE",
        "SYMBOL_KIND_CONSTANT",
        "SYMBOL_KIND_STRUCT",
        "SYMBOL_KIND_TRAIT",
        "SYMBOL_KIND_TYPE_ALIAS",
        "SYMBOL_KIND_MACRO",
        "SYMBOL_KIND_ENUM_MEMBER"
      ],
      "title": "bee.v1.SymbolKind",
      "type": "string"
    },
    "bee.v1.SymbolOutlineNode": {
      "description": "One node in a file's symbol outline.",
      "properties": {
        "children": {
          "items": {
            "$ref": "#/$defs/bee.v1.SymbolOutlineNode"
          },
          "type": "array"
        },
        "range": {
          "$ref": "#/$defs/bee.v1.SymbolRange",
          "description": "whole declaration"
        },
        "selectionRange": {
          "$ref": "#/$defs/bee.v1.SymbolRange",
          "description": "the name"
        },
        "symbol": {
          "$ref": "#/$defs/bee.v1.SymbolInfo"
        }
      },
      "title": "bee.v1.SymbolOutlineNode",
      "type": "object"
    },
    "bee.v1.SymbolRange": {
      "description": "A position range in a file: 1-based lines, 0-based UTF-8 byte columns, end exclusive.",
      "properties": {
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.SymbolRange",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetDocumentSymbolsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GetDocumentSymbols.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "language": {
      "type": "string"
    },
    "symbols": {
      "items": {
        "$ref": "#/$defs/bee.v1.SymbolOutlineNode"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.GetDocumentSymbolsResponse",
  "type": "object"
}
