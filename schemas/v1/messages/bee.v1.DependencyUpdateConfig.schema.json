{
  "$defs": {
    "bee.v1.DependencyUpdateEntry": {
      "description": "One configured update entry, mirroring an entry of the repo's update config file.",
      "properties": {
        "directory": {
          "type": "string"
        },
        "ecosystem": {
          "type": "string"
        },
        "groups": {
          "description": "group names for grouped updates",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "openChangeRequestLimit": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "schedule": {
          "description": "\"daily\", \"weekly\", \"monthly\" or a cron expression",
          "type": "string"
        },
        "targetRef": {
          "type": "string"
        }
      },
      "title": "bee.v1.DependencyUpdateEntry",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.DependencyUpdateConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Automated security and version update configuration for a repo.",
  "properties": {
    "actorPrincipalId": {
      "description": "bot agent principal that opens update CRs",
      "type": "string"
    },
    "configErrors": {
      "description": "parse errors in the config file",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "configPath": {
      "description": "path of the config file read from the default branch",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/bee.v1.DependencyUpdateEntry"
      },
      "type": "array"
    },
    "groupedSecurityUpdates": {
      "type": "boolean"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "securityUpdatesEnabled": {
      "type": "boolean"
    },
    "versionUpdatesEnabled": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.DependencyUpdateConfig",
  "type": "object"
}
