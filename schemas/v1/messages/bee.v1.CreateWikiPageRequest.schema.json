{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WikiPageFormat": {
      "description": "Markup language of a wiki page, chosen by file extension.",
      "enum": [
        "WIKI_PAGE_FORMAT_UNSPECIFIED",
        "WIKI_PAGE_FORMAT_MARKDOWN",
        "WIKI_PAGE_FORMAT_ASCIIDOC",
        "WIKI_PAGE_FORMAT_RST",
        "WIKI_PAGE_FORMAT_ORG",
        "WIKI_PAGE_FORMAT_TEXTILE",
        "WIKI_PAGE_FORMAT_MEDIAWIKI"
      ],
      "title": "bee.v1.WikiPageFormat",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateWikiPageRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateWikiPage.",
  "properties": {
    "content": {
      "type": "string"
    },
    "format": {
      "$ref": "#/$defs/bee.v1.WikiPageFormat",
      "description": "default MARKDOWN"
    },
    "message": {
      "description": "commit message; default \"Create <title>\"",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "title": {
      "type": "string"
    }
  },
  "title": "bee.v1.CreateWikiPageRequest",
  "type": "object"
}
