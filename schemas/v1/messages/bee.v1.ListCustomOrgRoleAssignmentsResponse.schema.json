{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.PolicyOrgRoleAssignment": {
      "description": "An org-level role held by a principal or team.\n\nOneof `assignee`: at most one of `principalId`, `teamId` is set.",
      "properties": {
        "assignedAt": {
          "format": "date-time",
          "type": "string"
        },
        "assignedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "org": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "role": {
          "description": "custom org role id",
          "type": "string"
        },
        "teamId": {
          "type": "string"
        }
      },
      "title": "bee.v1.PolicyOrgRoleAssignment",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListCustomOrgRoleAssignmentsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListCustomOrgRoleAssignments.",
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/bee.v1.PolicyOrgRoleAssignment"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListCustomOrgRoleAssignmentsResponse",
  "type": "object"
}
