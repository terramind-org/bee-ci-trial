{
  "$defs": {
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.LocalCheck": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "title": "bee.v1.LocalCheck",
      "type": "object"
    },
    "bee.v1.Provenance": {
      "description": "Provenance claims recorded in Meta (SPEC §10.4).",
      "properties": {
        "checksRun": {
          "items": {
            "$ref": "#/$defs/bee.v1.LocalCheck"
          },
          "type": "array"
        },
        "cost": {
          "$ref": "#/$defs/bee.v1.Cost"
        },
        "model": {
          "type": "string"
        },
        "principalChain": {
          "description": "filled by the server",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "promptDigest": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "title": "bee.v1.Provenance",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ExportWorkspaceChangesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ExportWorkspaceChanges.",
  "properties": {
    "id": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "openChangeRequest": {
      "type": "boolean"
    },
    "provenance": {
      "$ref": "#/$defs/bee.v1.Provenance",
      "description": "agent claims recorded in Meta"
    },
    "targetRef": {
      "description": "CR target; empty = workspace's base ref",
      "type": "string"
    }
  },
  "title": "bee.v1.ExportWorkspaceChangesRequest",
  "type": "object"
}
