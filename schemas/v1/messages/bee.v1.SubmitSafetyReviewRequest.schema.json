{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SafetyEvidence": {
      "properties": {
        "observation": {
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/bee.v1.SubjectRef"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.SafetyEvidence",
      "type": "object"
    },
    "bee.v1.SafetyFindingReport": {
      "properties": {
        "evidence": {
          "$ref": "#/$defs/bee.v1.SafetyEvidence"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SafetySignalKind"
        },
        "severity": {
          "$ref": "#/$defs/bee.v1.SafetySeverity"
        }
      },
      "title": "bee.v1.SafetyFindingReport",
      "type": "object"
    },
    "bee.v1.SafetyRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SafetyWorkKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SafetyRef",
      "type": "object"
    },
    "bee.v1.SafetySeverity": {
      "enum": [
        "SAFETY_SEVERITY_UNSPECIFIED",
        "SAFETY_SEVERITY_NOTE",
        "SAFETY_SEVERITY_WARNING",
        "SAFETY_SEVERITY_SEVERE"
      ],
      "title": "bee.v1.SafetySeverity",
      "type": "string"
    },
    "bee.v1.SafetySignalKind": {
      "enum": [
        "SAFETY_SIGNAL_KIND_UNSPECIFIED",
        "SAFETY_SIGNAL_KIND_OUTSIDE_TASK",
        "SAFETY_SIGNAL_KIND_AROUND_REFUSAL",
        "SAFETY_SIGNAL_KIND_TESTS_WEAKENED",
        "SAFETY_SIGNAL_KIND_OWN_LEASH",
        "SAFETY_SIGNAL_KIND_SAID_VS_SHOWN",
        "SAFETY_SIGNAL_KIND_SECRETS_AND_EXIT",
        "SAFETY_SIGNAL_KIND_FOLLOWING_STRANGERS",
        "SAFETY_SIGNAL_KIND_HARM_TO_CODE",
        "SAFETY_SIGNAL_KIND_HARM_TO_OTHERS",
        "SAFETY_SIGNAL_KIND_LEGAL_FLAGS"
      ],
      "title": "bee.v1.SafetySignalKind",
      "type": "string"
    },
    "bee.v1.SafetyVerdict": {
      "enum": [
        "SAFETY_VERDICT_UNSPECIFIED",
        "SAFETY_VERDICT_AS_ASKED",
        "SAFETY_VERDICT_MORE_THAN_ASKED",
        "SAFETY_VERDICT_LESS_THAN_ASKED",
        "SAFETY_VERDICT_SOMETHING_ELSE",
        "SAFETY_VERDICT_NEEDS_A_LOOK"
      ],
      "title": "bee.v1.SafetyVerdict",
      "type": "string"
    },
    "bee.v1.SafetyWorkKind": {
      "enum": [
        "SAFETY_WORK_KIND_UNSPECIFIED",
        "SAFETY_WORK_KIND_RUN",
        "SAFETY_WORK_KIND_SWARM"
      ],
      "title": "bee.v1.SafetyWorkKind",
      "type": "string"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SubmitSafetyReviewRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/bee.v1.SafetyFindingReport"
      },
      "type": "array"
    },
    "model": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "proposedVerdict": {
      "$ref": "#/$defs/bee.v1.SafetyVerdict"
    },
    "reviewId": {
      "type": "string"
    },
    "work": {
      "$ref": "#/$defs/bee.v1.SafetyRef"
    }
  },
  "title": "bee.v1.SubmitSafetyReviewRequest",
  "type": "object"
}
