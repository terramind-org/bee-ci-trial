{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.SearchRange": {
      "description": "A byte range within a line or text, half-open, in UTF-8 bytes.",
      "properties": {
        "end": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.SearchRange",
      "type": "object"
    },
    "bee.v1.SearchTextMatch": {
      "description": "Highlighted text for a matched field.",
      "properties": {
        "field": {
          "description": "e.g. \"title\", \"body\"",
          "type": "string"
        },
        "fragment": {
          "type": "string"
        },
        "ranges": {
          "description": "within fragment",
          "items": {
            "$ref": "#/$defs/bee.v1.SearchRange"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.SearchTextMatch",
      "type": "object"
    },
    "bee.v1.SearchUserHit": {
      "description": "A user, agent or org search result.",
      "properties": {
        "avatarUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "followerCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "isOrg": {
          "type": "boolean"
        },
        "location": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "publicRepoCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "textMatches": {
          "items": {
            "$ref": "#/$defs/bee.v1.SearchTextMatch"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.SearchUserHit",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SearchUsersResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for SearchUsers.",
  "properties": {
    "hits": {
      "items": {
        "$ref": "#/$defs/bee.v1.SearchUserHit"
      },
      "type": "array"
    },
    "incomplete": {
      "type": "boolean"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "totalCount": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.SearchUsersResponse",
  "type": "object"
}
