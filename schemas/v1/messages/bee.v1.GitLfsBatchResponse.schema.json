{
  "$defs": {
    "bee.v1.GitLfsAction": {
      "description": "One action the client performs for an object.",
      "properties": {
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "headers": {
          "items": {
            "$ref": "#/$defs/bee.v1.KeyValue"
          },
          "type": "array"
        },
        "href": {
          "description": "signed",
          "type": "string"
        },
        "kind": {
          "description": "\"download\", \"upload\" or \"verify\"",
          "type": "string"
        }
      },
      "title": "bee.v1.GitLfsAction",
      "type": "object"
    },
    "bee.v1.GitLfsObjectResult": {
      "description": "Batch result for one object.",
      "properties": {
        "actions": {
          "description": "empty on upload when the server already has it",
          "items": {
            "$ref": "#/$defs/bee.v1.GitLfsAction"
          },
          "type": "array"
        },
        "authenticated": {
          "type": "boolean"
        },
        "errorCode": {
          "description": "LFS error code (404, 410, 422, ...); 0 = none",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "errorMessage": {
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.GitLfsObjectResult",
      "type": "object"
    },
    "bee.v1.KeyValue": {
      "description": "A key/value pair with a string value (metadata, custom properties, variables).",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "bee.v1.KeyValue",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GitLfsBatchResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GitLfsBatch.",
  "properties": {
    "hashAlgo": {
      "type": "string"
    },
    "objects": {
      "items": {
        "$ref": "#/$defs/bee.v1.GitLfsObjectResult"
      },
      "type": "array"
    },
    "transfer": {
      "type": "string"
    }
  },
  "title": "bee.v1.GitLfsBatchResponse",
  "type": "object"
}
