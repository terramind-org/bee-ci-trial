{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.ProjectFieldKind": {
      "description": "Type of a project field. Custom fields use TEXT through ITERATION; the rest are built-in\nfields derived from the item's content.",
      "enum": [
        "PROJECT_FIELD_KIND_UNSPECIFIED",
        "PROJECT_FIELD_KIND_TEXT",
        "PROJECT_FIELD_KIND_NUMBER",
        "PROJECT_FIELD_KIND_DATE",
        "PROJECT_FIELD_KIND_SINGLE_SELECT",
        "PROJECT_FIELD_KIND_ITERATION",
        "PROJECT_FIELD_KIND_TITLE",
        "PROJECT_FIELD_KIND_ASSIGNEES",
        "PROJECT_FIELD_KIND_LABELS",
        "PROJECT_FIELD_KIND_MILESTONE",
        "PROJECT_FIELD_KIND_REPOSITORY",
        "PROJECT_FIELD_KIND_LINKED_CHANGES",
        "PROJECT_FIELD_KIND_REVIEWERS",
        "PROJECT_FIELD_KIND_PARENT_ISSUE",
        "PROJECT_FIELD_KIND_SUB_ISSUES_PROGRESS",
        "PROJECT_FIELD_KIND_ISSUE_TYPE"
      ],
      "title": "bee.v1.ProjectFieldKind",
      "type": "string"
    },
    "bee.v1.ProjectFieldValue": {
      "description": "An item's value for one field. Custom fields set exactly one typed value; built-in fields\nare read-only and set `display_value`.\n\nOneof `value`: at most one of `text`, `number`, `dateOn`, `optionId`, `iterationId` is set.",
      "properties": {
        "dateOn": {
          "format": "date-time",
          "type": "string"
        },
        "displayValue": {
          "description": "human-readable rendering of any field",
          "type": "string"
        },
        "fieldId": {
          "type": "string"
        },
        "fieldName": {
          "description": "filled by the server",
          "type": "string"
        },
        "iterationId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.ProjectFieldKind",
          "description": "filled by the server"
        },
        "number": {
          "type": "number"
        },
        "optionId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "title": "bee.v1.ProjectFieldValue",
      "type": "object"
    },
    "bee.v1.ProjectItem": {
      "description": "A row on a project.",
      "properties": {
        "archived": {
          "type": "boolean"
        },
        "archivedAt": {
          "format": "date-time",
          "type": "string"
        },
        "assignees": {
          "items": {
            "$ref": "#/$defs/bee.v1.Principal"
          },
          "type": "array"
        },
        "body": {
          "description": "drafts only",
          "type": "string"
        },
        "content": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "issue or CR; unset for drafts"
        },
        "contentState": {
          "description": "\"open\", \"closed\", \"landed\", \"draft\"",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "creator": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "fieldValues": {
          "items": {
            "$ref": "#/$defs/bee.v1.ProjectFieldValue"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.ProjectItemKind"
        },
        "number": {
          "description": "issues and CRs",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "position": {
          "description": "opaque manual-order key; compare as bytes",
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "repoFullName": {
          "description": "issues and CRs",
          "type": "string"
        },
        "title": {
          "description": "content title, or the draft title",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.ProjectItem",
      "type": "object"
    },
    "bee.v1.ProjectItemKind": {
      "description": "What an item points at.",
      "enum": [
        "PROJECT_ITEM_KIND_UNSPECIFIED",
        "PROJECT_ITEM_KIND_ISSUE",
        "PROJECT_ITEM_KIND_CHANGE_REQUEST",
        "PROJECT_ITEM_KIND_DRAFT",
        "PROJECT_ITEM_KIND_REDACTED"
      ],
      "title": "bee.v1.ProjectItemKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListProjectItemsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListProjectItems.",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/bee.v1.ProjectItem"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "totalCount": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.ListProjectItemsResponse",
  "type": "object"
}
