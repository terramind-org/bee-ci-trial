{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateProjectWorkflowRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateProjectWorkflow.",
  "properties": {
    "archiveAfterDays": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "fieldId": {
      "type": "string"
    },
    "filter": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "optionId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "sourceRepo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "unset = unchanged"
    },
    "workflowId": {
      "type": "string"
    }
  },
  "title": "bee.v1.UpdateProjectWorkflowRequest",
  "type": "object"
}
