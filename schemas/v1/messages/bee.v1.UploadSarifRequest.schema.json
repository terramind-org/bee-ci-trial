{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UploadSarifRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UploadSarif.\n\nOneof `sarif`: at most one of `sarifGzip`, `sarifUrl` is set.",
  "properties": {
    "category": {
      "description": "distinguishes several analyses of one tool",
      "type": "string"
    },
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "checkoutUri": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sarifGzip": {
      "contentEncoding": "base64",
      "description": "gzip-compressed SARIF, up to 10 MiB",
      "type": "string"
    },
    "sarifUrl": {
      "description": "signed URL the server fetches",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "toolName": {
      "type": "string"
    }
  },
  "title": "bee.v1.UploadSarifRequest",
  "type": "object"
}
