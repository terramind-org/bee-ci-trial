{
  "$defs": {
    "bee.v1.ConflictSide": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.Mode"
        }
      },
      "title": "bee.v1.ConflictSide",
      "type": "object"
    },
    "bee.v1.DiffHunk": {
      "properties": {
        "lines": {
          "description": "prefixed with ' ', '+', '-'",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "newLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "newStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oldLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oldStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.DiffHunk",
      "type": "object"
    },
    "bee.v1.DiffStatus": {
      "description": "How a path changed between two revisions.",
      "enum": [
        "DIFF_STATUS_UNSPECIFIED",
        "DIFF_STATUS_ADDED",
        "DIFF_STATUS_MODIFIED",
        "DIFF_STATUS_DELETED",
        "DIFF_STATUS_RENAMED",
        "DIFF_STATUS_COPIED",
        "DIFF_STATUS_MODE_CHANGED"
      ],
      "title": "bee.v1.DiffStatus",
      "type": "string"
    },
    "bee.v1.Mode": {
      "description": "File mode as stored in trees (SPEC §4.2).",
      "enum": [
        "MODE_UNSPECIFIED",
        "MODE_FILE",
        "MODE_EXECUTABLE",
        "MODE_SYMLINK",
        "MODE_TREE"
      ],
      "title": "bee.v1.Mode",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.DiffItem.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "additions": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "binary": {
      "type": "boolean"
    },
    "deletions": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "diffClass": {
      "description": "SPEC §11.3, when computed",
      "type": "string"
    },
    "hunks": {
      "items": {
        "$ref": "#/$defs/bee.v1.DiffHunk"
      },
      "type": "array"
    },
    "new": {
      "$ref": "#/$defs/bee.v1.ConflictSide"
    },
    "old": {
      "$ref": "#/$defs/bee.v1.ConflictSide"
    },
    "oldPath": {
      "contentEncoding": "base64",
      "description": "renames and copies",
      "type": "string"
    },
    "path": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "similarity": {
      "description": "percent, renames and copies",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/bee.v1.DiffStatus"
    },
    "truncated": {
      "description": "the diff was cut at max_files or a size limit after this item",
      "type": "boolean"
    }
  },
  "title": "bee.v1.DiffItem",
  "type": "object"
}
