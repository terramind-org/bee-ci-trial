{
  "$defs": {
    "bee.v1.ModerationCommunityFile": {
      "description": "One community file and where it was found.",
      "properties": {
        "detected": {
          "description": "e.g. SPDX id or code of conduct key",
          "type": "string"
        },
        "kind": {
          "description": "\"readme\", \"license\", \"code_of_conduct\", \"contributing\",",
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "present": {
          "description": "\"security\", \"support\", \"issue_template\", \"pr_template\",\n\"funding\", \"agents\"",
          "type": "boolean"
        },
        "sourceRepo": {
          "$ref": "#/$defs/bee.v1.RepoRef",
          "description": "set when inherited from the org's .github repo"
        }
      },
      "title": "bee.v1.ModerationCommunityFile",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ModerationCommunityProfile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A repo's community health profile.",
  "properties": {
    "description": {
      "type": "string"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/bee.v1.ModerationCommunityFile"
      },
      "type": "array"
    },
    "hasDescription": {
      "type": "boolean"
    },
    "healthPercentage": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.ModerationCommunityProfile",
  "type": "object"
}
