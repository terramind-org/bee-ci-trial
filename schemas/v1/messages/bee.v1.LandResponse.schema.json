{
  "$defs": {
    "bee.v1.ChangeId": {
      "description": "16-byte stable identity of a piece of work (SPEC §3.3).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ChangeId",
      "type": "object"
    },
    "bee.v1.LandedChange": {
      "properties": {
        "changeId": {
          "$ref": "#/$defs/bee.v1.ChangeId"
        },
        "result": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "skipped": {
          "description": "already landed from the same source",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        }
      },
      "title": "bee.v1.LandedChange",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Ref": {
      "properties": {
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "version": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Ref",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.LandResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attempts": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "eventSeq": {
      "description": "repo event sequence of the land, for read-your-writes",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "landed": {
      "items": {
        "$ref": "#/$defs/bee.v1.LandedChange"
      },
      "type": "array"
    },
    "ref": {
      "$ref": "#/$defs/bee.v1.Ref"
    }
  },
  "title": "bee.v1.LandResponse",
  "type": "object"
}
