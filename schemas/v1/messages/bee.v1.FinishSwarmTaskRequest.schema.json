{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SwarmAttemptOutcome": {
      "enum": [
        "SWARM_ATTEMPT_OUTCOME_UNSPECIFIED",
        "SWARM_ATTEMPT_OUTCOME_FINISHED",
        "SWARM_ATTEMPT_OUTCOME_EMPTY",
        "SWARM_ATTEMPT_OUTCOME_REFUSED"
      ],
      "title": "bee.v1.SwarmAttemptOutcome",
      "type": "string"
    },
    "bee.v1.SwarmHandBack": {
      "properties": {
        "concerns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deviations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "done": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "followUps": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.SwarmHandBack",
      "type": "object"
    },
    "bee.v1.SwarmRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SwarmRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.FinishSwarmTaskRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "attemptNumber": {
      "description": "1-based position in task.attempts",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "handBack": {
      "$ref": "#/$defs/bee.v1.SwarmHandBack"
    },
    "outcome": {
      "$ref": "#/$defs/bee.v1.SwarmAttemptOutcome"
    },
    "reason": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "swarm": {
      "$ref": "#/$defs/bee.v1.SwarmRef"
    },
    "taskId": {
      "type": "string"
    }
  },
  "title": "bee.v1.FinishSwarmTaskRequest",
  "type": "object"
}
