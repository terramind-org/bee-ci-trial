{
  "$defs": {
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.EvalRunState": {
      "description": "Eval run lifecycle.",
      "enum": [
        "EVAL_RUN_STATE_UNSPECIFIED",
        "EVAL_RUN_STATE_QUEUED",
        "EVAL_RUN_STATE_RUNNING",
        "EVAL_RUN_STATE_SUCCEEDED",
        "EVAL_RUN_STATE_FAILED",
        "EVAL_RUN_STATE_CANCELLED"
      ],
      "title": "bee.v1.EvalRunState",
      "type": "string"
    },
    "bee.v1.EvalScore": {
      "description": "Aggregate score for one evaluator.",
      "properties": {
        "evaluator": {
          "type": "string"
        },
        "failed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mean": {
          "type": "number"
        },
        "passed": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.EvalScore",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.EvalRun.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An eval of a prompt file.",
  "properties": {
    "casesDone": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "casesTotal": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "checkRunId": {
      "description": "check run reporting the result, if requested",
      "type": "string"
    },
    "cost": {
      "$ref": "#/$defs/bee.v1.Cost"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "datasetPath": {
      "contentEncoding": "base64",
      "description": "empty = the prompt file's inline test data",
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "finishedAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "promptPath": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "resultsUrl": {
      "description": "signed URL to per-case results JSON",
      "type": "string"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/bee.v1.EvalScore"
      },
      "type": "array"
    },
    "startedBy": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.EvalRunState"
    }
  },
  "title": "bee.v1.EvalRun",
  "type": "object"
}
