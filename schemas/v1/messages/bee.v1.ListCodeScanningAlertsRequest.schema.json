{
  "$defs": {
    "bee.v1.CodeScanningAlertState": {
      "description": "State of a code scanning alert.",
      "enum": [
        "CODE_SCANNING_ALERT_STATE_UNSPECIFIED",
        "CODE_SCANNING_ALERT_STATE_OPEN",
        "CODE_SCANNING_ALERT_STATE_DISMISSED",
        "CODE_SCANNING_ALERT_STATE_FIXED"
      ],
      "title": "bee.v1.CodeScanningAlertState",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SecuritySeverity": {
      "description": "Severity used by advisories, alerts and findings.",
      "enum": [
        "SECURITY_SEVERITY_UNSPECIFIED",
        "SECURITY_SEVERITY_LOW",
        "SECURITY_SEVERITY_MEDIUM",
        "SECURITY_SEVERITY_HIGH",
        "SECURITY_SEVERITY_CRITICAL"
      ],
      "title": "bee.v1.SecuritySeverity",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListCodeScanningAlertsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListCodeScanningAlerts.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "pathPrefix": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "severities": {
      "items": {
        "$ref": "#/$defs/bee.v1.SecuritySeverity"
      },
      "type": "array"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/bee.v1.CodeScanningAlertState"
      },
      "type": "array"
    },
    "toolName": {
      "type": "string"
    }
  },
  "title": "bee.v1.ListCodeScanningAlertsRequest",
  "type": "object"
}
