{
  "$defs": {
    "bee.v1.EvidenceAssetDigest": {
      "description": "The digest the caller computed for one uploaded asset.",
      "properties": {
        "role": {
          "$ref": "#/$defs/bee.v1.EvidenceAssetRole"
        },
        "sha256": {
          "description": "lowercase hex of the uploaded bytes",
          "type": "string"
        }
      },
      "title": "bee.v1.EvidenceAssetDigest",
      "type": "object"
    },
    "bee.v1.EvidenceAssetRole": {
      "description": "The part an asset plays in its evidence item.",
      "enum": [
        "EVIDENCE_ASSET_ROLE_UNSPECIFIED",
        "EVIDENCE_ASSET_ROLE_MAIN",
        "EVIDENCE_ASSET_ROLE_BEFORE",
        "EVIDENCE_ASSET_ROLE_AFTER",
        "EVIDENCE_ASSET_ROLE_POSTER",
        "EVIDENCE_ASSET_ROLE_CAPTIONS"
      ],
      "title": "bee.v1.EvidenceAssetRole",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.FinalizeEvidenceRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for FinalizeEvidence.",
  "properties": {
    "digests": {
      "description": "one per asset",
      "items": {
        "$ref": "#/$defs/bee.v1.EvidenceAssetDigest"
      },
      "type": "array"
    },
    "evidenceId": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.FinalizeEvidenceRequest",
  "type": "object"
}
