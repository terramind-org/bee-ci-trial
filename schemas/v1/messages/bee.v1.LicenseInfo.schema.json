{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.LicenseInfo.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A detected license.",
  "properties": {
    "additional": {
      "description": "other licenses found (multi-licensed repos)",
      "items": {
        "$ref": "#"
      },
      "type": "array"
    },
    "blob": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "conditions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "confidence": {
      "description": "0..1",
      "type": "number"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "matcher": {
      "description": "e.g. \"exact\", \"dice\", \"package_manifest\"",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "permissions": {
      "description": "e.g. \"commercial-use\"",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "spdxId": {
      "description": "e.g. \"Apache-2.0\"; \"NOASSERTION\" when unrecognized",
      "type": "string"
    }
  },
  "title": "bee.v1.LicenseInfo",
  "type": "object"
}
