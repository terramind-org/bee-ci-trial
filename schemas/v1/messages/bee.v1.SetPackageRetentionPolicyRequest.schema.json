{
  "$defs": {
    "bee.v1.PackageEcosystem": {
      "description": "The registry a package belongs to.",
      "enum": [
        "PACKAGE_ECOSYSTEM_UNSPECIFIED",
        "PACKAGE_ECOSYSTEM_CONTAINER",
        "PACKAGE_ECOSYSTEM_NPM",
        "PACKAGE_ECOSYSTEM_MAVEN",
        "PACKAGE_ECOSYSTEM_NUGET",
        "PACKAGE_ECOSYSTEM_RUBYGEMS",
        "PACKAGE_ECOSYSTEM_CARGO"
      ],
      "title": "bee.v1.PackageEcosystem",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SetPackageRetentionPolicyRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for SetPackageRetentionPolicy.",
  "properties": {
    "ecosystem": {
      "$ref": "#/$defs/bee.v1.PackageEcosystem"
    },
    "keepLast": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "name": {
      "description": "empty = the owner's default",
      "type": "string"
    },
    "olderThanDays": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "owner": {
      "type": "string"
    },
    "untaggedDays": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.SetPackageRetentionPolicyRequest",
  "type": "object"
}
