{
  "$defs": {
    "bee.v1.ModelMessage": {
      "description": "One chat message.",
      "properties": {
        "content": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/bee.v1.ModelMessageRole"
        },
        "toolCallId": {
          "description": "TOOL messages",
          "type": "string"
        }
      },
      "title": "bee.v1.ModelMessage",
      "type": "object"
    },
    "bee.v1.ModelMessageRole": {
      "description": "Role of a chat message.",
      "enum": [
        "MODEL_MESSAGE_ROLE_UNSPECIFIED",
        "MODEL_MESSAGE_ROLE_SYSTEM",
        "MODEL_MESSAGE_ROLE_USER",
        "MODEL_MESSAGE_ROLE_ASSISTANT",
        "MODEL_MESSAGE_ROLE_TOOL"
      ],
      "title": "bee.v1.ModelMessageRole",
      "type": "string"
    },
    "bee.v1.ModelParams": {
      "description": "Sampling parameters.",
      "properties": {
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "responseFormat": {
          "description": "\"text\" or \"json\"",
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "stop": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temperature": {
          "type": "number"
        },
        "topP": {
          "type": "number"
        }
      },
      "title": "bee.v1.ModelParams",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.PromptFile": {
      "description": "A parsed `.prompt.yml` file.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "description": {
          "type": "string"
        },
        "evaluators": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "messages": {
          "description": "templates with {{variables}}",
          "items": {
            "$ref": "#/$defs/bee.v1.ModelMessage"
          },
          "type": "array"
        },
        "model": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/bee.v1.ModelParams"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "raw": {
          "description": "YAML source, when requested",
          "type": "string"
        },
        "testDataCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "variables": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.PromptFile",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListPromptFilesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListPromptFiles.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "promptFiles": {
      "description": "parsed headers only",
      "items": {
        "$ref": "#/$defs/bee.v1.PromptFile"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListPromptFilesResponse",
  "type": "object"
}
