{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SafetyFindingState": {
      "enum": [
        "SAFETY_FINDING_STATE_UNSPECIFIED",
        "SAFETY_FINDING_STATE_OPEN",
        "SAFETY_FINDING_STATE_DISMISSED",
        "SAFETY_FINDING_STATE_CONFIRMED"
      ],
      "title": "bee.v1.SafetyFindingState",
      "type": "string"
    },
    "bee.v1.SafetyRef": {
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SafetyWorkKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SafetyRef",
      "type": "object"
    },
    "bee.v1.SafetyWorkKind": {
      "enum": [
        "SAFETY_WORK_KIND_UNSPECIFIED",
        "SAFETY_WORK_KIND_RUN",
        "SAFETY_WORK_KIND_SWARM"
      ],
      "title": "bee.v1.SafetyWorkKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ResolveFindingRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "findingId": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.SafetyFindingState"
    },
    "work": {
      "$ref": "#/$defs/bee.v1.SafetyRef"
    }
  },
  "title": "bee.v1.ResolveFindingRequest",
  "type": "object"
}
