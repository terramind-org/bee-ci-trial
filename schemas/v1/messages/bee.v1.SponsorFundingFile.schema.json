{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SponsorFundingLink": {
      "description": "One platform entry in FUNDING.yml.",
      "properties": {
        "accounts": {
          "description": "usernames as written",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "platform": {
          "description": "e.g. \"github\", \"open_collective\", \"ko_fi\", \"custom\"",
          "type": "string"
        },
        "urls": {
          "description": "resolved links",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.SponsorFundingLink",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SponsorFundingFile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A parsed FUNDING.yml.",
  "properties": {
    "blob": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/bee.v1.SponsorFundingLink"
      },
      "type": "array"
    },
    "path": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "warnings": {
      "description": "unknown platforms or too many entries",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.SponsorFundingFile",
  "type": "object"
}
