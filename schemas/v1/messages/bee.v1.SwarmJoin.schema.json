{
  "$defs": {
    "bee.v1.AgentRunBudget": {
      "description": "Spending and time limits for a run.",
      "properties": {
        "maxChangesets": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxDurationSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxInputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxLanded": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUsdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.AgentRunBudget",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.SwarmJoinState": {
      "enum": [
        "SWARM_JOIN_STATE_UNSPECIFIED",
        "SWARM_JOIN_STATE_PENDING",
        "SWARM_JOIN_STATE_ACCEPTED",
        "SWARM_JOIN_STATE_DECLINED",
        "SWARM_JOIN_STATE_REFUSED"
      ],
      "title": "bee.v1.SwarmJoinState",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SwarmJoin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "agent": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "budget": {
      "$ref": "#/$defs/bee.v1.AgentRunBudget"
    },
    "decidedAt": {
      "format": "date-time",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "requestedAt": {
      "format": "date-time",
      "type": "string"
    },
    "requester": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "runId": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.SwarmJoinState"
    }
  },
  "title": "bee.v1.SwarmJoin",
  "type": "object"
}
