{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Ref": {
      "properties": {
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "version": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Ref",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ResolveRefResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ref": {
      "$ref": "#/$defs/bee.v1.Ref"
    },
    "renamedTo": {
      "description": "Set when the requested name was renamed (RenameRef) and no longer exists: `ref` is the\nref it was renamed to.",
      "type": "string"
    },
    "rootTree": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "stale": {
      "description": "True when served from a replica or cache while the primary is unreachable (SPEC §15.1).",
      "type": "boolean"
    }
  },
  "title": "bee.v1.ResolveRefResponse",
  "type": "object"
}
