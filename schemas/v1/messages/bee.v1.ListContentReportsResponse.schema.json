{
  "$defs": {
    "bee.v1.ModerationReport": {
      "description": "A content report.",
      "properties": {
        "action": {
          "$ref": "#/$defs/bee.v1.ModerationReportAction"
        },
        "audience": {
          "$ref": "#/$defs/bee.v1.ModerationReportAudience"
        },
        "body": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/bee.v1.ModerationReportCategory"
        },
        "contentAuthor": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "reporter": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "resolutionNote": {
          "type": "string"
        },
        "resolvedAt": {
          "format": "date-time",
          "type": "string"
        },
        "resolvedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.ModerationReportState"
        },
        "subject": {
          "$ref": "#/$defs/bee.v1.SubjectRef"
        }
      },
      "title": "bee.v1.ModerationReport",
      "type": "object"
    },
    "bee.v1.ModerationReportAction": {
      "description": "Action taken when resolving a report.",
      "enum": [
        "MODERATION_REPORT_ACTION_UNSPECIFIED",
        "MODERATION_REPORT_ACTION_NONE",
        "MODERATION_REPORT_ACTION_CONTENT_MINIMIZED",
        "MODERATION_REPORT_ACTION_CONTENT_DELETED",
        "MODERATION_REPORT_ACTION_USER_BLOCKED",
        "MODERATION_REPORT_ACTION_CONVERSATION_LOCKED",
        "MODERATION_REPORT_ACTION_INTERACTION_LIMITED",
        "MODERATION_REPORT_ACTION_TAKEN_DOWN",
        "MODERATION_REPORT_ACTION_ACCOUNT_SUSPENDED"
      ],
      "title": "bee.v1.ModerationReportAction",
      "type": "string"
    },
    "bee.v1.ModerationReportAudience": {
      "description": "Who handles a report.",
      "enum": [
        "MODERATION_REPORT_AUDIENCE_UNSPECIFIED",
        "MODERATION_REPORT_AUDIENCE_MAINTAINERS",
        "MODERATION_REPORT_AUDIENCE_SITE_ADMINS"
      ],
      "title": "bee.v1.ModerationReportAudience",
      "type": "string"
    },
    "bee.v1.ModerationReportCategory": {
      "description": "Why content is reported.",
      "enum": [
        "MODERATION_REPORT_CATEGORY_UNSPECIFIED",
        "MODERATION_REPORT_CATEGORY_SPAM",
        "MODERATION_REPORT_CATEGORY_ABUSE",
        "MODERATION_REPORT_CATEGORY_HARASSMENT",
        "MODERATION_REPORT_CATEGORY_OFF_TOPIC",
        "MODERATION_REPORT_CATEGORY_MALWARE",
        "MODERATION_REPORT_CATEGORY_COPYRIGHT",
        "MODERATION_REPORT_CATEGORY_PRIVACY",
        "MODERATION_REPORT_CATEGORY_AGENT_FLOOD",
        "MODERATION_REPORT_CATEGORY_OTHER"
      ],
      "title": "bee.v1.ModerationReportCategory",
      "type": "string"
    },
    "bee.v1.ModerationReportState": {
      "description": "Report lifecycle.",
      "enum": [
        "MODERATION_REPORT_STATE_UNSPECIFIED",
        "MODERATION_REPORT_STATE_OPEN",
        "MODERATION_REPORT_STATE_RESOLVED",
        "MODERATION_REPORT_STATE_DISMISSED"
      ],
      "title": "bee.v1.ModerationReportState",
      "type": "string"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListContentReportsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListContentReports.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "reports": {
      "items": {
        "$ref": "#/$defs/bee.v1.ModerationReport"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListContentReportsResponse",
  "type": "object"
}
