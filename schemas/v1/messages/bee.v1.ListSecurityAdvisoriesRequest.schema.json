{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SecurityAdvisoryState": {
      "description": "Lifecycle of a repo advisory.",
      "enum": [
        "SECURITY_ADVISORY_STATE_UNSPECIFIED",
        "SECURITY_ADVISORY_STATE_TRIAGE",
        "SECURITY_ADVISORY_STATE_DRAFT",
        "SECURITY_ADVISORY_STATE_PUBLISHED",
        "SECURITY_ADVISORY_STATE_CLOSED",
        "SECURITY_ADVISORY_STATE_WITHDRAWN"
      ],
      "title": "bee.v1.SecurityAdvisoryState",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListSecurityAdvisoriesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListSecurityAdvisories.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.SecurityAdvisoryState",
      "description": "UNSPECIFIED = all visible"
    }
  },
  "title": "bee.v1.ListSecurityAdvisoriesRequest",
  "type": "object"
}
