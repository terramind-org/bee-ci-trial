{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SetAgentFeedTriggerRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for SetAgentFeedTrigger. Creates the trigger or replaces its settings.",
  "properties": {
    "agent": {
      "description": "agent principal id or login",
      "type": "string"
    },
    "dailyUsdBudget": {
      "description": "0 = unlimited",
      "type": "number"
    },
    "enabled": {
      "type": "boolean"
    },
    "maxRunsPerDay": {
      "description": "0 = unlimited",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sources": {
      "description": "replaces the followed set; each must be readable by the agent",
      "items": {
        "$ref": "#/$defs/bee.v1.RepoRef"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.SetAgentFeedTriggerRequest",
  "type": "object"
}
