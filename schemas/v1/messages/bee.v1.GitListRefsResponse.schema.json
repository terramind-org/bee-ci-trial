{
  "$defs": {
    "bee.v1.GitObjectFormat": {
      "description": "Hash function of a repo's git representation. One format per repo.",
      "enum": [
        "GIT_OBJECT_FORMAT_UNSPECIFIED",
        "GIT_OBJECT_FORMAT_SHA1",
        "GIT_OBJECT_FORMAT_SHA256"
      ],
      "title": "bee.v1.GitObjectFormat",
      "type": "string"
    },
    "bee.v1.GitRefAdvertisement": {
      "description": "One advertised ref.",
      "properties": {
        "name": {
          "description": "e.g. \"refs/heads/main\", \"HEAD\"",
          "type": "string"
        },
        "oid": {
          "description": "empty when unborn",
          "type": "string"
        },
        "peeledOid": {
          "description": "annotated tag target",
          "type": "string"
        },
        "symrefTarget": {
          "description": "e.g. \"refs/heads/main\" for HEAD",
          "type": "string"
        },
        "unborn": {
          "type": "boolean"
        },
        "version": {
          "description": "bee ref version, for compare-and-swap on push",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.GitRefAdvertisement",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GitListRefsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GitListRefs.",
  "properties": {
    "capabilities": {
      "description": "capabilities the frontend should advertise",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "objectFormat": {
      "$ref": "#/$defs/bee.v1.GitObjectFormat"
    },
    "policyEpoch": {
      "type": "string"
    },
    "refs": {
      "items": {
        "$ref": "#/$defs/bee.v1.GitRefAdvertisement"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.GitListRefsResponse",
  "type": "object"
}
