{
  "$defs": {
    "bee.v1.NotificationReason": {
      "description": "Why a notification was delivered.",
      "enum": [
        "NOTIFICATION_REASON_UNSPECIFIED",
        "NOTIFICATION_REASON_REVIEW_REQUESTED",
        "NOTIFICATION_REASON_MENTION",
        "NOTIFICATION_REASON_TEAM_MENTION",
        "NOTIFICATION_REASON_ASSIGN",
        "NOTIFICATION_REASON_AUTHOR",
        "NOTIFICATION_REASON_COMMENT",
        "NOTIFICATION_REASON_STATE_CHANGE",
        "NOTIFICATION_REASON_CI_ACTIVITY",
        "NOTIFICATION_REASON_SECURITY_ALERT",
        "NOTIFICATION_REASON_SUBSCRIBED",
        "NOTIFICATION_REASON_MANUAL",
        "NOTIFICATION_REASON_AGENT_RUN"
      ],
      "title": "bee.v1.NotificationReason",
      "type": "string"
    },
    "bee.v1.NotificationSubscriptionState": {
      "description": "How the caller follows one subject.",
      "enum": [
        "NOTIFICATION_SUBSCRIPTION_STATE_UNSPECIFIED",
        "NOTIFICATION_SUBSCRIPTION_STATE_SUBSCRIBED",
        "NOTIFICATION_SUBSCRIPTION_STATE_UNSUBSCRIBED",
        "NOTIFICATION_SUBSCRIPTION_STATE_IGNORED"
      ],
      "title": "bee.v1.NotificationSubscriptionState",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.NotificationSubscription.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The caller's subscription to a subject.",
  "properties": {
    "reason": {
      "$ref": "#/$defs/bee.v1.NotificationReason",
      "description": "why subscribed, when implicit"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.NotificationSubscriptionState"
    },
    "subject": {
      "$ref": "#/$defs/bee.v1.SubjectRef"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.NotificationSubscription",
  "type": "object"
}
