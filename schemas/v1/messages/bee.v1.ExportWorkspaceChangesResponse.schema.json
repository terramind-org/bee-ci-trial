{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Ref": {
      "properties": {
        "name": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "version": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Ref",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ExportWorkspaceChangesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ExportWorkspaceChanges.",
  "properties": {
    "changeRequest": {
      "description": "CR number, when opened",
      "type": "string"
    },
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "ref": {
      "$ref": "#/$defs/bee.v1.Ref",
      "description": "the updated workspace ref"
    }
  },
  "title": "bee.v1.ExportWorkspaceChangesResponse",
  "type": "object"
}
