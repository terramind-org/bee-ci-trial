{
  "$defs": {
    "bee.v1.AgentRunEvent": {
      "description": "One event in a run's session log.",
      "properties": {
        "author": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "STEERING_MESSAGE sender"
        },
        "cost": {
          "$ref": "#/$defs/bee.v1.Cost",
          "description": "COST_UPDATE: cumulative"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.AgentRunEventKind"
        },
        "runId": {
          "type": "string"
        },
        "seq": {
          "description": "strictly increasing per run",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "state": {
          "$ref": "#/$defs/bee.v1.AgentRunState",
          "description": "STATE_CHANGED"
        },
        "subject": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "the changeset, CR, lease or check this event concerns"
        },
        "text": {
          "description": "LOG, THOUGHT, STEERING_MESSAGE, ERROR",
          "type": "string"
        },
        "time": {
          "format": "date-time",
          "type": "string"
        },
        "toolName": {
          "description": "TOOL_CALL, TOOL_RESULT",
          "type": "string"
        },
        "toolPayload": {
          "description": "JSON arguments or result, truncated and secret-scrubbed",
          "type": "string"
        }
      },
      "title": "bee.v1.AgentRunEvent",
      "type": "object"
    },
    "bee.v1.AgentRunEventKind": {
      "description": "Kind of session event.",
      "enum": [
        "AGENT_RUN_EVENT_KIND_UNSPECIFIED",
        "AGENT_RUN_EVENT_KIND_STATE_CHANGED",
        "AGENT_RUN_EVENT_KIND_LOG",
        "AGENT_RUN_EVENT_KIND_THOUGHT",
        "AGENT_RUN_EVENT_KIND_TOOL_CALL",
        "AGENT_RUN_EVENT_KIND_TOOL_RESULT",
        "AGENT_RUN_EVENT_KIND_CHANGESET_CREATED",
        "AGENT_RUN_EVENT_KIND_CHANGE_REQUEST_OPENED",
        "AGENT_RUN_EVENT_KIND_LEASE_ACQUIRED",
        "AGENT_RUN_EVENT_KIND_CHECK_RESULT",
        "AGENT_RUN_EVENT_KIND_STEERING_MESSAGE",
        "AGENT_RUN_EVENT_KIND_COST_UPDATE",
        "AGENT_RUN_EVENT_KIND_ERROR"
      ],
      "title": "bee.v1.AgentRunEventKind",
      "type": "string"
    },
    "bee.v1.AgentRunState": {
      "description": "Run lifecycle.",
      "enum": [
        "AGENT_RUN_STATE_UNSPECIFIED",
        "AGENT_RUN_STATE_QUEUED",
        "AGENT_RUN_STATE_PROVISIONING",
        "AGENT_RUN_STATE_RUNNING",
        "AGENT_RUN_STATE_WAITING_FOR_REVIEW",
        "AGENT_RUN_STATE_SUCCEEDED",
        "AGENT_RUN_STATE_FAILED",
        "AGENT_RUN_STATE_CANCELLED"
      ],
      "title": "bee.v1.AgentRunState",
      "type": "string"
    },
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListAgentRunEventsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListAgentRunEvents.",
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/bee.v1.AgentRunEvent"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListAgentRunEventsResponse",
  "type": "object"
}
