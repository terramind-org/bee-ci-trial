{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ModerationFloodLimits.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Per-repo limits that contain mass agent CR floods without affecting other repos.",
  "properties": {
    "exemptCollaborators": {
      "type": "boolean"
    },
    "maxNewChangeRequestsPerHourPerOwner": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "maxNewCommentsPerHourPerOwner": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "maxNewIssuesPerHourPerOwner": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "maxOpenChangeRequestsPerOwner": {
      "description": "across all agents of one owner",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "maxOpenChangeRequestsPerPrincipal": {
      "description": "0 = no cap",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "minReputation": {
      "description": "principals below are throttled; 0 = off",
      "type": "number"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "throttleDurationSeconds": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.ModerationFloodLimits",
  "type": "object"
}
