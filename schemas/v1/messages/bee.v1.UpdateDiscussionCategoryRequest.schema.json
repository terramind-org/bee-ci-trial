{
  "$defs": {
    "bee.v1.DiscussionCategoryFormat": {
      "description": "The kind of conversation a category hosts.",
      "enum": [
        "DISCUSSION_CATEGORY_FORMAT_UNSPECIFIED",
        "DISCUSSION_CATEGORY_FORMAT_OPEN_ENDED",
        "DISCUSSION_CATEGORY_FORMAT_QUESTION_ANSWER",
        "DISCUSSION_CATEGORY_FORMAT_ANNOUNCEMENT",
        "DISCUSSION_CATEGORY_FORMAT_POLL"
      ],
      "title": "bee.v1.DiscussionCategoryFormat",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateDiscussionCategoryRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateDiscussionCategory.",
  "properties": {
    "categoryId": {
      "description": "id or slug",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "expectedVersion": {
      "description": "0 = any; otherwise VERSION_MISMATCH when stale",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "format": {
      "$ref": "#/$defs/bee.v1.DiscussionCategoryFormat",
      "description": "UNSPECIFIED = unchanged"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "position": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "section": {
      "type": "string"
    }
  },
  "title": "bee.v1.UpdateDiscussionCategoryRequest",
  "type": "object"
}
