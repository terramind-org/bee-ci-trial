{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.PlaceholderPrincipal": {
      "description": "A principal created by an import for an author who has not claimed it yet.",
      "properties": {
        "contributions": {
          "description": "changesets, comments and reviews attributed to it",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "sourceId": {
          "type": "string"
        },
        "sourceLogin": {
          "description": "e.g. the GitHub login",
          "type": "string"
        }
      },
      "title": "bee.v1.PlaceholderPrincipal",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListPlaceholderPrincipalsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "placeholders": {
      "items": {
        "$ref": "#/$defs/bee.v1.PlaceholderPrincipal"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListPlaceholderPrincipalsResponse",
  "type": "object"
}
