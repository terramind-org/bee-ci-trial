{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WorkflowArtifact": {
      "description": "A file or archive a job uploaded.",
      "properties": {
        "archive": {
          "description": "true = zip archive; false = a single unzipped file",
          "type": "boolean"
        },
        "contentType": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "digest": {
          "description": "\"sha256:<hex>\"",
          "type": "string"
        },
        "expired": {
          "type": "boolean"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "finalized": {
          "type": "boolean"
        },
        "headChangeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "headRef": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "retentionDays": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowArtifact",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWorkflowArtifactsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListWorkflowArtifacts.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkflowArtifact"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListWorkflowArtifactsResponse",
  "type": "object"
}
