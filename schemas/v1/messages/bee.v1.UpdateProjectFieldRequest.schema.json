{
  "$defs": {
    "bee.v1.ProjectFieldOption": {
      "description": "One choice of a single-select field.",
      "properties": {
        "color": {
          "description": "e.g. \"GREEN\", \"RED\", or six hex digits",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "description": "server-assigned; send empty to create",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "title": "bee.v1.ProjectFieldOption",
      "type": "object"
    },
    "bee.v1.ProjectIteration": {
      "description": "One iteration (sprint) of an iteration field.",
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "durationDays": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fieldId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "isBreak": {
          "description": "a gap between iterations",
          "type": "boolean"
        },
        "startOn": {
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.ProjectIteration",
      "type": "object"
    },
    "bee.v1.ProjectIterationConfig": {
      "description": "Configuration of an iteration field.",
      "properties": {
        "completedIterations": {
          "items": {
            "$ref": "#/$defs/bee.v1.ProjectIteration"
          },
          "type": "array"
        },
        "durationDays": {
          "description": "default length of new iterations",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "iterations": {
          "description": "active and upcoming",
          "items": {
            "$ref": "#/$defs/bee.v1.ProjectIteration"
          },
          "type": "array"
        },
        "startOn": {
          "description": "first iteration's start",
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.ProjectIterationConfig",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateProjectFieldRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateProjectField.",
  "properties": {
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "fieldId": {
      "type": "string"
    },
    "iterationConfig": {
      "$ref": "#/$defs/bee.v1.ProjectIterationConfig",
      "description": "unset = unchanged"
    },
    "name": {
      "type": "string"
    },
    "options": {
      "description": "replaces the option list when `set_options`",
      "items": {
        "$ref": "#/$defs/bee.v1.ProjectFieldOption"
      },
      "type": "array"
    },
    "projectId": {
      "type": "string"
    },
    "setOptions": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.UpdateProjectFieldRequest",
  "type": "object"
}
