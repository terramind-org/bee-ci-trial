{
  "$defs": {
    "bee.v1.NotificationEmailRoute": {
      "description": "Where an org's email notifications go.",
      "properties": {
        "email": {
          "description": "must be one of the caller's verified emails",
          "type": "string"
        },
        "org": {
          "type": "string"
        }
      },
      "title": "bee.v1.NotificationEmailRoute",
      "type": "object"
    },
    "bee.v1.NotificationReason": {
      "description": "Why a notification was delivered.",
      "enum": [
        "NOTIFICATION_REASON_UNSPECIFIED",
        "NOTIFICATION_REASON_REVIEW_REQUESTED",
        "NOTIFICATION_REASON_MENTION",
        "NOTIFICATION_REASON_TEAM_MENTION",
        "NOTIFICATION_REASON_ASSIGN",
        "NOTIFICATION_REASON_AUTHOR",
        "NOTIFICATION_REASON_COMMENT",
        "NOTIFICATION_REASON_STATE_CHANGE",
        "NOTIFICATION_REASON_CI_ACTIVITY",
        "NOTIFICATION_REASON_SECURITY_ALERT",
        "NOTIFICATION_REASON_SUBSCRIBED",
        "NOTIFICATION_REASON_MANUAL",
        "NOTIFICATION_REASON_AGENT_RUN"
      ],
      "title": "bee.v1.NotificationReason",
      "type": "string"
    },
    "bee.v1.NotificationReasonDelivery": {
      "description": "Delivery channels for one reason.",
      "properties": {
        "email": {
          "type": "boolean"
        },
        "mobile": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/bee.v1.NotificationReason"
        },
        "web": {
          "type": "boolean"
        }
      },
      "title": "bee.v1.NotificationReasonDelivery",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.NotificationSettings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The caller's notification delivery settings.",
  "properties": {
    "autoWatchRepos": {
      "description": "watch repos the caller gains push access to",
      "type": "boolean"
    },
    "autoWatchTeamRepos": {
      "type": "boolean"
    },
    "defaultEmail": {
      "type": "string"
    },
    "deliveries": {
      "items": {
        "$ref": "#/$defs/bee.v1.NotificationReasonDelivery"
      },
      "type": "array"
    },
    "emailCiFailuresOnly": {
      "type": "boolean"
    },
    "emailRoutes": {
      "items": {
        "$ref": "#/$defs/bee.v1.NotificationEmailRoute"
      },
      "type": "array"
    },
    "includeOwnActivity": {
      "description": "notify about the caller's own actions",
      "type": "boolean"
    },
    "replyByEmail": {
      "description": "accept replies to notification emails",
      "type": "boolean"
    }
  },
  "title": "bee.v1.NotificationSettings",
  "type": "object"
}
