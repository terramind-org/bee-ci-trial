{
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.Org.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "avatarUrl": {
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "deletedAt": {
      "description": "set while soft-deleted",
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "display": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "enterpriseId": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "verifiedDomains": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "version": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "website": {
      "type": "string"
    }
  },
  "title": "bee.v1.Org",
  "type": "object"
}
