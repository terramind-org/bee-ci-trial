{
  "$defs": {
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.LocalCheck": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "title": "bee.v1.LocalCheck",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Provenance": {
      "description": "Provenance claims recorded in Meta (SPEC §10.4).",
      "properties": {
        "checksRun": {
          "items": {
            "$ref": "#/$defs/bee.v1.LocalCheck"
          },
          "type": "array"
        },
        "cost": {
          "$ref": "#/$defs/bee.v1.Cost"
        },
        "model": {
          "type": "string"
        },
        "principalChain": {
          "description": "filled by the server",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "promptDigest": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "title": "bee.v1.Provenance",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.PackageVersionProvenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "How a package version was built and who signed it.",
  "properties": {
    "attestationIds": {
      "description": "see WorkflowService.ListAttestations",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "issuer": {
      "description": "OIDC issuer of the signing identity",
      "type": "string"
    },
    "jobId": {
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/bee.v1.Provenance",
      "description": "agent provenance of the source changeset"
    },
    "signerIdentity": {
      "description": "certificate SAN of the signing workflow",
      "type": "string"
    },
    "sourceChangeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "sourceRef": {
      "type": "string"
    },
    "sourceRepo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "verified": {
      "description": "signatures and digests checked by the server",
      "type": "boolean"
    },
    "versionId": {
      "type": "string"
    },
    "workflowPath": {
      "type": "string"
    },
    "workflowRunId": {
      "type": "string"
    }
  },
  "title": "bee.v1.PackageVersionProvenance",
  "type": "object"
}
