      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.Role": {
      "enum": [
        "ROLE_UNSPECIFIED",
        "ROLE_OWNER",
        "ROLE_ADMIN",
        "ROLE_MEMBER",
        "ROLE_BILLING_MANAGER",
        "ROLE_SECURITY_MANAGER",
        "ROLE_MODERATOR",
        "ROLE_APP_MANAGER"
      ],
      "title": "bee.v1.Role",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.Member.schema.json",
