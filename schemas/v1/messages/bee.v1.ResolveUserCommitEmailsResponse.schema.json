{
  "$defs": {
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.UserCommitEmailMapping": {
      "description": "An email and the principal it maps to for commit attribution.",
      "properties": {
        "email": {
          "type": "string"
        },
        "placeholder": {
          "description": "mapped to an imported placeholder identity",
          "type": "boolean"
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "unset when unknown or unverified"
        }
      },
      "title": "bee.v1.UserCommitEmailMapping",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ResolveUserCommitEmailsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ResolveUserCommitEmails.",
  "properties": {
    "mappings": {
      "description": "same order as the request",
      "items": {
        "$ref": "#/$defs/bee.v1.UserCommitEmailMapping"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ResolveUserCommitEmailsResponse",
  "type": "object"
}
