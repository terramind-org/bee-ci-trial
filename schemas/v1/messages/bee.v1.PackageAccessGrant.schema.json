{
  "$defs": {
    "bee.v1.PackageGranteeKind": {
      "description": "What an access grant names.",
      "enum": [
        "PACKAGE_GRANTEE_KIND_UNSPECIFIED",
        "PACKAGE_GRANTEE_KIND_REPO",
        "PACKAGE_GRANTEE_KIND_TEAM",
        "PACKAGE_GRANTEE_KIND_PRINCIPAL"
      ],
      "title": "bee.v1.PackageGranteeKind",
      "type": "string"
    },
    "bee.v1.PackageRole": {
      "description": "Role granted on a package.",
      "enum": [
        "PACKAGE_ROLE_UNSPECIFIED",
        "PACKAGE_ROLE_READ",
        "PACKAGE_ROLE_WRITE",
        "PACKAGE_ROLE_ADMIN"
      ],
      "title": "bee.v1.PackageRole",
      "type": "string"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.PackageAccessGrant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One explicit grant of a role on a package.",
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/bee.v1.PackageGranteeKind"
    },
    "principal": {
      "$ref": "#/$defs/bee.v1.Principal",
      "description": "kind PRINCIPAL"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "kind REPO"
    },
    "role": {
      "$ref": "#/$defs/bee.v1.PackageRole"
    },
    "teamId": {
      "description": "kind TEAM",
      "type": "string"
    }
  },
  "title": "bee.v1.PackageAccessGrant",
  "type": "object"
}
