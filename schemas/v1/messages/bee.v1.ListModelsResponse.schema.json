{
  "$defs": {
    "bee.v1.ModelInfo": {
      "description": "A catalog model.",
      "properties": {
        "byokOnly": {
          "description": "usable only with an org provider key",
          "type": "boolean"
        },
        "capabilities": {
          "description": "\"chat\", \"tools\", \"vision\", \"embeddings\", \"reasoning\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "contextWindowTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "deprecatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "enabledForOrg": {
          "description": "org policy allows it",
          "type": "boolean"
        },
        "id": {
          "description": "e.g. \"anthropic/claude-sonnet\"",
          "type": "string"
        },
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "pricing": {
          "$ref": "#/$defs/bee.v1.ModelPricing"
        },
        "provider": {
          "type": "string"
        }
      },
      "title": "bee.v1.ModelInfo",
      "type": "object"
    },
    "bee.v1.ModelPricing": {
      "description": "Price per million tokens.",
      "properties": {
        "cachedInputUsdMicrosPerMtok": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "inputUsdMicrosPerMtok": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputUsdMicrosPerMtok": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.ModelPricing",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListModelsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListModels.",
  "properties": {
    "models": {
      "items": {
        "$ref": "#/$defs/bee.v1.ModelInfo"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListModelsResponse",
  "type": "object"
}
