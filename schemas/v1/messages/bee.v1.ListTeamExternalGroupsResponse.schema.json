  "properties": {
    "groups": {
      "items": {
        "$ref": "#/$defs/bee.v1.TeamExternalGroup"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
