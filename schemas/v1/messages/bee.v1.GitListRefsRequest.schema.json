{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GitListRefsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GitListRefs (protocol v2 ls-refs options).",
  "properties": {
    "forPush": {
      "description": "receive-pack advertisement: refs the caller may update",
      "type": "boolean"
    },
    "includePullRefs": {
      "description": "refs/pull/<n>/head and refs/pull/<n>/merge",
      "type": "boolean"
    },
    "includeReplaceRefs": {
      "description": "refs/replace/* for redacted commits",
      "type": "boolean"
    },
    "includeVirtualRefs": {
      "description": "refs/bee/c/<change-id> for open change requests",
      "type": "boolean"
    },
    "peel": {
      "description": "include peeled targets of annotated tags",
      "type": "boolean"
    },
    "refPrefixes": {
      "description": "`ref-prefix`; empty = all",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "symrefs": {
      "description": "include symref targets (HEAD)",
      "type": "boolean"
    },
    "unborn": {
      "description": "report HEAD even when it points to an unborn branch",
      "type": "boolean"
    }
  },
  "title": "bee.v1.GitListRefsRequest",
  "type": "object"
}
