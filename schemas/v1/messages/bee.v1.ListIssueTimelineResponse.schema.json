{
  "$defs": {
    "bee.v1.Comment": {
      "description": "A conversation comment on any subject.",
      "properties": {
        "anchor": {
          "$ref": "#/$defs/bee.v1.CommentAnchor",
          "description": "set for line and file comments"
        },
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "authorAssociation": {
          "description": "\"OWNER\", \"MEMBER\", \"CONTRIBUTOR\", \"FIRST_TIME_CONTRIBUTOR\", \"NONE\"",
          "type": "string"
        },
        "body": {
          "description": "Markdown",
          "type": "string"
        },
        "bodyHtml": {
          "description": "sanitized rendering, when requested",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "deleted": {
          "type": "boolean"
        },
        "edited": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "inReplyTo": {
          "description": "parent comment id for threaded replies",
          "type": "string"
        },
        "minimizedReason": {
          "$ref": "#/$defs/bee.v1.MinimizedReason",
          "description": "UNSPECIFIED = shown"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReactionGroup"
          },
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "what the comment is on"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "url": {
          "description": "permalink in the web app",
          "type": "string"
        }
      },
      "title": "bee.v1.Comment",
      "type": "object"
    },
    "bee.v1.CommentAnchor": {
      "description": "Where a line or file comment is anchored: change request review comments and changeset\n(commit) comments.",
      "properties": {
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fileLevel": {
          "description": "anchored to the file, not to lines",
          "type": "boolean"
        },
        "outdated": {
          "description": "the anchored lines changed in a later revision",
          "type": "boolean"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "revision": {
          "description": "CR revision the anchor was last valid on; 0 off a CR",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "side": {
          "description": "\"old\" | \"new\"",
          "type": "string"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "threadId": {
          "description": "the CR review thread",
          "type": "string"
        }
      },
      "title": "bee.v1.CommentAnchor",
      "type": "object"
    },
    "bee.v1.IssueLockReason": {
      "description": "Why a conversation was locked.",
      "enum": [
        "ISSUE_LOCK_REASON_UNSPECIFIED",
        "ISSUE_LOCK_REASON_OFF_TOPIC",
        "ISSUE_LOCK_REASON_TOO_HEATED",
        "ISSUE_LOCK_REASON_RESOLVED",
        "ISSUE_LOCK_REASON_SPAM"
      ],
      "title": "bee.v1.IssueLockReason",
      "type": "string"
    },
    "bee.v1.IssueState": {
      "description": "Open or closed.",
      "enum": [
        "ISSUE_STATE_UNSPECIFIED",
        "ISSUE_STATE_OPEN",
        "ISSUE_STATE_CLOSED"
      ],
      "title": "bee.v1.IssueState",
      "type": "string"
    },
    "bee.v1.IssueStateReason": {
      "description": "Why an issue is in its current state.",
      "enum": [
        "ISSUE_STATE_REASON_UNSPECIFIED",
        "ISSUE_STATE_REASON_COMPLETED",
        "ISSUE_STATE_REASON_NOT_PLANNED",
        "ISSUE_STATE_REASON_DUPLICATE",
        "ISSUE_STATE_REASON_REOPENED"
      ],
      "title": "bee.v1.IssueStateReason",
      "type": "string"
    },
    "bee.v1.IssueSummary": {
      "description": "Short identity of a related issue, returned inside other resources.",
      "properties": {
        "assignees": {
          "items": {
            "$ref": "#/$defs/bee.v1.Principal"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "issueTypeName": {
          "type": "string"
        },
        "number": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "repoFullName": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.IssueState"
        },
        "stateReason": {
          "$ref": "#/$defs/bee.v1.IssueStateReason"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "title": "bee.v1.IssueSummary",
      "type": "object"
    },
    "bee.v1.IssueTimelineEvent": {
      "description": "One entry in an issue's timeline. Which detail fields are set depends on `kind`.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "agentRunId": {
          "description": "AGENT_RUN_*",
          "type": "string"
        },
        "assignee": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "ASSIGNED, UNASSIGNED"
        },
        "changeRequestId": {
          "description": "CHANGE_LINKED, CHANGE_UNLINKED, CLOSED by a CR",
          "type": "string"
        },
        "changesetId": {
          "description": "REFERENCED",
          "type": "string"
        },
        "comment": {
          "$ref": "#/$defs/bee.v1.Comment",
          "description": "COMMENTED"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "currentTitle": {
          "description": "RENAMED",
          "type": "string"
        },
        "currentValue": {
          "type": "string"
        },
        "fieldName": {
          "description": "FIELD_CHANGED",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.IssueTimelineEventKind"
        },
        "label": {
          "$ref": "#/$defs/bee.v1.Label",
          "description": "LABELED, UNLABELED"
        },
        "lockReason": {
          "$ref": "#/$defs/bee.v1.IssueLockReason",
          "description": "LOCKED"
        },
        "mentionedUser": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "MENTIONED: who was mentioned (`assignee` and `current_value` keep carrying it for older\nclients)."
        },
        "milestoneTitle": {
          "description": "MILESTONED, DEMILESTONED",
          "type": "string"
        },
        "previousRepoFullName": {
          "description": "TRANSFERRED",
          "type": "string"
        },
        "previousTitle": {
          "description": "RENAMED",
          "type": "string"
        },
        "previousValue": {
          "description": "TYPE_CHANGED, FIELD_CHANGED, PROJECT_STATUS_CHANGED",
          "type": "string"
        },
        "projectId": {
          "description": "project events",
          "type": "string"
        },
        "refName": {
          "description": "BRANCH_CREATED",
          "type": "string"
        },
        "relatedIssue": {
          "$ref": "#/$defs/bee.v1.IssueSummary",
          "description": "duplicate, sub-issue, parent and dependency events"
        },
        "source": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "CROSS_REFERENCED, MENTIONED, CONVERTED_TO_DISCUSSION"
        },
        "stateReason": {
          "$ref": "#/$defs/bee.v1.IssueStateReason",
          "description": "CLOSED, REOPENED"
        }
      },
      "title": "bee.v1.IssueTimelineEvent",
      "type": "object"
    },
    "bee.v1.IssueTimelineEventKind": {
      "description": "Kind of an issue timeline event.",
      "enum": [
        "ISSUE_TIMELINE_EVENT_KIND_UNSPECIFIED",
        "ISSUE_TIMELINE_EVENT_KIND_COMMENTED",
        "ISSUE_TIMELINE_EVENT_KIND_LABELED",
        "ISSUE_TIMELINE_EVENT_KIND_UNLABELED",
        "ISSUE_TIMELINE_EVENT_KIND_ASSIGNED",
        "ISSUE_TIMELINE_EVENT_KIND_UNASSIGNED",
        "ISSUE_TIMELINE_EVENT_KIND_MILESTONED",
        "ISSUE_TIMELINE_EVENT_KIND_DEMILESTONED",
        "ISSUE_TIMELINE_EVENT_KIND_RENAMED",
        "ISSUE_TIMELINE_EVENT_KIND_CLOSED",
        "ISSUE_TIMELINE_EVENT_KIND_REOPENED",
        "ISSUE_TIMELINE_EVENT_KIND_LOCKED",
        "ISSUE_TIMELINE_EVENT_KIND_UNLOCKED",
        "ISSUE_TIMELINE_EVENT_KIND_PINNED",
        "ISSUE_TIMELINE_EVENT_KIND_UNPINNED",
        "ISSUE_TIMELINE_EVENT_KIND_TRANSFERRED",
        "ISSUE_TIMELINE_EVENT_KIND_CROSS_REFERENCED",
        "ISSUE_TIMELINE_EVENT_KIND_REFERENCED",
        "ISSUE_TIMELINE_EVENT_KIND_MENTIONED",
        "ISSUE_TIMELINE_EVENT_KIND_CHANGE_LINKED",
        "ISSUE_TIMELINE_EVENT_KIND_CHANGE_UNLINKED",
        "ISSUE_TIMELINE_EVENT_KIND_MARKED_DUPLICATE",
        "ISSUE_TIMELINE_EVENT_KIND_UNMARKED_DUPLICATE",
        "ISSUE_TIMELINE_EVENT_KIND_TYPE_CHANGED",
        "ISSUE_TIMELINE_EVENT_KIND_SUB_ISSUE_ADDED",
        "ISSUE_TIMELINE_EVENT_KIND_SUB_ISSUE_REMOVED",
        "ISSUE_TIMELINE_EVENT_KIND_PARENT_ADDED",
        "ISSUE_TIMELINE_EVENT_KIND_PARENT_REMOVED",
        "ISSUE_TIMELINE_EVENT_KIND_BLOCKED_BY_ADDED",
        "ISSUE_TIMELINE_EVENT_KIND_BLOCKED_BY_REMOVED",
        "ISSUE_TIMELINE_EVENT_KIND_BLOCKING_ADDED",
        "ISSUE_TIMELINE_EVENT_KIND_BLOCKING_REMOVED",
        "ISSUE_TIMELINE_EVENT_KIND_FIELD_CHANGED",
        "ISSUE_TIMELINE_EVENT_KIND_ADDED_TO_PROJECT",
        "ISSUE_TIMELINE_EVENT_KIND_REMOVED_FROM_PROJECT",
        "ISSUE_TIMELINE_EVENT_KIND_PROJECT_STATUS_CHANGED",
        "ISSUE_TIMELINE_EVENT_KIND_BRANCH_CREATED",
        "ISSUE_TIMELINE_EVENT_KIND_AGENT_RUN_STARTED",
        "ISSUE_TIMELINE_EVENT_KIND_AGENT_RUN_FINISHED",
        "ISSUE_TIMELINE_EVENT_KIND_CONVERTED_TO_DISCUSSION",
        "ISSUE_TIMELINE_EVENT_KIND_COMMENT_DELETED"
      ],
      "title": "bee.v1.IssueTimelineEventKind",
      "type": "string"
    },
    "bee.v1.Label": {
      "description": "A repo label shared by issues, change requests and discussions.",
      "properties": {
        "color": {
          "description": "six hex digits, no '#'",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "isDefault": {
          "description": "part of the repo's default label set",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "title": "bee.v1.Label",
      "type": "object"
    },
    "bee.v1.MinimizedReason": {
      "description": "Why a comment is minimized (PRODUCT §4.21).",
      "enum": [
        "MINIMIZED_REASON_UNSPECIFIED",
        "MINIMIZED_REASON_SPAM",
        "MINIMIZED_REASON_ABUSE",
        "MINIMIZED_REASON_OFF_TOPIC",
        "MINIMIZED_REASON_OUTDATED",
        "MINIMIZED_REASON_DUPLICATE",
        "MINIMIZED_REASON_RESOLVED"
      ],
      "title": "bee.v1.MinimizedReason",
      "type": "string"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.ReactionContent": {
      "description": "Reaction emoji, matching GitHub's fixed set.",
      "enum": [
        "REACTION_CONTENT_UNSPECIFIED",
        "REACTION_CONTENT_THUMBS_UP",
        "REACTION_CONTENT_THUMBS_DOWN",
        "REACTION_CONTENT_LAUGH",
        "REACTION_CONTENT_HOORAY",
        "REACTION_CONTENT_CONFUSED",
        "REACTION_CONTENT_HEART",
        "REACTION_CONTENT_ROCKET",
        "REACTION_CONTENT_EYES"
      ],
      "title": "bee.v1.ReactionContent",
      "type": "string"
    },
    "bee.v1.ReactionGroup": {
      "description": "Count of one reaction on a subject, and whether the caller is among them.",
      "properties": {
        "content": {
          "$ref": "#/$defs/bee.v1.ReactionContent"
        },
        "count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "viewerReacted": {
          "type": "boolean"
        }
      },
      "title": "bee.v1.ReactionGroup",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListIssueTimelineResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListIssueTimeline.",
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/bee.v1.IssueTimelineEvent"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListIssueTimelineResponse",
  "type": "object"
}
