{
  "$defs": {
    "bee.v1.DiscussionPollOption": {
      "description": "One option of a poll with its tally.",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "viewerVoted": {
          "type": "boolean"
        },
        "voteCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.DiscussionPollOption",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.DiscussionPoll.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A poll attached to a discussion in a poll category.",
  "properties": {
    "closed": {
      "description": "closed or locked discussions accept no votes",
      "type": "boolean"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/bee.v1.DiscussionPollOption"
      },
      "type": "array"
    },
    "question": {
      "type": "string"
    },
    "totalVotes": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "viewerHasVoted": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.DiscussionPoll",
  "type": "object"
}
