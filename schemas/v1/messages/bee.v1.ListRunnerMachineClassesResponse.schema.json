{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.RunnerArch": {
      "description": "CPU architecture of a runner or machine class.",
      "enum": [
        "RUNNER_ARCH_UNSPECIFIED",
        "RUNNER_ARCH_X64",
        "RUNNER_ARCH_ARM64"
      ],
      "title": "bee.v1.RunnerArch",
      "type": "string"
    },
    "bee.v1.RunnerMachineClass": {
      "description": "A hosted runner size a job can request through `runs-on`.",
      "properties": {
        "arch": {
          "$ref": "#/$defs/bee.v1.RunnerArch"
        },
        "cpuCores": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "gpu": {
          "description": "e.g. \"nvidia-t4\"; empty = none",
          "type": "string"
        },
        "gpuCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "label to use in `runs-on`, e.g. \"linux-arm64-8\"",
          "type": "string"
        },
        "memoryBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "os": {
          "$ref": "#/$defs/bee.v1.RunnerOs"
        },
        "perMinuteUsdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "staticIpAvailable": {
          "type": "boolean"
        },
        "storageBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.RunnerMachineClass",
      "type": "object"
    },
    "bee.v1.RunnerOs": {
      "description": "Operating system of a runner or machine class.",
      "enum": [
        "RUNNER_OS_UNSPECIFIED",
        "RUNNER_OS_LINUX",
        "RUNNER_OS_MACOS",
        "RUNNER_OS_WINDOWS"
      ],
      "title": "bee.v1.RunnerOs",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListRunnerMachineClassesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListRunnerMachineClasses.",
  "properties": {
    "classes": {
      "items": {
        "$ref": "#/$defs/bee.v1.RunnerMachineClass"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListRunnerMachineClassesResponse",
  "type": "object"
}
