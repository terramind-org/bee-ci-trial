{
  "$defs": {
    "bee.v1.BisectOutcome": {
      "description": "A manual mark or a probe's result.",
      "enum": [
        "BISECT_OUTCOME_UNSPECIFIED",
        "BISECT_OUTCOME_GOOD",
        "BISECT_OUTCOME_BAD",
        "BISECT_OUTCOME_SKIP"
      ],
      "title": "bee.v1.BisectOutcome",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.MarkBisectRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for MarkBisect.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "id": {
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/bee.v1.BisectOutcome"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.MarkBisectRequest",
  "type": "object"
}
