{
  "$defs": {
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateBillingBudgetRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateBillingBudget. Unset fields are unchanged.",
  "properties": {
    "alertRecipientIds": {
      "description": "replaces when replace_alerts is set",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "alertThresholdPercents": {
      "description": "replaces when replace_alerts is set",
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "budgetId": {
      "type": "string"
    },
    "hardStop": {
      "type": "boolean"
    },
    "monthlyAmountMicroUsd": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "name": {
      "type": "string"
    },
    "replaceAlerts": {
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    }
  },
  "title": "bee.v1.UpdateBillingBudgetRequest",
  "type": "object"
}
