{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SafetyPeriod": {
      "properties": {
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.SafetyPeriod",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SpotCheckRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "limit": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "period": {
      "$ref": "#/$defs/bee.v1.SafetyPeriod"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "seed": {
      "type": "string"
    }
  },
  "title": "bee.v1.SpotCheckRequest",
  "type": "object"
}
