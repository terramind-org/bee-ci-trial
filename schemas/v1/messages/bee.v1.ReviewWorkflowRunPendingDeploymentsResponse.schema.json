{
  "$defs": {
    "bee.v1.Deployment": {
      "description": "A request to ship a changeset to an environment.",
      "properties": {
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId",
          "description": "resolved changeset that is deployed"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "creator": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "description": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "originalEnvironment": {
          "type": "string"
        },
        "payloadJson": {
          "description": "free-form JSON chosen by the creator",
          "type": "string"
        },
        "productionEnvironment": {
          "type": "boolean"
        },
        "ref": {
          "description": "ref name as requested",
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.DeploymentState",
          "description": "state of the latest status"
        },
        "task": {
          "description": "e.g. \"deploy\", \"deploy:migrations\"",
          "type": "string"
        },
        "transientEnvironment": {
          "description": "environment goes away when no longer needed",
          "type": "boolean"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "workflowRunId": {
          "description": "set when created by a workflow job",
          "type": "string"
        }
      },
      "title": "bee.v1.Deployment",
      "type": "object"
    },
    "bee.v1.DeploymentState": {
      "description": "The state carried by a deployment status (GitHub-compatible set).",
      "enum": [
        "DEPLOYMENT_STATE_UNSPECIFIED",
        "DEPLOYMENT_STATE_PENDING",
        "DEPLOYMENT_STATE_QUEUED",
        "DEPLOYMENT_STATE_IN_PROGRESS",
        "DEPLOYMENT_STATE_SUCCESS",
        "DEPLOYMENT_STATE_FAILURE",
        "DEPLOYMENT_STATE_ERROR",
        "DEPLOYMENT_STATE_INACTIVE"
      ],
      "title": "bee.v1.DeploymentState",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ReviewWorkflowRunPendingDeploymentsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ReviewWorkflowRunPendingDeployments.",
  "properties": {
    "deployments": {
      "items": {
        "$ref": "#/$defs/bee.v1.Deployment"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ReviewWorkflowRunPendingDeploymentsResponse",
  "type": "object"
}
