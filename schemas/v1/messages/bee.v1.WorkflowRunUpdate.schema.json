{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WorkflowConclusion": {
      "description": "Outcome of a completed run, job or step.",
      "enum": [
        "WORKFLOW_CONCLUSION_UNSPECIFIED",
        "WORKFLOW_CONCLUSION_SUCCESS",
        "WORKFLOW_CONCLUSION_FAILURE",
        "WORKFLOW_CONCLUSION_NEUTRAL",
        "WORKFLOW_CONCLUSION_CANCELLED",
        "WORKFLOW_CONCLUSION_SKIPPED",
        "WORKFLOW_CONCLUSION_TIMED_OUT",
        "WORKFLOW_CONCLUSION_ACTION_REQUIRED",
        "WORKFLOW_CONCLUSION_STALE",
        "WORKFLOW_CONCLUSION_STARTUP_FAILURE"
      ],
      "title": "bee.v1.WorkflowConclusion",
      "type": "string"
    },
    "bee.v1.WorkflowJob": {
      "description": "One job of a run attempt.",
      "properties": {
        "checkRunId": {
          "description": "CheckService run carrying annotations and output",
          "type": "string"
        },
        "completedAt": {
          "format": "date-time",
          "type": "string"
        },
        "conclusion": {
          "$ref": "#/$defs/bee.v1.WorkflowConclusion"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "headChangeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "headRef": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "labels": {
          "description": "`runs-on` labels",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "logSizeBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "machineClass": {
          "description": "hosted class, empty for self-hosted",
          "type": "string"
        },
        "matrixJson": {
          "description": "JSON object of this job's matrix values",
          "type": "string"
        },
        "name": {
          "description": "includes matrix values, e.g. \"test (ubuntu, 22)\"",
          "type": "string"
        },
        "needs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runAttempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runId": {
          "type": "string"
        },
        "runnerGroupId": {
          "type": "string"
        },
        "runnerId": {
          "type": "string"
        },
        "runnerName": {
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/bee.v1.WorkflowStatus"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/bee.v1.WorkflowStep"
          },
          "type": "array"
        },
        "workflowName": {
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowJob",
      "type": "object"
    },
    "bee.v1.WorkflowReference": {
      "description": "A reusable workflow a run called.",
      "properties": {
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "path": {
          "description": "\"org/repo/.github/workflows/x.yml\"",
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowReference",
      "type": "object"
    },
    "bee.v1.WorkflowRun": {
      "description": "One attempt of a workflow run.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "who caused the first attempt"
        },
        "approvalRequired": {
          "description": "held for first-time contributor, fork or agent approval",
          "type": "boolean"
        },
        "changeRequestIds": {
          "description": "Change requests whose revisions this run checked (gap G8).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "changeRequestNumbers": {
          "items": {
            "format": "uint64",
            "pattern": "^[0-9]+$",
            "type": [
              "string",
              "integer"
            ]
          },
          "type": "array"
        },
        "checkSuiteId": {
          "type": "string"
        },
        "completedAt": {
          "format": "date-time",
          "type": "string"
        },
        "conclusion": {
          "$ref": "#/$defs/bee.v1.WorkflowConclusion"
        },
        "concurrency": {
          "$ref": "#/$defs/bee.v1.WorkflowRunConcurrency"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "debugLogging": {
          "type": "boolean"
        },
        "displayTitle": {
          "type": "string"
        },
        "event": {
          "description": "triggering event, e.g. \"push\", \"pull_request\", \"workflow_dispatch\"",
          "type": "string"
        },
        "headChangeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "headRef": {
          "type": "string"
        },
        "headRepo": {
          "$ref": "#/$defs/bee.v1.RepoRef",
          "description": "differs from repo for fork change requests"
        },
        "htmlUrl": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "jobs": {
          "description": "Jobs of the run, set when include_jobs was requested (gap G7).",
          "items": {
            "$ref": "#/$defs/bee.v1.WorkflowJob"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "numericId": {
          "description": "The numeric run id (`github.run_id`, the REST compatibility id), unique per server.",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "previousAttemptId": {
          "type": "string"
        },
        "referencedWorkflows": {
          "items": {
            "$ref": "#/$defs/bee.v1.WorkflowReference"
          },
          "type": "array"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "runAttempt": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "runNumber": {
          "description": "per workflow, GitHub-compatible",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "runStartedAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/bee.v1.WorkflowStatus"
        },
        "triggeringActor": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "who caused this attempt"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "workflowId": {
          "type": "string"
        },
        "workflowPath": {
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowRun",
      "type": "object"
    },
    "bee.v1.WorkflowRunConcurrency": {
      "description": "Concurrency group state of a run (`concurrency:` key).",
      "properties": {
        "blockingRunIds": {
          "description": "runs holding the group",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cancelInProgress": {
          "type": "boolean"
        },
        "group": {
          "description": "evaluated group name",
          "type": "string"
        },
        "queuePosition": {
          "description": "0 = running or not queued",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.WorkflowRunConcurrency",
      "type": "object"
    },
    "bee.v1.WorkflowStatus": {
      "description": "Lifecycle status of a run, job or step.",
      "enum": [
        "WORKFLOW_STATUS_UNSPECIFIED",
        "WORKFLOW_STATUS_REQUESTED",
        "WORKFLOW_STATUS_PENDING",
        "WORKFLOW_STATUS_WAITING",
        "WORKFLOW_STATUS_ACTION_REQUIRED",
        "WORKFLOW_STATUS_QUEUED",
        "WORKFLOW_STATUS_IN_PROGRESS",
        "WORKFLOW_STATUS_COMPLETED"
      ],
      "title": "bee.v1.WorkflowStatus",
      "type": "string"
    },
    "bee.v1.WorkflowStep": {
      "description": "One step of a job.",
      "properties": {
        "completedAt": {
          "format": "date-time",
          "type": "string"
        },
        "conclusion": {
          "$ref": "#/$defs/bee.v1.WorkflowConclusion"
        },
        "logOffset": {
          "description": "byte offset in the job log where this step starts",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "type": "string"
        },
        "number": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/bee.v1.WorkflowStatus"
        }
      },
      "title": "bee.v1.WorkflowStep",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.WorkflowRunUpdate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A change to a watched run; the first message carries the current snapshot.",
  "properties": {
    "changedJobs": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkflowJob"
      },
      "type": "array"
    },
    "final": {
      "description": "the run completed; the stream ends after this message",
      "type": "boolean"
    },
    "run": {
      "$ref": "#/$defs/bee.v1.WorkflowRun"
    }
  },
  "title": "bee.v1.WorkflowRunUpdate",
  "type": "object"
}
