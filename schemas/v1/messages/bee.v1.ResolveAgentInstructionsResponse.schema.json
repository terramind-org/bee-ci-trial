{
  "$defs": {
    "bee.v1.AgentInstructionFile": {
      "description": "One instruction file.",
      "properties": {
        "appliesTo": {
          "description": "glob patterns from front matter, if any",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "content": {
          "description": "set when requested",
          "type": "string"
        },
        "includes": {
          "description": "files pulled in with \"@path\" references",
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "custom agent name from front matter, if any",
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/bee.v1.AgentInstructionSource"
        }
      },
      "title": "bee.v1.AgentInstructionFile",
      "type": "object"
    },
    "bee.v1.AgentInstructionSource": {
      "description": "Where an instruction file came from.",
      "enum": [
        "AGENT_INSTRUCTION_SOURCE_UNSPECIFIED",
        "AGENT_INSTRUCTION_SOURCE_AGENTS_MD",
        "AGENT_INSTRUCTION_SOURCE_CLAUDE_MD",
        "AGENT_INSTRUCTION_SOURCE_COPILOT_INSTRUCTIONS",
        "AGENT_INSTRUCTION_SOURCE_CUSTOM_AGENT",
        "AGENT_INSTRUCTION_SOURCE_PATH_INSTRUCTIONS",
        "AGENT_INSTRUCTION_SOURCE_ORG"
      ],
      "title": "bee.v1.AgentInstructionSource",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ResolveAgentInstructionsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ResolveAgentInstructions.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "combined": {
      "description": "concatenated Markdown with file headers",
      "type": "string"
    },
    "files": {
      "description": "in precedence order, most specific last",
      "items": {
        "$ref": "#/$defs/bee.v1.AgentInstructionFile"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ResolveAgentInstructionsResponse",
  "type": "object"
}
