{
  "$defs": {
    "bee.v1.ModelMessage": {
      "description": "One chat message.",
      "properties": {
        "content": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/bee.v1.ModelMessageRole"
        },
        "toolCallId": {
          "description": "TOOL messages",
          "type": "string"
        }
      },
      "title": "bee.v1.ModelMessage",
      "type": "object"
    },
    "bee.v1.ModelMessageRole": {
      "description": "Role of a chat message.",
      "enum": [
        "MODEL_MESSAGE_ROLE_UNSPECIFIED",
        "MODEL_MESSAGE_ROLE_SYSTEM",
        "MODEL_MESSAGE_ROLE_USER",
        "MODEL_MESSAGE_ROLE_ASSISTANT",
        "MODEL_MESSAGE_ROLE_TOOL"
      ],
      "title": "bee.v1.ModelMessageRole",
      "type": "string"
    },
    "bee.v1.ModelParams": {
      "description": "Sampling parameters.",
      "properties": {
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "responseFormat": {
          "description": "\"text\" or \"json\"",
          "type": "string"
        },
        "seed": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "stop": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "temperature": {
          "type": "number"
        },
        "topP": {
          "type": "number"
        }
      },
      "title": "bee.v1.ModelParams",
      "type": "object"
    },
    "bee.v1.ModelTool": {
      "description": "A tool the model may call.",
      "properties": {
        "description": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parametersSchema": {
          "description": "JSON Schema document",
          "type": "string"
        }
      },
      "title": "bee.v1.ModelTool",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.StreamModelInferenceRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for StreamModelInference.",
  "properties": {
    "messages": {
      "items": {
        "$ref": "#/$defs/bee.v1.ModelMessage"
      },
      "type": "array"
    },
    "model": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "params": {
      "$ref": "#/$defs/bee.v1.ModelParams"
    },
    "providerKeyId": {
      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/bee.v1.ModelTool"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.StreamModelInferenceRequest",
  "type": "object"
}
