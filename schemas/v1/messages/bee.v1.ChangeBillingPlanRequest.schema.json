{
  "$defs": {
    "bee.v1.BillingCycle": {
      "description": "Length of a billing cycle.",
      "enum": [
        "BILLING_CYCLE_UNSPECIFIED",
        "BILLING_CYCLE_MONTHLY",
        "BILLING_CYCLE_YEARLY"
      ],
      "title": "bee.v1.BillingCycle",
      "type": "string"
    },
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ChangeBillingPlanRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ChangeBillingPlan.",
  "properties": {
    "cycle": {
      "$ref": "#/$defs/bee.v1.BillingCycle",
      "description": "UNSPECIFIED = keep"
    },
    "planId": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    },
    "seats": {
      "description": "0 = keep the current count",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.ChangeBillingPlanRequest",
  "type": "object"
}
