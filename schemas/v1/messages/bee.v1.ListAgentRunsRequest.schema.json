{
  "$defs": {
    "bee.v1.AgentRunState": {
      "description": "Run lifecycle.",
      "enum": [
        "AGENT_RUN_STATE_UNSPECIFIED",
        "AGENT_RUN_STATE_QUEUED",
        "AGENT_RUN_STATE_PROVISIONING",
        "AGENT_RUN_STATE_RUNNING",
        "AGENT_RUN_STATE_WAITING_FOR_REVIEW",
        "AGENT_RUN_STATE_SUCCEEDED",
        "AGENT_RUN_STATE_FAILED",
        "AGENT_RUN_STATE_CANCELLED"
      ],
      "title": "bee.v1.AgentRunState",
      "type": "string"
    },
    "bee.v1.AgentTaskKind": {
      "description": "What a run is asked to do.",
      "enum": [
        "AGENT_TASK_KIND_UNSPECIFIED",
        "AGENT_TASK_KIND_ISSUE",
        "AGENT_TASK_KIND_REVIEW",
        "AGENT_TASK_KIND_FREEFORM",
        "AGENT_TASK_KIND_SECURITY_FIX",
        "AGENT_TASK_KIND_REVISE",
        "AGENT_TASK_KIND_ADOPT_EVALUATE"
      ],
      "title": "bee.v1.AgentTaskKind",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListAgentRunsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListAgentRuns.",
  "properties": {
    "agentPrincipalId": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "unset = all repos visible to the caller"
    },
    "startedById": {
      "type": "string"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/bee.v1.AgentRunState"
      },
      "type": "array"
    },
    "taskKind": {
      "$ref": "#/$defs/bee.v1.AgentTaskKind"
    }
  },
  "title": "bee.v1.ListAgentRunsRequest",
  "type": "object"
}
