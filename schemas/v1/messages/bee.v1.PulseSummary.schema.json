{
  "$defs": {
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.PulseAuthorCount": {
      "description": "One author's landed changeset count in a pulse window.",
      "properties": {
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "changesets": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.PulseAuthorCount",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.PulseSummary.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Activity summary over a window.",
  "properties": {
    "additions": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "agentAuthors": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "changeRequestsClosed": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "changeRequestsLanded": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "changeRequestsOpened": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "changesetsLanded": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "deletions": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "filesChanged": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "fromAt": {
      "format": "date-time",
      "type": "string"
    },
    "humanAuthors": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "issuesClosed": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "issuesOpened": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "landedChangeRequests": {
      "description": "up to a limit, newest first",
      "items": {
        "$ref": "#/$defs/bee.v1.SubjectRef"
      },
      "type": "array"
    },
    "openedIssues": {
      "items": {
        "$ref": "#/$defs/bee.v1.SubjectRef"
      },
      "type": "array"
    },
    "releasesPublished": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "toAt": {
      "format": "date-time",
      "type": "string"
    },
    "topAuthors": {
      "items": {
        "$ref": "#/$defs/bee.v1.PulseAuthorCount"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.PulseSummary",
  "type": "object"
}
