{
  "$defs": {
    "bee.v1.DeploymentReviewDecision": {
      "description": "A reviewer's or rule's decision on a gated deployment.",
      "enum": [
        "DEPLOYMENT_REVIEW_DECISION_UNSPECIFIED",
        "DEPLOYMENT_REVIEW_DECISION_APPROVED",
        "DEPLOYMENT_REVIEW_DECISION_REJECTED"
      ],
      "title": "bee.v1.DeploymentReviewDecision",
      "type": "string"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.WorkflowApprovalKind": {
      "description": "What a recorded run approval approved.",
      "enum": [
        "WORKFLOW_APPROVAL_KIND_UNSPECIFIED",
        "WORKFLOW_APPROVAL_KIND_RUN",
        "WORKFLOW_APPROVAL_KIND_ENVIRONMENT"
      ],
      "title": "bee.v1.WorkflowApprovalKind",
      "type": "string"
    },
    "bee.v1.WorkflowRunApproval": {
      "description": "One approval or environment review recorded on a run.",
      "properties": {
        "approver": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "comment": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/bee.v1.DeploymentReviewDecision",
          "description": "APPROVED for kind RUN"
        },
        "environments": {
          "description": "kind ENVIRONMENT",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.WorkflowApprovalKind"
        }
      },
      "title": "bee.v1.WorkflowRunApproval",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWorkflowRunApprovalsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListWorkflowRunApprovals.",
  "properties": {
    "approvals": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkflowRunApproval"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListWorkflowRunApprovalsResponse",
  "type": "object"
}
