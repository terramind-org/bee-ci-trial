{
  "$defs": {
    "bee.v1.OpsConfigError": {
      "description": "One config validation problem.",
      "properties": {
        "code": {
          "description": "\"unknown_key\", \"type_mismatch\", \"out_of_range\", ...",
          "type": "string"
        },
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "keyPath": {
          "description": "e.g. \"limits.max_blob_bytes\"",
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "title": "bee.v1.OpsConfigError",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ValidateOpsConfigResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ValidateOpsConfig.",
  "properties": {
    "errors": {
      "items": {
        "$ref": "#/$defs/bee.v1.OpsConfigError"
      },
      "type": "array"
    },
    "normalizedToml": {
      "description": "with documented defaults filled in",
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    },
    "warnings": {
      "description": "e.g. deprecated keys",
      "items": {
        "$ref": "#/$defs/bee.v1.OpsConfigError"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ValidateOpsConfigResponse",
  "type": "object"
}
