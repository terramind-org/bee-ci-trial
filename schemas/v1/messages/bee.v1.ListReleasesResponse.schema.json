{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.Release": {
      "description": "A release.",
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReleaseAsset"
          },
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "body": {
          "description": "Markdown",
          "type": "string"
        },
        "bodyHtml": {
          "description": "sanitized rendering, when requested",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "discussionCategoryId": {
          "type": "string"
        },
        "discussionId": {
          "description": "linked discussion, if any",
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "immutable": {
          "description": "once published, the tag and assets are frozen",
          "type": "boolean"
        },
        "latest": {
          "description": "currently the repo's latest release",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "prerelease": {
          "type": "boolean"
        },
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "tagName": {
          "type": "string"
        },
        "tarballUrl": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/bee.v1.ObjectId",
          "description": "changeset the tag points at"
        },
        "targetRef": {
          "description": "ref the tag was cut from, when created by CreateRelease",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "url": {
          "description": "web permalink",
          "type": "string"
        },
        "version": {
          "description": "for compare-and-swap updates",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "zipballUrl": {
          "description": "stable source archive URL (redirects to a signed URL)",
          "type": "string"
        }
      },
      "title": "bee.v1.Release",
      "type": "object"
    },
    "bee.v1.ReleaseAsset": {
      "description": "A file attached to a release.",
      "properties": {
        "contentType": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "downloadCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "releaseId": {
          "type": "string"
        },
        "sha256": {
          "contentEncoding": "base64",
          "description": "32-byte digest, set once uploaded",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "state": {
          "$ref": "#/$defs/bee.v1.ReleaseAssetState"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "uploader": {
          "$ref": "#/$defs/bee.v1.Principal"
        }
      },
      "title": "bee.v1.ReleaseAsset",
      "type": "object"
    },
    "bee.v1.ReleaseAssetState": {
      "description": "Upload state of a release asset.",
      "enum": [
        "RELEASE_ASSET_STATE_UNSPECIFIED",
        "RELEASE_ASSET_STATE_UPLOADING",
        "RELEASE_ASSET_STATE_UPLOADED"
      ],
      "title": "bee.v1.ReleaseAssetState",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListReleasesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListReleases.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "releases": {
      "items": {
        "$ref": "#/$defs/bee.v1.Release"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListReleasesResponse",
  "type": "object"
}
