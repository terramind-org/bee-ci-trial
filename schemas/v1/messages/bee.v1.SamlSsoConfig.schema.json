{
  "$defs": {
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SamlSsoConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "SAML single sign-on settings for an org or enterprise.",
  "properties": {
    "digestMethod": {
      "description": "e.g. \"sha256\"",
      "type": "string"
    },
    "enabled": {
      "description": "members may link and use SSO",
      "type": "boolean"
    },
    "enforced": {
      "description": "members must have a live SSO session",
      "type": "boolean"
    },
    "idpCertificateExpiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "idpCertificatePem": {
      "description": "signing certificate",
      "type": "string"
    },
    "idpEntityId": {
      "description": "issuer",
      "type": "string"
    },
    "idpMetadataUrl": {
      "description": "fetched and refreshed by the server",
      "type": "string"
    },
    "idpMetadataXml": {
      "description": "alternative to the URL",
      "type": "string"
    },
    "idpSsoUrl": {
      "type": "string"
    },
    "lastTestedAt": {
      "format": "date-time",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    },
    "sessionLifetimeSeconds": {
      "description": "how long an SSO session authorizes access",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "signatureMethod": {
      "description": "e.g. \"rsa-sha256\"",
      "type": "string"
    },
    "spAcsUrl": {
      "description": "assertion consumer service URL (read only)",
      "type": "string"
    },
    "spEntityId": {
      "description": "Beehive's entity id for this scope (read only)",
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.SamlSsoConfig",
  "type": "object"
}
