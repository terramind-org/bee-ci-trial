{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SafetyConcernCategory": {
      "enum": [
        "SAFETY_CONCERN_CATEGORY_UNSPECIFIED",
        "SAFETY_CONCERN_CATEGORY_RULE_CONFLICT",
        "SAFETY_CONCERN_CATEGORY_UNSAFE",
        "SAFETY_CONCERN_CATEGORY_POTENTIALLY_UNLAWFUL"
      ],
      "title": "bee.v1.SafetyConcernCategory",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.RaiseConcernRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "category": {
      "$ref": "#/$defs/bee.v1.SafetyConcernCategory"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "runId": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "title": "bee.v1.RaiseConcernRequest",
  "type": "object"
}
