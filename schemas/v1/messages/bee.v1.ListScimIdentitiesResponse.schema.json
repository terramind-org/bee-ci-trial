{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.ScimIdentity": {
      "description": "An identity provisioned through SCIM.",
      "properties": {
        "active": {
          "description": "false = deprovisioned; access removed everywhere",
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "emails": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "externalId": {
          "description": "the IdP's id",
          "type": "string"
        },
        "groups": {
          "description": "SCIM group ids",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "scimId": {
          "description": "the SCIM resource id we assigned",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "userName": {
          "type": "string"
        }
      },
      "title": "bee.v1.ScimIdentity",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListScimIdentitiesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListScimIdentities.",
  "properties": {
    "identities": {
      "items": {
        "$ref": "#/$defs/bee.v1.ScimIdentity"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListScimIdentitiesResponse",
  "type": "object"
}
