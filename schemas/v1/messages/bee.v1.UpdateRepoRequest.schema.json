{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Visibility": {
      "enum": [
        "VISIBILITY_UNSPECIFIED",
        "VISIBILITY_PRIVATE",
        "VISIBILITY_INTERNAL",
        "VISIBILITY_PUBLIC"
      ],
      "title": "bee.v1.Visibility",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateRepoRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "defaultRef": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "homepage": {
      "type": "string"
    },
    "isTemplate": {
      "type": "boolean"
    },
    "name": {
      "description": "rename; empty = unchanged",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "visibility": {
      "$ref": "#/$defs/bee.v1.Visibility"
    }
  },
  "title": "bee.v1.UpdateRepoRequest",
  "type": "object"
}
