{
  "$defs": {
    "bee.v1.TrafficReferrer": {
      "description": "A referring site.",
      "properties": {
        "count": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "referrer": {
          "description": "host, e.g. \"news.ycombinator.com\"",
          "type": "string"
        },
        "uniques": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.TrafficReferrer",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListTrafficReferrersResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListTrafficReferrers.",
  "properties": {
    "referrers": {
      "description": "top 10",
      "items": {
        "$ref": "#/$defs/bee.v1.TrafficReferrer"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListTrafficReferrersResponse",
  "type": "object"
}
