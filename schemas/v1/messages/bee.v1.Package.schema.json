{
  "$defs": {
    "bee.v1.PackageEcosystem": {
      "description": "The registry a package belongs to.",
      "enum": [
        "PACKAGE_ECOSYSTEM_UNSPECIFIED",
        "PACKAGE_ECOSYSTEM_CONTAINER",
        "PACKAGE_ECOSYSTEM_NPM",
        "PACKAGE_ECOSYSTEM_MAVEN",
        "PACKAGE_ECOSYSTEM_NUGET",
        "PACKAGE_ECOSYSTEM_RUBYGEMS",
        "PACKAGE_ECOSYSTEM_CARGO"
      ],
      "title": "bee.v1.PackageEcosystem",
      "type": "string"
    },
    "bee.v1.PackageOwnerKind": {
      "description": "Whether a package owner is an org or a user.",
      "enum": [
        "PACKAGE_OWNER_KIND_UNSPECIFIED",
        "PACKAGE_OWNER_KIND_ORG",
        "PACKAGE_OWNER_KIND_USER"
      ],
      "title": "bee.v1.PackageOwnerKind",
      "type": "string"
    },
    "bee.v1.PackageVisibility": {
      "description": "Who can read a package.",
      "enum": [
        "PACKAGE_VISIBILITY_UNSPECIFIED",
        "PACKAGE_VISIBILITY_PRIVATE",
        "PACKAGE_VISIBILITY_INTERNAL",
        "PACKAGE_VISIBILITY_PUBLIC"
      ],
      "title": "bee.v1.PackageVisibility",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.Package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A named package in one ecosystem, owned by an org or user.",
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "deletedAt": {
      "description": "set while restorable",
      "format": "date-time",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "downloadCount": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "ecosystem": {
      "$ref": "#/$defs/bee.v1.PackageEcosystem"
    },
    "htmlUrl": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "inheritAccessFromRepo": {
      "type": "boolean"
    },
    "name": {
      "description": "e.g. \"@scope/pkg\", \"com.example:lib\", \"app\"",
      "type": "string"
    },
    "owner": {
      "description": "org or user name",
      "type": "string"
    },
    "ownerKind": {
      "$ref": "#/$defs/bee.v1.PackageOwnerKind"
    },
    "registryUrl": {
      "description": "e.g. \"oci.beehive.dev/org/app\"",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "linked source repo, if any"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "versionCount": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "visibility": {
      "$ref": "#/$defs/bee.v1.PackageVisibility"
    }
  },
  "title": "bee.v1.Package",
  "type": "object"
}
