{
  "$defs": {
    "bee.v1.ItemStatus": {
      "description": "Per-item outcome in a batch read; one failed item never fails the batch.",
      "enum": [
        "ITEM_STATUS_UNSPECIFIED",
        "ITEM_STATUS_OK",
        "ITEM_STATUS_NOT_FOUND",
        "ITEM_STATUS_PERMISSION_DENIED",
        "ITEM_STATUS_REDACTED"
      ],
      "title": "bee.v1.ItemStatus",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ResolveResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "ids": {
      "items": {
        "$ref": "#/$defs/bee.v1.ObjectId"
      },
      "type": "array"
    },
    "statuses": {
      "description": "one per revision; ids[i] is unset unless OK",
      "items": {
        "$ref": "#/$defs/bee.v1.ItemStatus"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ResolveResponse",
  "type": "object"
}
