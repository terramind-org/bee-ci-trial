{
  "$defs": {
    "bee.v1.AnomalySeverity": {
      "description": "How bad an anomaly is.",
      "enum": [
        "ANOMALY_SEVERITY_UNSPECIFIED",
        "ANOMALY_SEVERITY_INFO",
        "ANOMALY_SEVERITY_WARNING",
        "ANOMALY_SEVERITY_CRITICAL"
      ],
      "title": "bee.v1.AnomalySeverity",
      "type": "string"
    },
    "bee.v1.AnomalyState": {
      "description": "Anomaly lifecycle.",
      "enum": [
        "ANOMALY_STATE_UNSPECIFIED",
        "ANOMALY_STATE_OPEN",
        "ANOMALY_STATE_ACKNOWLEDGED",
        "ANOMALY_STATE_RESOLVED"
      ],
      "title": "bee.v1.AnomalyState",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWatcherAnomaliesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListWatcherAnomalies.",
  "properties": {
    "minSeverity": {
      "$ref": "#/$defs/bee.v1.AnomalySeverity"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "since": {
      "format": "date-time",
      "type": "string"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/bee.v1.AnomalyState"
      },
      "type": "array"
    },
    "watcherId": {
      "type": "string"
    }
  },
  "title": "bee.v1.ListWatcherAnomaliesRequest",
  "type": "object"
}
