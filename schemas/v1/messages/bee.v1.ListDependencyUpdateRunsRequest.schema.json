{
  "$defs": {
    "bee.v1.DependencyUpdateRunState": {
      "description": "State of an update run.",
      "enum": [
        "DEPENDENCY_UPDATE_RUN_STATE_UNSPECIFIED",
        "DEPENDENCY_UPDATE_RUN_STATE_QUEUED",
        "DEPENDENCY_UPDATE_RUN_STATE_RUNNING",
        "DEPENDENCY_UPDATE_RUN_STATE_SUCCEEDED",
        "DEPENDENCY_UPDATE_RUN_STATE_FAILED"
      ],
      "title": "bee.v1.DependencyUpdateRunState",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListDependencyUpdateRunsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListDependencyUpdateRuns.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.DependencyUpdateRunState"
    }
  },
  "title": "bee.v1.ListDependencyUpdateRunsRequest",
  "type": "object"
}
