{
  "$defs": {
    "bee.v1.CheckStatus": {
      "enum": [
        "CHECK_STATUS_UNSPECIFIED",
        "CHECK_STATUS_QUEUED",
        "CHECK_STATUS_RUNNING",
        "CHECK_STATUS_PASSED",
        "CHECK_STATUS_FAILED",
        "CHECK_STATUS_SKIPPED",
        "CHECK_STATUS_CANCELLED",
        "CHECK_STATUS_TIMED_OUT",
        "CHECK_STATUS_NEUTRAL",
        "CHECK_STATUS_ACTION_REQUIRED",
        "CHECK_STATUS_STALE"
      ],
      "title": "bee.v1.CheckStatus",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CheckSuite.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Checks reported by one app or workflow for one changeset.",
  "properties": {
    "appId": {
      "type": "string"
    },
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "headRef": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "repoId": {
      "type": "string"
    },
    "runsCount": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/bee.v1.CheckStatus",
      "description": "aggregate of its runs"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.CheckSuite",
  "type": "object"
}
