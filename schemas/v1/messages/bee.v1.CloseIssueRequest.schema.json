{
  "$defs": {
    "bee.v1.IssueRef": {
      "description": "Names an issue by id, or by repo and number. Used for cross-repo relations.",
      "properties": {
        "id": {
          "description": "alternative to repo + number",
          "type": "string"
        },
        "number": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.IssueRef",
      "type": "object"
    },
    "bee.v1.IssueStateReason": {
      "description": "Why an issue is in its current state.",
      "enum": [
        "ISSUE_STATE_REASON_UNSPECIFIED",
        "ISSUE_STATE_REASON_COMPLETED",
        "ISSUE_STATE_REASON_NOT_PLANNED",
        "ISSUE_STATE_REASON_DUPLICATE",
        "ISSUE_STATE_REASON_REOPENED"
      ],
      "title": "bee.v1.IssueStateReason",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CloseIssueRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CloseIssue.",
  "properties": {
    "comment": {
      "description": "optional closing comment",
      "type": "string"
    },
    "duplicateOf": {
      "$ref": "#/$defs/bee.v1.IssueRef",
      "description": "required when reason is DUPLICATE"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "number": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "reason": {
      "$ref": "#/$defs/bee.v1.IssueStateReason",
      "description": "UNSPECIFIED = COMPLETED"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.CloseIssueRequest",
  "type": "object"
}
