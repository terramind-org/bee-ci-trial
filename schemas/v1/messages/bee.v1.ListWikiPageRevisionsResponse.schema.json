{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.WikiPageRevision": {
      "description": "One revision of a page.",
      "properties": {
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "description": "page path at this revision (follows renames)",
          "type": "string"
        }
      },
      "title": "bee.v1.WikiPageRevision",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWikiPageRevisionsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListWikiPageRevisions.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/bee.v1.WikiPageRevision"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListWikiPageRevisionsResponse",
  "type": "object"
}
