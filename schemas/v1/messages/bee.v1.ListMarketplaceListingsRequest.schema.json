{
  "$defs": {
    "bee.v1.MarketplaceListingType": {
      "description": "What a marketplace listing offers.",
      "enum": [
        "MARKETPLACE_LISTING_TYPE_UNSPECIFIED",
        "MARKETPLACE_LISTING_TYPE_APP",
        "MARKETPLACE_LISTING_TYPE_ACTION",
        "MARKETPLACE_LISTING_TYPE_AGENT"
      ],
      "title": "bee.v1.MarketplaceListingType",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListMarketplaceListingsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListMarketplaceListings.",
  "properties": {
    "category": {
      "type": "string"
    },
    "freeOnly": {
      "type": "boolean"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "publisher": {
      "description": "org name; the publisher also sees its drafts",
      "type": "string"
    },
    "query": {
      "description": "free text over name and descriptions",
      "type": "string"
    },
    "sort": {
      "description": "\"popularity\" (default), \"recent\", \"name\"",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/bee.v1.MarketplaceListingType",
      "description": "UNSPECIFIED = all"
    },
    "verifiedOnly": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.ListMarketplaceListingsRequest",
  "type": "object"
}
