{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.UserSession": {
      "description": "An active session on the caller's account.",
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "current": {
          "type": "boolean"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ipAddress": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.UserSessionKind"
        },
        "lastActiveAt": {
          "format": "date-time",
          "type": "string"
        },
        "location": {
          "description": "approximate, from IP",
          "type": "string"
        },
        "userAgent": {
          "type": "string"
        }
      },
      "title": "bee.v1.UserSession",
      "type": "object"
    },
    "bee.v1.UserSessionKind": {
      "description": "Kind of an account session.",
      "enum": [
        "USER_SESSION_KIND_UNSPECIFIED",
        "USER_SESSION_KIND_WEB",
        "USER_SESSION_KIND_MOBILE",
        "USER_SESSION_KIND_CLI"
      ],
      "title": "bee.v1.UserSessionKind",
      "type": "string"
    },
    "bee.v1.UserTokenSummary": {
      "description": "Counts of live tokens held by the caller and their agents.",
      "properties": {
        "agentTokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "appAuthorizations": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oldestExpiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "personalTokens": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.UserTokenSummary",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListUserSessionsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListUserSessions.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "sessions": {
      "items": {
        "$ref": "#/$defs/bee.v1.UserSession"
      },
      "type": "array"
    },
    "tokens": {
      "$ref": "#/$defs/bee.v1.UserTokenSummary"
    }
  },
  "title": "bee.v1.ListUserSessionsResponse",
  "type": "object"
}
