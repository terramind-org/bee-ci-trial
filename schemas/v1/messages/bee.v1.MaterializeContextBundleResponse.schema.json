{
  "$defs": {
    "bee.v1.ContextBundleItem": {
      "description": "One item in a context bundle.\n\nOneof `item`: at most one of `path`, `subject`, `url`, `note` is set.",
      "properties": {
        "label": {
          "type": "string"
        },
        "note": {
          "description": "inline text",
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "description": "file or directory prefix in the bundle's repo",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "issue, CR, discussion, wiki page"
        },
        "url": {
          "description": "external doc",
          "type": "string"
        }
      },
      "title": "bee.v1.ContextBundleItem",
      "type": "object"
    },
    "bee.v1.ContextBundleResolvedFile": {
      "description": "A file resolved from a path item.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.ContextBundleResolvedFile",
      "type": "object"
    },
    "bee.v1.ContextBundleResolvedItem": {
      "description": "One resolved bundle item.",
      "properties": {
        "body": {
          "description": "subject body or note, when include_bodies",
          "type": "string"
        },
        "files": {
          "description": "for path items",
          "items": {
            "$ref": "#/$defs/bee.v1.ContextBundleResolvedFile"
          },
          "type": "array"
        },
        "item": {
          "$ref": "#/$defs/bee.v1.ContextBundleItem"
        },
        "status": {
          "$ref": "#/$defs/bee.v1.ItemStatus"
        },
        "title": {
          "description": "for subject items",
          "type": "string"
        }
      },
      "title": "bee.v1.ContextBundleResolvedItem",
      "type": "object"
    },
    "bee.v1.ItemStatus": {
      "description": "Per-item outcome in a batch read; one failed item never fails the batch.",
      "enum": [
        "ITEM_STATUS_UNSPECIFIED",
        "ITEM_STATUS_OK",
        "ITEM_STATUS_NOT_FOUND",
        "ITEM_STATUS_PERMISSION_DENIED",
        "ITEM_STATUS_REDACTED"
      ],
      "title": "bee.v1.ItemStatus",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.MaterializeContextBundleResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for MaterializeContextBundle.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/bee.v1.ContextBundleResolvedItem"
      },
      "type": "array"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.MaterializeContextBundleResponse",
  "type": "object"
}
