{
  "$defs": {
    "bee.v1.AuditLogFilter": {
      "description": "Filters shared by queries, exports and streams.",
      "properties": {
        "actionPrefixes": {
          "description": "e.g. \"repo.\", \"token.revoke\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "actorId": {
          "type": "string"
        },
        "deniedOnly": {
          "description": "Only entries whose policy decision denied the action (gap G5).",
          "type": "boolean"
        },
        "end": {
          "format": "date-time",
          "type": "string"
        },
        "onBehalfOf": {
          "description": "delegation root principal id",
          "type": "string"
        },
        "phrase": {
          "description": "free text with qualifiers: actor:, action:, repo:, created:",
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "requestId": {
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/bee.v1.SubjectRef"
        }
      },
      "title": "bee.v1.AuditLogFilter",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.StreamAuditLogRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for StreamAuditLog.",
  "properties": {
    "afterSeq": {
      "description": "0 = only new entries",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "enterprise": {
      "type": "string"
    },
    "filter": {
      "$ref": "#/$defs/bee.v1.AuditLogFilter"
    },
    "org": {
      "type": "string"
    }
  },
  "title": "bee.v1.StreamAuditLogRequest",
  "type": "object"
}
