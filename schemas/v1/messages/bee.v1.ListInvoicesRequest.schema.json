{
  "$defs": {
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    },
    "bee.v1.InvoiceStatus": {
      "description": "Payment state of an invoice.",
      "enum": [
        "INVOICE_STATUS_UNSPECIFIED",
        "INVOICE_STATUS_DRAFT",
        "INVOICE_STATUS_OPEN",
        "INVOICE_STATUS_PAID",
        "INVOICE_STATUS_VOID",
        "INVOICE_STATUS_UNCOLLECTIBLE"
      ],
      "title": "bee.v1.InvoiceStatus",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListInvoicesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListInvoices.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    },
    "status": {
      "$ref": "#/$defs/bee.v1.InvoiceStatus",
      "description": "filter"
    }
  },
  "title": "bee.v1.ListInvoicesRequest",
  "type": "object"
}
