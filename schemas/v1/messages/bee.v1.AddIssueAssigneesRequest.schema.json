{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.AddIssueAssigneesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for AddIssueAssignees.",
  "properties": {
    "agentInstructions": {
      "description": "extra instructions passed to any agent run started",
      "type": "string"
    },
    "assignees": {
      "description": "principal ids or handles",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "baseRef": {
      "description": "ref an agent should branch from; empty = default",
      "type": "string"
    },
    "number": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.AddIssueAssigneesRequest",
  "type": "object"
}
