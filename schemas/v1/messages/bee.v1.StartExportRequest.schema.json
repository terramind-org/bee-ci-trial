{
  "$defs": {
    "bee.v1.ExportFormat": {
      "description": "What an export produces.",
      "enum": [
        "EXPORT_FORMAT_UNSPECIFIED",
        "EXPORT_FORMAT_GITHUB_ARCHIVE",
        "EXPORT_FORMAT_GIT_PUSH"
      ],
      "title": "bee.v1.ExportFormat",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.StartExportRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "format": {
      "$ref": "#/$defs/bee.v1.ExportFormat"
    },
    "includeMetadata": {
      "description": "issues, CRs, reviews, releases (archive only)",
      "type": "boolean"
    },
    "org": {
      "type": "string"
    },
    "remoteToken": {
      "description": "write-only",
      "type": "string"
    },
    "remoteUrl": {
      "description": "GIT_PUSH target",
      "type": "string"
    },
    "repos": {
      "description": "empty = every repo in the org",
      "items": {
        "$ref": "#/$defs/bee.v1.RepoRef"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.StartExportRequest",
  "type": "object"
}
