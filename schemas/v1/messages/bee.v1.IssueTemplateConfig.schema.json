{
  "$defs": {
    "bee.v1.IssueContactLink": {
      "description": "A contact link shown in the template chooser.",
      "properties": {
        "about": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "title": "bee.v1.IssueContactLink",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.IssueTemplateConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Template chooser configuration from config.yml.",
  "properties": {
    "blankIssuesEnabled": {
      "type": "boolean"
    },
    "contactLinks": {
      "items": {
        "$ref": "#/$defs/bee.v1.IssueContactLink"
      },
      "type": "array"
    },
    "revision": {
      "description": "changeset the config was read from",
      "type": "string"
    }
  },
  "title": "bee.v1.IssueTemplateConfig",
  "type": "object"
}
