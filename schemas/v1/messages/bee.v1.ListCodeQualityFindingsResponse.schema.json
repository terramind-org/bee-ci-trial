{
  "$defs": {
    "bee.v1.CodeQualityFindingState": {
      "description": "State of a code quality finding.",
      "enum": [
        "CODE_QUALITY_FINDING_STATE_UNSPECIFIED",
        "CODE_QUALITY_FINDING_STATE_OPEN",
        "CODE_QUALITY_FINDING_STATE_DISMISSED",
        "CODE_QUALITY_FINDING_STATE_FIXED"
      ],
      "title": "bee.v1.CodeQualityFindingState",
      "type": "string"
    },
    "bee.v1.CodeScanningLocation": {
      "description": "A source location.",
      "properties": {
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "startColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.CodeScanningLocation",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SecurityCodeQualityFinding": {
      "description": "A maintainability or reliability finding.",
      "properties": {
        "category": {
          "description": "\"maintainability\", \"reliability\", ...",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/bee.v1.CodeScanningLocation"
        },
        "message": {
          "type": "string"
        },
        "number": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "ref": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "ruleId": {
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/bee.v1.SecuritySeverity"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.CodeQualityFindingState"
        },
        "toolName": {
          "type": "string"
        }
      },
      "title": "bee.v1.SecurityCodeQualityFinding",
      "type": "object"
    },
    "bee.v1.SecuritySeverity": {
      "description": "Severity used by advisories, alerts and findings.",
      "enum": [
        "SECURITY_SEVERITY_UNSPECIFIED",
        "SECURITY_SEVERITY_LOW",
        "SECURITY_SEVERITY_MEDIUM",
        "SECURITY_SEVERITY_HIGH",
        "SECURITY_SEVERITY_CRITICAL"
      ],
      "title": "bee.v1.SecuritySeverity",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListCodeQualityFindingsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListCodeQualityFindings.",
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/bee.v1.SecurityCodeQualityFinding"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListCodeQualityFindingsResponse",
  "type": "object"
}
