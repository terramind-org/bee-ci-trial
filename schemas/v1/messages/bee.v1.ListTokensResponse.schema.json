{
  "$defs": {
    "bee.v1.Budget": {
      "properties": {
        "maxChangesets": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxLanded": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUploadBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Budget",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.TokenInfo": {
      "description": "Metadata about a minted token. The token itself is never returned again.",
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "lastUsedAt": {
          "format": "date-time",
          "type": "string"
        },
        "parentTokenId": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "revoked": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/bee.v1.TokenScope"
        },
        "tokenId": {
          "type": "string"
        },
        "used": {
          "$ref": "#/$defs/bee.v1.Budget",
          "description": "Consumption so far against scope.budget (gap G2)."
        }
      },
      "title": "bee.v1.TokenInfo",
      "type": "object"
    },
    "bee.v1.TokenScope": {
      "properties": {
        "actions": {
          "description": "read, commit, land, review, lease, admin",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/bee.v1.Budget"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "readPaths": {
          "description": "prefixes; empty = inherit",
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "description": "patterns, e.g. \"ws/*\", \"main\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repos": {
          "description": "repo ids or \"org/*\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "description": "copied into provenance",
          "type": "string"
        },
        "writePaths": {
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.TokenScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListTokensResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "tokens": {
      "items": {
        "$ref": "#/$defs/bee.v1.TokenInfo"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListTokensResponse",
  "type": "object"
}
