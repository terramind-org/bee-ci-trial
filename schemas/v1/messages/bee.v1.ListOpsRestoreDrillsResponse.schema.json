          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "failure": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        },
        "ranAt": {
          "format": "date-time",
          "type": "string"
        },
        "restoreDurationSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
