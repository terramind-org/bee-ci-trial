{
  "$defs": {
    "bee.v1.Attestation": {
      "description": "A signed in-toto statement about built artifacts (Sigstore bundle).",
      "properties": {
        "bundleJson": {
          "description": "Sigstore bundle, JSON",
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "jobId": {
          "type": "string"
        },
        "predicateJson": {
          "description": "JSON",
          "type": "string"
        },
        "predicateType": {
          "description": "e.g. \"https://slsa.dev/provenance/v1\"",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/bee.v1.Provenance",
          "description": "agent provenance of the source changeset, when present"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "signerIdentity": {
          "description": "certificate SAN, e.g. the signer workflow ref",
          "type": "string"
        },
        "sourceChangeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "sourceRef": {
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/bee.v1.AttestationSubject"
          },
          "type": "array"
        },
        "workflowPath": {
          "type": "string"
        },
        "workflowRunId": {
          "type": "string"
        }
      },
      "title": "bee.v1.Attestation",
      "type": "object"
    },
    "bee.v1.AttestationSubject": {
      "description": "An artifact an attestation is about.",
      "properties": {
        "digest": {
          "description": "\"sha256:<hex>\"",
          "type": "string"
        },
        "name": {
          "description": "e.g. image reference or file name",
          "type": "string"
        }
      },
      "title": "bee.v1.AttestationSubject",
      "type": "object"
    },
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.LocalCheck": {
      "properties": {
        "durationMs": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "type": "string"
        },
        "result": {
          "type": "string"
        }
      },
      "title": "bee.v1.LocalCheck",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Provenance": {
      "description": "Provenance claims recorded in Meta (SPEC §10.4).",
      "properties": {
        "checksRun": {
          "items": {
            "$ref": "#/$defs/bee.v1.LocalCheck"
          },
          "type": "array"
        },
        "cost": {
          "$ref": "#/$defs/bee.v1.Cost"
        },
        "model": {
          "type": "string"
        },
        "principalChain": {
          "description": "filled by the server",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "promptDigest": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "title": "bee.v1.Provenance",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.VerifyAttestationResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for VerifyAttestation.",
  "properties": {
    "attestations": {
      "description": "the ones that verified",
      "items": {
        "$ref": "#/$defs/bee.v1.Attestation"
      },
      "type": "array"
    },
    "failures": {
      "description": "why others did not",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "verified": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.VerifyAttestationResponse",
  "type": "object"
}
