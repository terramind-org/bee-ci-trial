{
  "$defs": {
    "bee.v1.CodeScanningAlertInstance": {
      "description": "One occurrence of an alert on a ref.",
      "properties": {
        "analysisId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "classifications": {
          "description": "e.g. \"test\", \"generated\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "location": {
          "$ref": "#/$defs/bee.v1.CodeScanningLocation"
        },
        "message": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.CodeScanningAlertState"
        }
      },
      "title": "bee.v1.CodeScanningAlertInstance",
      "type": "object"
    },
    "bee.v1.CodeScanningAlertState": {
      "description": "State of a code scanning alert.",
      "enum": [
        "CODE_SCANNING_ALERT_STATE_UNSPECIFIED",
        "CODE_SCANNING_ALERT_STATE_OPEN",
        "CODE_SCANNING_ALERT_STATE_DISMISSED",
        "CODE_SCANNING_ALERT_STATE_FIXED"
      ],
      "title": "bee.v1.CodeScanningAlertState",
      "type": "string"
    },
    "bee.v1.CodeScanningLocation": {
      "description": "A source location.",
      "properties": {
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "startColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.CodeScanningLocation",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListCodeScanningAlertInstancesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListCodeScanningAlertInstances.",
  "properties": {
    "instances": {
      "items": {
        "$ref": "#/$defs/bee.v1.CodeScanningAlertInstance"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListCodeScanningAlertInstancesResponse",
  "type": "object"
}
