{
  "$defs": {
    "bee.v1.ContextBundleItem": {
      "description": "One item in a context bundle.\n\nOneof `item`: at most one of `path`, `subject`, `url`, `note` is set.",
      "properties": {
        "label": {
          "type": "string"
        },
        "note": {
          "description": "inline text",
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "description": "file or directory prefix in the bundle's repo",
          "type": "string"
        },
        "subject": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "issue, CR, discussion, wiki page"
        },
        "url": {
          "description": "external doc",
          "type": "string"
        }
      },
      "title": "bee.v1.ContextBundleItem",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateContextBundleRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateContextBundle.",
  "properties": {
    "description": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "items": {
      "description": "non-empty replaces the items",
      "items": {
        "$ref": "#/$defs/bee.v1.ContextBundleItem"
      },
      "type": "array"
    },
    "name": {
      "type": "string"
    },
    "shared": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.UpdateContextBundleRequest",
  "type": "object"
}
