{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.EditChangeRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "allowMaintainerEdits": {
      "description": "fork CRs only; set by the CR's author",
      "type": "boolean"
    },
    "body": {
      "type": "string"
    },
    "dependsOn": {
      "type": "string"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "id": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "targetRef": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "title": "bee.v1.EditChangeRequest",
  "type": "object"
}
