{
  "$defs": {
    "bee.v1.InsightsOrgDependency": {
      "description": "One dependency aggregated across an org's repos.",
      "properties": {
        "ecosystem": {
          "description": "e.g. \"cargo\", \"npm\"",
          "type": "string"
        },
        "highestSeverity": {
          "description": "\"low\", \"moderate\", \"high\", \"critical\"",
          "type": "string"
        },
        "licenses": {
          "description": "SPDX ids",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "openAdvisories": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "packageName": {
          "type": "string"
        },
        "repoCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "repos": {
          "description": "full names, up to a limit",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "versions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.InsightsOrgDependency",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListInsightsOrgDependenciesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListInsightsOrgDependencies.",
  "properties": {
    "dependencies": {
      "items": {
        "$ref": "#/$defs/bee.v1.InsightsOrgDependency"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "totalCount": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.ListInsightsOrgDependenciesResponse",
  "type": "object"
}
