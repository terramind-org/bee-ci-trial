{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.WikiPageFormat": {
      "description": "Markup language of a wiki page, chosen by file extension.",
      "enum": [
        "WIKI_PAGE_FORMAT_UNSPECIFIED",
        "WIKI_PAGE_FORMAT_MARKDOWN",
        "WIKI_PAGE_FORMAT_ASCIIDOC",
        "WIKI_PAGE_FORMAT_RST",
        "WIKI_PAGE_FORMAT_ORG",
        "WIKI_PAGE_FORMAT_TEXTILE",
        "WIKI_PAGE_FORMAT_MEDIAWIKI"
      ],
      "title": "bee.v1.WikiPageFormat",
      "type": "string"
    },
    "bee.v1.WikiPageSummary": {
      "description": "One page entry in a listing, without content.",
      "properties": {
        "format": {
          "$ref": "#/$defs/bee.v1.WikiPageFormat"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.WikiPageSummary",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWikiPagesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListWikiPages.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/bee.v1.WikiPageSummary"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListWikiPagesResponse",
  "type": "object"
}
