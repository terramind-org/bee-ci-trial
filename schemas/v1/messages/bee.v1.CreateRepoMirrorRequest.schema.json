{
  "$defs": {
    "bee.v1.MirrorDirection": {
      "description": "Direction of a repo mirror.",
      "enum": [
        "MIRROR_DIRECTION_UNSPECIFIED",
        "MIRROR_DIRECTION_PUSH",
        "MIRROR_DIRECTION_PULL"
      ],
      "title": "bee.v1.MirrorDirection",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateRepoMirrorRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "credential": {
      "description": "write-only",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/bee.v1.MirrorDirection"
    },
    "intervalSeconds": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "refPatterns": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "remoteUrl": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.CreateRepoMirrorRequest",
  "type": "object"
}
