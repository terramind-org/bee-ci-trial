{
  "$defs": {
    "bee.v1.WorkspaceUsageLine": {
      "description": "Usage for one machine type.",
      "properties": {
        "coreSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "machineType": {
          "type": "string"
        },
        "storageByteHours": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.WorkspaceUsageLine",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.WorkspaceUsage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Compute and storage usage.",
  "properties": {
    "lines": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkspaceUsageLine"
      },
      "type": "array"
    },
    "org": {
      "type": "string"
    },
    "prebuildUsdMicros": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "principalId": {
      "type": "string"
    },
    "totalUsdMicros": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "windowEnd": {
      "format": "date-time",
      "type": "string"
    },
    "windowStart": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.WorkspaceUsage",
  "type": "object"
}
