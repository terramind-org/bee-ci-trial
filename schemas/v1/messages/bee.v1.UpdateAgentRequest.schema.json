{
  "$defs": {
    "bee.v1.AgentRunBudget": {
      "description": "Spending and time limits for a run.",
      "properties": {
        "maxChangesets": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxDurationSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxInputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxLanded": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUsdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.AgentRunBudget",
      "type": "object"
    },
    "bee.v1.AgentSchedule": {
      "description": "A scheduled run of an agent.",
      "properties": {
        "cron": {
          "description": "five-field cron expression, UTC",
          "type": "string"
        },
        "id": {
          "description": "assigned when empty",
          "type": "string"
        },
        "lastFiredAt": {
          "description": "read-only",
          "format": "date-time",
          "type": "string"
        },
        "prompt": {
          "description": "the task prompt",
          "type": "string"
        },
        "repoId": {
          "description": "repo the run works in",
          "type": "string"
        }
      },
      "title": "bee.v1.AgentSchedule",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateAgentRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateAgent. Needs being an owner of the agent, or org owner/admin.",
  "properties": {
    "agentPrincipalId": {
      "type": "string"
    },
    "defaultBudget": {
      "$ref": "#/$defs/bee.v1.AgentRunBudget",
      "description": "unset = unchanged"
    },
    "enabled": {
      "type": "boolean"
    },
    "instructionsPath": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "owners": {
      "description": "non-empty replaces",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "purpose": {
      "type": "string"
    },
    "replaceSchedules": {
      "type": "boolean"
    },
    "replaceToolsets": {
      "description": "set toolsets even when the list is empty",
      "type": "boolean"
    },
    "runtime": {
      "type": "string"
    },
    "runtimeId": {
      "type": "string"
    },
    "schedules": {
      "description": "replaces when non-empty or replace_schedules",
      "items": {
        "$ref": "#/$defs/bee.v1.AgentSchedule"
      },
      "type": "array"
    },
    "toolsets": {
      "description": "replaces when non-empty or replace_toolsets",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.UpdateAgentRequest",
  "type": "object"
}
