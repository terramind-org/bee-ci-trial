{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Revision": {
      "description": "A revision expression: ref name, ref@version, changeset id or unique prefix.",
      "properties": {
        "expr": {
          "type": "string"
        }
      },
      "title": "bee.v1.Revision",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GenerateReleaseNotesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GenerateReleaseNotes.",
  "properties": {
    "configPath": {
      "contentEncoding": "base64",
      "description": "default \".github/release.yml\"",
      "type": "string"
    },
    "previousTagName": {
      "description": "default the previous release's tag",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "tagName": {
      "description": "tag for the new release; may not exist yet",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/bee.v1.Revision",
      "description": "used when the tag does not exist; default the default ref"
    }
  },
  "title": "bee.v1.GenerateReleaseNotesRequest",
  "type": "object"
}
