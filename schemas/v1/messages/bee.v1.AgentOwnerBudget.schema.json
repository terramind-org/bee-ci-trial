      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "maxOutputTokens": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "maxRuns": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "maxUsdMicros": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "org": {
      "type": "string"
    },
    "ownerId": {
      "type": "string"
    },
    "runsStarted": {
