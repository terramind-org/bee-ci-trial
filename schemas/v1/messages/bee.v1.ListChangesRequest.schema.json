{
  "$defs": {
    "bee.v1.ChangeState": {
      "enum": [
        "CHANGE_STATE_UNSPECIFIED",
        "CHANGE_STATE_OPEN",
        "CHANGE_STATE_LANDED",
        "CHANGE_STATE_CLOSED"
      ],
      "title": "bee.v1.ChangeState",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListChangesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assigneeId": {
      "type": "string"
    },
    "authorId": {
      "type": "string"
    },
    "draft": {
      "type": "boolean"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "pathPrefix": {
      "contentEncoding": "base64",
      "description": "CRs touching paths under this prefix",
      "type": "string"
    },
    "query": {
      "description": "GitHub-compatible qualifiers, e.g. \"is:open review:required\"",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "reviewRequestedId": {
      "description": "principal or team id with a pending review request",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.ChangeState"
    },
    "targetRef": {
      "type": "string"
    }
  },
  "title": "bee.v1.ListChangesRequest",
  "type": "object"
}
