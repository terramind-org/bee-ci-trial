{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.SecurityAlertKind": {
      "description": "Kind of alert counted by the overview and targeted by campaigns.",
      "enum": [
        "SECURITY_ALERT_KIND_UNSPECIFIED",
        "SECURITY_ALERT_KIND_DEPENDENCY",
        "SECURITY_ALERT_KIND_CODE_SCANNING",
        "SECURITY_ALERT_KIND_SECRET_SCANNING",
        "SECURITY_ALERT_KIND_CODE_QUALITY"
      ],
      "title": "bee.v1.SecurityAlertKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetSecurityOverviewRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GetSecurityOverview.",
  "properties": {
    "kinds": {
      "description": "empty = all",
      "items": {
        "$ref": "#/$defs/bee.v1.SecurityAlertKind"
      },
      "type": "array"
    },
    "org": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repoQuery": {
      "description": "filters repos, e.g. \"topic:payments\"",
      "type": "string"
    },
    "windowEnd": {
      "format": "date-time",
      "type": "string"
    },
    "windowStart": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.GetSecurityOverviewRequest",
  "type": "object"
}
