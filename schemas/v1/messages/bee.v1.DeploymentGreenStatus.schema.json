{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.DeploymentGreenStatus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Whether a ref tip passed post-land testing; `green/<ref>` tracks the newest green tip.",
  "properties": {
    "bisectInProgress": {
      "description": "a failure on the ref is being bisected",
      "type": "boolean"
    },
    "evaluatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "failingContexts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "green": {
      "type": "boolean"
    },
    "greenRef": {
      "description": "e.g. \"green/main\"",
      "type": "string"
    },
    "greenTip": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "newest green changeset on the ref"
    },
    "pendingContexts": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ref": {
      "type": "string"
    },
    "tip": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    }
  },
  "title": "bee.v1.DeploymentGreenStatus",
  "type": "object"
}
