{
  "$defs": {
    "bee.v1.FsckViolation": {
      "description": "One fsck violation (the enumerated kinds are listed in SPEC §14).",
      "properties": {
        "detail": {
          "type": "string"
        },
        "kind": {
          "description": "e.g. \"dangling_reference\", \"missing_bytes\", \"hash_mismatch\"",
          "type": "string"
        },
        "object": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "repoId": {
          "type": "string"
        }
      },
      "title": "bee.v1.FsckViolation",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.RunFsckResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changesetsChecked": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "clean": {
      "type": "boolean"
    },
    "objectsChecked": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "refsChecked": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/bee.v1.FsckViolation"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.RunFsckResponse",
  "type": "object"
}
