{
  "$defs": {
    "bee.v1.RunnerGroupVisibility": {
      "description": "Which repos may use a runner group.",
      "enum": [
        "RUNNER_GROUP_VISIBILITY_UNSPECIFIED",
        "RUNNER_GROUP_VISIBILITY_ALL",
        "RUNNER_GROUP_VISIBILITY_PRIVATE",
        "RUNNER_GROUP_VISIBILITY_SELECTED"
      ],
      "title": "bee.v1.RunnerGroupVisibility",
      "type": "string"
    },
    "bee.v1.RunnerGroupWorkflows": {
      "description": "The full selected workflow list, wrapped so an update can tell \"unchanged\" from \"empty\".",
      "properties": {
        "workflows": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.RunnerGroupWorkflows",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateRunnerGroupRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateRunnerGroup.",
  "properties": {
    "allowsPublicRepos": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "networkConfigurationId": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "restrictedToWorkflows": {
      "type": "boolean"
    },
    "runnerGroupId": {
      "type": "string"
    },
    "selectedWorkflows": {
      "$ref": "#/$defs/bee.v1.RunnerGroupWorkflows",
      "description": "unset = unchanged"
    },
    "visibility": {
      "$ref": "#/$defs/bee.v1.RunnerGroupVisibility"
    }
  },
  "title": "bee.v1.UpdateRunnerGroupRequest",
  "type": "object"
}
