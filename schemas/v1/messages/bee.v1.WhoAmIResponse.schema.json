{
  "$defs": {
    "bee.v1.Budget": {
      "properties": {
        "maxChangesets": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxLanded": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUploadBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Budget",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.TokenScope": {
      "properties": {
        "actions": {
          "description": "read, commit, land, review, lease, admin",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/bee.v1.Budget"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "readPaths": {
          "description": "prefixes; empty = inherit",
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        },
        "refs": {
          "description": "patterns, e.g. \"ws/*\", \"main\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repos": {
          "description": "repo ids or \"org/*\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "description": "copied into provenance",
          "type": "string"
        },
        "writePaths": {
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.TokenScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.WhoAmIResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "effectiveScope": {
      "$ref": "#/$defs/bee.v1.TokenScope"
    },
    "expiresAt": {
      "description": "token expiry",
      "format": "date-time",
      "type": "string"
    },
    "groups": {
      "description": "policy groups the principal belongs to",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "onBehalfOf": {
      "description": "delegation chain back to a human or service",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "principal": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "remaining": {
      "$ref": "#/$defs/bee.v1.Budget"
    },
    "tokenId": {
      "type": "string"
    }
  },
  "title": "bee.v1.WhoAmIResponse",
  "type": "object"
}
