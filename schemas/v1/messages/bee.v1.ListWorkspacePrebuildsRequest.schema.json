{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WorkspacePrebuildState": {
      "description": "Prebuild lifecycle.",
      "enum": [
        "WORKSPACE_PREBUILD_STATE_UNSPECIFIED",
        "WORKSPACE_PREBUILD_STATE_QUEUED",
        "WORKSPACE_PREBUILD_STATE_RUNNING",
        "WORKSPACE_PREBUILD_STATE_READY",
        "WORKSPACE_PREBUILD_STATE_FAILED",
        "WORKSPACE_PREBUILD_STATE_SUPERSEDED"
      ],
      "title": "bee.v1.WorkspacePrebuildState",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWorkspacePrebuildsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListWorkspacePrebuilds.",
  "properties": {
    "configId": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.WorkspacePrebuildState"
    }
  },
  "title": "bee.v1.ListWorkspacePrebuildsRequest",
  "type": "object"
}
