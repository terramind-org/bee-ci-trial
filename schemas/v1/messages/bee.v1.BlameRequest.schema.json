{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Revision": {
      "description": "A revision expression: ref name, ref@version, changeset id or unique prefix.",
      "properties": {
        "expr": {
          "type": "string"
        }
      },
      "title": "bee.v1.Revision",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.BlameRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "at": {
      "$ref": "#/$defs/bee.v1.Revision"
    },
    "endLine": {
      "description": "inclusive; 0 = to the last line",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "ignoreRevs": {
      "description": "changesets to look through",
      "items": {
        "$ref": "#/$defs/bee.v1.ObjectId"
      },
      "type": "array"
    },
    "path": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "startLine": {
      "description": "1-based; 0 = from the first line",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "useIgnoreRevsFile": {
      "description": "also honor `.git-blame-ignore-revs` at `at`",
      "type": "boolean"
    }
  },
  "title": "bee.v1.BlameRequest",
  "type": "object"
}
