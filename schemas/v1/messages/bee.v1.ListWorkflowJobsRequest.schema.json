{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WorkflowJobAttemptFilter": {
      "description": "Which attempts ListWorkflowJobs returns.",
      "enum": [
        "WORKFLOW_JOB_ATTEMPT_FILTER_UNSPECIFIED",
        "WORKFLOW_JOB_ATTEMPT_FILTER_LATEST",
        "WORKFLOW_JOB_ATTEMPT_FILTER_ALL"
      ],
      "title": "bee.v1.WorkflowJobAttemptFilter",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWorkflowJobsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListWorkflowJobs.",
  "properties": {
    "attempt": {
      "description": "0 = use `filter`",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "filter": {
      "$ref": "#/$defs/bee.v1.WorkflowJobAttemptFilter"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "runId": {
      "type": "string"
    }
  },
  "title": "bee.v1.ListWorkflowJobsRequest",
  "type": "object"
}
