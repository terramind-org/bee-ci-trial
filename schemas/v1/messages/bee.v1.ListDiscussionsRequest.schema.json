{
  "$defs": {
    "bee.v1.DiscussionSort": {
      "description": "Sort order for discussion lists.",
      "enum": [
        "DISCUSSION_SORT_UNSPECIFIED",
        "DISCUSSION_SORT_LATEST_ACTIVITY",
        "DISCUSSION_SORT_CREATED",
        "DISCUSSION_SORT_TOP"
      ],
      "title": "bee.v1.DiscussionSort",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListDiscussionsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListDiscussions.",
  "properties": {
    "answered": {
      "description": "Q&A filter; unset = either",
      "type": "boolean"
    },
    "ascending": {
      "type": "boolean"
    },
    "author": {
      "type": "string"
    },
    "categoryId": {
      "description": "empty = all",
      "type": "string"
    },
    "closedOnly": {
      "type": "boolean"
    },
    "includeClosed": {
      "type": "boolean"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "org": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "query": {
      "description": "GitHub-compatible qualifiers, e.g. \"is:unanswered\"",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sort": {
      "$ref": "#/$defs/bee.v1.DiscussionSort"
    }
  },
  "title": "bee.v1.ListDiscussionsRequest",
  "type": "object"
}
