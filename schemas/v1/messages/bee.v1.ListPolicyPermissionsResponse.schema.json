{
  "$defs": {
    "bee.v1.PolicyPermission": {
      "description": "One entry in the permission catalog.",
      "properties": {
        "allowedInCustomRoles": {
          "type": "boolean"
        },
        "category": {
          "description": "e.g. \"code\", \"change_requests\", \"security\", \"admin\"",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "includedInRoles": {
          "description": "built-in roles that grant it",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PolicyRoleKind"
        },
        "name": {
          "description": "e.g. \"land\", \"force_push\", \"manage_rulesets\", \"redact\", \"bypass_push_protection\"",
          "type": "string"
        }
      },
      "title": "bee.v1.PolicyPermission",
      "type": "object"
    },
    "bee.v1.PolicyRoleKind": {
      "description": "Whether a role applies to repos or to an org.",
      "enum": [
        "POLICY_ROLE_KIND_UNSPECIFIED",
        "POLICY_ROLE_KIND_REPO",
        "POLICY_ROLE_KIND_ORG"
      ],
      "title": "bee.v1.PolicyRoleKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListPolicyPermissionsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListPolicyPermissions.",
  "properties": {
    "permissions": {
      "items": {
        "$ref": "#/$defs/bee.v1.PolicyPermission"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListPolicyPermissionsResponse",
  "type": "object"
}
