{
  "$defs": {
    "bee.v1.LandMethod": {
      "description": "How Land puts a stack onto a ref (PRODUCT §4.13 merge methods).",
      "enum": [
        "LAND_METHOD_UNSPECIFIED",
        "LAND_METHOD_REBASE",
        "LAND_METHOD_SQUASH",
        "LAND_METHOD_MERGE_COMMIT"
      ],
      "title": "bee.v1.LandMethod",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateRepoSettingsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "allowAutoMerge": {
      "type": "boolean"
    },
    "allowForking": {
      "type": "boolean"
    },
    "allowedLandMethods": {
      "items": {
        "$ref": "#/$defs/bee.v1.LandMethod"
      },
      "type": "array"
    },
    "autoRevert": {
      "type": "boolean"
    },
    "coldAfterDays": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "defaultLandMethod": {
      "$ref": "#/$defs/bee.v1.LandMethod"
    },
    "deleteWorkspaceRefOnLand": {
      "type": "boolean"
    },
    "draftRetentionDays": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "gitEnabled": {
      "type": "boolean"
    },
    "hasDiscussions": {
      "type": "boolean"
    },
    "hasIssues": {
      "type": "boolean"
    },
    "hasProjects": {
      "type": "boolean"
    },
    "hasWiki": {
      "type": "boolean"
    },
    "landAttemptBudget": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "mergeQueueCheckCombined": {
      "type": "boolean"
    },
    "mergeQueueRequired": {
      "type": "boolean"
    },
    "pushAutoChange": {
      "type": "boolean"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "setAllowedLandMethods": {
      "description": "replace allowed_land_methods only when true",
      "type": "boolean"
    },
    "squashMessageTemplate": {
      "type": "string"
    },
    "suggestUpdateBase": {
      "type": "boolean"
    },
    "webCommitSignoffRequired": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.UpdateRepoSettingsRequest",
  "type": "object"
}
