{
  "$defs": {
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateBillingEmailSettingsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateBillingEmailSettings. Unset fields are unchanged.",
  "properties": {
    "additionalEmails": {
      "description": "replaces when replace_additional_emails is set",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "primaryEmail": {
      "type": "string"
    },
    "replaceAdditionalEmails": {
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    },
    "sendReceipts": {
      "type": "boolean"
    },
    "sendUsageAlerts": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.UpdateBillingEmailSettingsRequest",
  "type": "object"
}
