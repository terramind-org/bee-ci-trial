{
  "$defs": {
    "bee.v1.AnomalySeverity": {
      "description": "How bad an anomaly is.",
      "enum": [
        "ANOMALY_SEVERITY_UNSPECIFIED",
        "ANOMALY_SEVERITY_INFO",
        "ANOMALY_SEVERITY_WARNING",
        "ANOMALY_SEVERITY_CRITICAL"
      ],
      "title": "bee.v1.AnomalySeverity",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.StreamWatcherAnomaliesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for StreamWatcherAnomalies.",
  "properties": {
    "afterSeq": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "minSeverity": {
      "$ref": "#/$defs/bee.v1.AnomalySeverity"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "watcherId": {
      "description": "empty = all watchers in the repo",
      "type": "string"
    }
  },
  "title": "bee.v1.StreamWatcherAnomaliesRequest",
  "type": "object"
}
