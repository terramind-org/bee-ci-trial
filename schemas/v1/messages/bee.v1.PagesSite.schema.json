{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PagesAccess": {
      "description": "Who can read a site.",
      "enum": [
        "PAGES_ACCESS_UNSPECIFIED",
        "PAGES_ACCESS_PUBLIC",
        "PAGES_ACCESS_PRIVATE"
      ],
      "title": "bee.v1.PagesAccess",
      "type": "string"
    },
    "bee.v1.PagesBuildType": {
      "description": "How a site's content is produced.",
      "enum": [
        "PAGES_BUILD_TYPE_UNSPECIFIED",
        "PAGES_BUILD_TYPE_REF",
        "PAGES_BUILD_TYPE_WORKFLOW"
      ],
      "title": "bee.v1.PagesBuildType",
      "type": "string"
    },
    "bee.v1.PagesCertificate": {
      "description": "The HTTPS certificate of a site's custom domain.",
      "properties": {
        "domains": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errorMessage": {
          "description": "with ERRORED",
          "type": "string"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "issuedAt": {
          "format": "date-time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.PagesCertificateState"
        }
      },
      "title": "bee.v1.PagesCertificate",
      "type": "object"
    },
    "bee.v1.PagesCertificateState": {
      "description": "ACME certificate state for a custom domain.",
      "enum": [
        "PAGES_CERTIFICATE_STATE_UNSPECIFIED",
        "PAGES_CERTIFICATE_STATE_NONE",
        "PAGES_CERTIFICATE_STATE_REQUESTED",
        "PAGES_CERTIFICATE_STATE_ISSUED",
        "PAGES_CERTIFICATE_STATE_EXPIRED",
        "PAGES_CERTIFICATE_STATE_ERRORED"
      ],
      "title": "bee.v1.PagesCertificateState",
      "type": "string"
    },
    "bee.v1.PagesSiteStatus": {
      "description": "Publication state of a site.",
      "enum": [
        "PAGES_SITE_STATUS_UNSPECIFIED",
        "PAGES_SITE_STATUS_NONE",
        "PAGES_SITE_STATUS_BUILDING",
        "PAGES_SITE_STATUS_BUILT",
        "PAGES_SITE_STATUS_ERRORED"
      ],
      "title": "bee.v1.PagesSiteStatus",
      "type": "string"
    },
    "bee.v1.PagesSource": {
      "description": "The ref and folder a REF-type site serves.",
      "properties": {
        "path": {
          "description": "\"/\" or \"/docs\"",
          "type": "string"
        },
        "ref": {
          "description": "e.g. \"main\" or \"gh-pages\"",
          "type": "string"
        }
      },
      "title": "bee.v1.PagesSource",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.PagesSite.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A repo's static site.",
  "properties": {
    "access": {
      "$ref": "#/$defs/bee.v1.PagesAccess"
    },
    "buildType": {
      "$ref": "#/$defs/bee.v1.PagesBuildType"
    },
    "certificate": {
      "$ref": "#/$defs/bee.v1.PagesCertificate"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "currentDeploymentId": {
      "type": "string"
    },
    "customDomain": {
      "type": "string"
    },
    "enforceHttps": {
      "type": "boolean"
    },
    "previewTtlDays": {
      "description": "days a preview lives",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "previewsEnabled": {
      "description": "per change request previews (REF sites)",
      "type": "boolean"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "servedTree": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "tree id currently served, for REF sites without a build step"
    },
    "source": {
      "$ref": "#/$defs/bee.v1.PagesSource",
      "description": "build type REF"
    },
    "status": {
      "$ref": "#/$defs/bee.v1.PagesSiteStatus"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "url": {
      "type": "string"
    }
  },
  "title": "bee.v1.PagesSite",
  "type": "object"
}
