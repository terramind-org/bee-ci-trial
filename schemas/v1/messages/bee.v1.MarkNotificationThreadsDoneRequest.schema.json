{
  "$defs": {
    "bee.v1.NotificationReason": {
      "description": "Why a notification was delivered.",
      "enum": [
        "NOTIFICATION_REASON_UNSPECIFIED",
        "NOTIFICATION_REASON_REVIEW_REQUESTED",
        "NOTIFICATION_REASON_MENTION",
        "NOTIFICATION_REASON_TEAM_MENTION",
        "NOTIFICATION_REASON_ASSIGN",
        "NOTIFICATION_REASON_AUTHOR",
        "NOTIFICATION_REASON_COMMENT",
        "NOTIFICATION_REASON_STATE_CHANGE",
        "NOTIFICATION_REASON_CI_ACTIVITY",
        "NOTIFICATION_REASON_SECURITY_ALERT",
        "NOTIFICATION_REASON_SUBSCRIBED",
        "NOTIFICATION_REASON_MANUAL",
        "NOTIFICATION_REASON_AGENT_RUN"
      ],
      "title": "bee.v1.NotificationReason",
      "type": "string"
    },
    "bee.v1.NotificationThreadFilter": {
      "description": "Filters for the inbox.",
      "properties": {
        "before": {
          "description": "updated strictly before",
          "format": "date-time",
          "type": "string"
        },
        "doneOnly": {
          "type": "boolean"
        },
        "includeDone": {
          "description": "default excludes done threads",
          "type": "boolean"
        },
        "org": {
          "type": "string"
        },
        "participatingOnly": {
          "description": "reasons other than SUBSCRIBED",
          "type": "boolean"
        },
        "reasons": {
          "description": "any of; empty = all",
          "items": {
            "$ref": "#/$defs/bee.v1.NotificationReason"
          },
          "type": "array"
        },
        "repos": {
          "description": "any of; empty = all",
          "items": {
            "$ref": "#/$defs/bee.v1.RepoRef"
          },
          "type": "array"
        },
        "savedOnly": {
          "type": "boolean"
        },
        "since": {
          "description": "updated at or after",
          "format": "date-time",
          "type": "string"
        },
        "subjectKinds": {
          "items": {
            "$ref": "#/$defs/bee.v1.SubjectKind"
          },
          "type": "array"
        },
        "unreadOnly": {
          "type": "boolean"
        }
      },
      "title": "bee.v1.NotificationThreadFilter",
      "type": "object"
    },
    "bee.v1.NotificationThreadSelector": {
      "description": "Names threads for a bulk inbox action: explicit ids, or every thread matching a filter and\nlast updated strictly before `before` (so activity after the call is not swept up).",
      "properties": {
        "before": {
          "description": "required with filter",
          "format": "date-time",
          "type": "string"
        },
        "filter": {
          "$ref": "#/$defs/bee.v1.NotificationThreadFilter",
          "description": "used when thread_ids is empty"
        },
        "threadIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.NotificationThreadSelector",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.MarkNotificationThreadsDoneRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for MarkNotificationThreadsDone.",
  "properties": {
    "selector": {
      "$ref": "#/$defs/bee.v1.NotificationThreadSelector"
    }
  },
  "title": "bee.v1.MarkNotificationThreadsDoneRequest",
  "type": "object"
}
