{
  "$defs": {
    "bee.v1.OpsBackup": {
      "description": "One backup.",
      "properties": {
        "cell": {
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "description": "\"metadata_snapshot\", \"metadata_wal\", \"blob_inventory\"",
          "type": "string"
        },
        "location": {
          "description": "storage location, no credentials",
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        }
      },
      "title": "bee.v1.OpsBackup",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListOpsBackupsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListOpsBackups.",
  "properties": {
    "backups": {
      "items": {
        "$ref": "#/$defs/bee.v1.OpsBackup"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListOpsBackupsResponse",
  "type": "object"
}
