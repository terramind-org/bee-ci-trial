{
  "$defs": {
    "bee.v1.CodeownersError": {
      "description": "One problem in a CODEOWNERS file.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        },
        "sourceLine": {
          "type": "string"
        },
        "subcode": {
          "description": "\"bad_pattern\", \"unknown_owner\", \"owner_without_write_access\", \"invalid_owner_syntax\",\n\"secret_team\"",
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        }
      },
      "title": "bee.v1.CodeownersError",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ValidateCodeownersResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ValidateCodeowners.",
  "properties": {
    "errors": {
      "items": {
        "$ref": "#/$defs/bee.v1.CodeownersError"
      },
      "type": "array"
    },
    "file": {
      "description": "which CODEOWNERS file was validated",
      "type": "string"
    },
    "valid": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.ValidateCodeownersResponse",
  "type": "object"
}
