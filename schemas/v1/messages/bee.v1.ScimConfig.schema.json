{
  "$defs": {
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ScimConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "SCIM provisioning settings for an org or enterprise.",
  "properties": {
    "activeTokenCount": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "endpointUrl": {
      "description": "SCIM 2.0 base URL served over HTTP, e.g. https://host/scim/v2/enterprises/acme",
      "type": "string"
    },
    "lastRequestAt": {
      "format": "date-time",
      "type": "string"
    },
    "provisionedCount": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "provisionsTeams": {
      "description": "SCIM Groups map to teams",
      "type": "boolean"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    }
  },
  "title": "bee.v1.ScimConfig",
  "type": "object"
}
