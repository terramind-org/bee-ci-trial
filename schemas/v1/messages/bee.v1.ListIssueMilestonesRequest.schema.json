{
  "$defs": {
    "bee.v1.MilestoneState": {
      "description": "Open or closed state of a milestone.",
      "enum": [
        "MILESTONE_STATE_UNSPECIFIED",
        "MILESTONE_STATE_OPEN",
        "MILESTONE_STATE_CLOSED"
      ],
      "title": "bee.v1.MilestoneState",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListIssueMilestonesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListIssueMilestones.",
  "properties": {
    "allStates": {
      "type": "boolean"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.MilestoneState",
      "description": "UNSPECIFIED = open"
    }
  },
  "title": "bee.v1.ListIssueMilestonesRequest",
  "type": "object"
}
