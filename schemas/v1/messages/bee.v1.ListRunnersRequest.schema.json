{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.RunnerScope": {
      "description": "Names the repo or org that owns runners.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/bee.v1.RunnerScopeKind"
        },
        "org": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.RunnerScope",
      "type": "object"
    },
    "bee.v1.RunnerScopeKind": {
      "description": "Whether a runner resource belongs to a repo or an org.",
      "enum": [
        "RUNNER_SCOPE_KIND_UNSPECIFIED",
        "RUNNER_SCOPE_KIND_REPO",
        "RUNNER_SCOPE_KIND_ORG"
      ],
      "title": "bee.v1.RunnerScopeKind",
      "type": "string"
    },
    "bee.v1.RunnerStatus": {
      "description": "Connection state of a runner.",
      "enum": [
        "RUNNER_STATUS_UNSPECIFIED",
        "RUNNER_STATUS_ONLINE",
        "RUNNER_STATUS_OFFLINE"
      ],
      "title": "bee.v1.RunnerStatus",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListRunnersRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListRunners.",
  "properties": {
    "label": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "runnerGroupId": {
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.RunnerScope"
    },
    "status": {
      "$ref": "#/$defs/bee.v1.RunnerStatus"
    }
  },
  "title": "bee.v1.ListRunnersRequest",
  "type": "object"
}
