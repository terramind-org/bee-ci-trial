{
  "$defs": {
    "bee.v1.CopyLocation": {
      "description": "A place where the same or similar content lives.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "firstSeen": {
          "$ref": "#/$defs/bee.v1.ObjectId",
          "description": "changeset that introduced it there"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "repoId": {
          "type": "string"
        },
        "similarity": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.CopyLocation",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.FindCopiesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "copies": {
      "items": {
        "$ref": "#/$defs/bee.v1.CopyLocation"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.FindCopiesResponse",
  "type": "object"
}
