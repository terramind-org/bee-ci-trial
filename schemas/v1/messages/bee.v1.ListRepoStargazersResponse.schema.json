{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.StarGazer": {
      "description": "A stargazer of a repo.",
      "properties": {
        "starredAt": {
          "format": "date-time",
          "type": "string"
        },
        "user": {
          "$ref": "#/$defs/bee.v1.UserSummary"
        }
      },
      "title": "bee.v1.StarGazer",
      "type": "object"
    },
    "bee.v1.UserSummary": {
      "description": "A short user reference for lists.",
      "properties": {
        "avatarUrl": {
          "type": "string"
        },
        "bio": {
          "type": "string"
        },
        "login": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal"
        }
      },
      "title": "bee.v1.UserSummary",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListRepoStargazersResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListRepoStargazers.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "stargazers": {
      "items": {
        "$ref": "#/$defs/bee.v1.StarGazer"
      },
      "type": "array"
    },
    "totalCount": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.ListRepoStargazersResponse",
  "type": "object"
}
