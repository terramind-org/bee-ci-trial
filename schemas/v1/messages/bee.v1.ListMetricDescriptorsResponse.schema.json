{
  "$defs": {
    "bee.v1.MetricDescriptor": {
      "description": "One fixed metric name.",
      "properties": {
        "help": {
          "type": "string"
        },
        "labelNames": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "e.g. \"bee_rpc_duration_seconds\"",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/bee.v1.MetricType"
        },
        "unit": {
          "type": "string"
        }
      },
      "title": "bee.v1.MetricDescriptor",
      "type": "object"
    },
    "bee.v1.MetricType": {
      "description": "Metric type.",
      "enum": [
        "METRIC_TYPE_UNSPECIFIED",
        "METRIC_TYPE_COUNTER",
        "METRIC_TYPE_GAUGE",
        "METRIC_TYPE_HISTOGRAM"
      ],
      "title": "bee.v1.MetricType",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListMetricDescriptorsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListMetricDescriptors.",
  "properties": {
    "descriptors": {
      "items": {
        "$ref": "#/$defs/bee.v1.MetricDescriptor"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListMetricDescriptorsResponse",
  "type": "object"
}
