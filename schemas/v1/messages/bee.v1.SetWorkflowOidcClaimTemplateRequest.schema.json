{
  "$defs": {
    "bee.v1.ActionsPolicyScope": {
      "description": "Names the org or repo an actions policy applies to.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/bee.v1.ActionsPolicyScopeKind"
        },
        "org": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.ActionsPolicyScope",
      "type": "object"
    },
    "bee.v1.ActionsPolicyScopeKind": {
      "description": "Whether a policy is read or written at org or repo level.",
      "enum": [
        "ACTIONS_POLICY_SCOPE_KIND_UNSPECIFIED",
        "ACTIONS_POLICY_SCOPE_KIND_ORG",
        "ACTIONS_POLICY_SCOPE_KIND_REPO"
      ],
      "title": "bee.v1.ActionsPolicyScopeKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SetWorkflowOidcClaimTemplateRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for SetWorkflowOidcClaimTemplate.",
  "properties": {
    "includeClaimKeys": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.ActionsPolicyScope"
    },
    "useDefault": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.SetWorkflowOidcClaimTemplateRequest",
  "type": "object"
}
