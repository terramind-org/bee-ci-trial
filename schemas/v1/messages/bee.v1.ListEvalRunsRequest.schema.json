{
  "$defs": {
    "bee.v1.EvalRunState": {
      "description": "Eval run lifecycle.",
      "enum": [
        "EVAL_RUN_STATE_UNSPECIFIED",
        "EVAL_RUN_STATE_QUEUED",
        "EVAL_RUN_STATE_RUNNING",
        "EVAL_RUN_STATE_SUCCEEDED",
        "EVAL_RUN_STATE_FAILED",
        "EVAL_RUN_STATE_CANCELLED"
      ],
      "title": "bee.v1.EvalRunState",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListEvalRunsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListEvalRuns.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "promptPath": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.EvalRunState"
    }
  },
  "title": "bee.v1.ListEvalRunsRequest",
  "type": "object"
}
