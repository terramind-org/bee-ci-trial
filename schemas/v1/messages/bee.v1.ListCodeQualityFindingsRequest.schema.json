{
  "$defs": {
    "bee.v1.CodeQualityFindingState": {
      "description": "State of a code quality finding.",
      "enum": [
        "CODE_QUALITY_FINDING_STATE_UNSPECIFIED",
        "CODE_QUALITY_FINDING_STATE_OPEN",
        "CODE_QUALITY_FINDING_STATE_DISMISSED",
        "CODE_QUALITY_FINDING_STATE_FIXED"
      ],
      "title": "bee.v1.CodeQualityFindingState",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListCodeQualityFindingsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListCodeQualityFindings.",
  "properties": {
    "category": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "pathPrefix": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.CodeQualityFindingState"
    }
  },
  "title": "bee.v1.ListCodeQualityFindingsRequest",
  "type": "object"
}
