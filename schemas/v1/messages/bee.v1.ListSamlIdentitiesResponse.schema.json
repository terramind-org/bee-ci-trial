{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.SamlIdentity": {
      "description": "A SAML identity linked to a principal.",
      "properties": {
        "email": {
          "type": "string"
        },
        "groups": {
          "description": "IdP group ids from the last assertion",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "lastSignInAt": {
          "format": "date-time",
          "type": "string"
        },
        "linkedAt": {
          "format": "date-time",
          "type": "string"
        },
        "nameId": {
          "type": "string"
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "scimProvisioned": {
          "type": "boolean"
        },
        "sessionExpiresAt": {
          "description": "unset when no live session",
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.SamlIdentity",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListSamlIdentitiesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListSamlIdentities.",
  "properties": {
    "identities": {
      "items": {
        "$ref": "#/$defs/bee.v1.SamlIdentity"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListSamlIdentitiesResponse",
  "type": "object"
}
