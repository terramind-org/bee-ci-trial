{
  "$defs": {
    "bee.v1.LanguageStat": {
      "description": "Bytes of one language.",
      "properties": {
        "byteCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "color": {
          "description": "six hex digits, no '#'",
          "type": "string"
        },
        "fileCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "e.g. \"Rust\"",
          "type": "string"
        },
        "percentage": {
          "description": "of counted bytes, 0..100",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/bee.v1.LanguageType"
        }
      },
      "title": "bee.v1.LanguageStat",
      "type": "object"
    },
    "bee.v1.LanguageType": {
      "description": "Linguist classification of a language.",
      "enum": [
        "LANGUAGE_TYPE_UNSPECIFIED",
        "LANGUAGE_TYPE_PROGRAMMING",
        "LANGUAGE_TYPE_MARKUP",
        "LANGUAGE_TYPE_DATA",
        "LANGUAGE_TYPE_PROSE"
      ],
      "title": "bee.v1.LanguageType",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetLanguageStatsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GetLanguageStats.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "languages": {
      "description": "largest first",
      "items": {
        "$ref": "#/$defs/bee.v1.LanguageStat"
      },
      "type": "array"
    },
    "totalBytes": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "tree": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "cache key"
    }
  },
  "title": "bee.v1.GetLanguageStatsResponse",
  "type": "object"
}
