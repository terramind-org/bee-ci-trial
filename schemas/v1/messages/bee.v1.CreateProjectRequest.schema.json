  "description": "Request for CreateProject.",
  "properties": {
    "linkRepos": {
      "items": {
        "$ref": "#/$defs/bee.v1.RepoRef"
      },
      "type": "array"
    },
    "owner": {
      "description": "org or user name or id",
      "type": "string"
    },
    "public": {
      "type": "boolean"
    },
    "readme": {
      "type": "string"
    },
    "shortDescription": {
      "type": "string"
    },
    "title": {
      "type": "string"
    }
  },
  "title": "bee.v1.CreateProjectRequest",
  "type": "object"
}
