{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListProjectsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListProjects.",
  "properties": {
    "includeClosed": {
      "type": "boolean"
    },
    "owner": {
      "description": "set owner or repo",
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "query": {
      "description": "title search plus qualifiers, e.g. \"is:open is:template\"",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "projects linked to this repo"
    },
    "templatesOnly": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.ListProjectsRequest",
  "type": "object"
}
