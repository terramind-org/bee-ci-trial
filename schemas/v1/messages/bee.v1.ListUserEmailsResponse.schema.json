        },
        "primary": {
          "type": "boolean"
        },
        "public": {
          "description": "shown on the profile",
          "type": "boolean"
        },
        "verified": {
          "type": "boolean"
        },
        "verifiedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.UserEmail",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListUserEmailsResponse.schema.json",
