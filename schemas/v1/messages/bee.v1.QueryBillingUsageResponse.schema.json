{
  "$defs": {
    "bee.v1.BillingProduct": {
      "description": "A metered product.",
      "enum": [
        "BILLING_PRODUCT_UNSPECIFIED",
        "BILLING_PRODUCT_ACTIONS_MINUTES",
        "BILLING_PRODUCT_STORAGE_GB",
        "BILLING_PRODUCT_WORKSPACES_HOURS",
        "BILLING_PRODUCT_AGENT_TOKENS",
        "BILLING_PRODUCT_PACKAGES_TRANSFER",
        "BILLING_PRODUCT_LFS",
        "BILLING_PRODUCT_SEATS",
        "BILLING_PRODUCT_MARKETPLACE"
      ],
      "title": "bee.v1.BillingProduct",
      "type": "string"
    },
    "bee.v1.BillingUsageLineItem": {
      "description": "One priced usage line. Fields of dimensions not grouped by are empty.",
      "properties": {
        "costCenterId": {
          "type": "string"
        },
        "date": {
          "description": "\"YYYY-MM-DD\" with DAY, \"YYYY-MM\" with MONTH",
          "type": "string"
        },
        "discountMicroUsd": {
          "description": "included usage and credits",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "grossMicroUsd": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "netMicroUsd": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "org": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "product": {
          "$ref": "#/$defs/bee.v1.BillingProduct"
        },
        "quantity": {
          "type": "number"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "sku": {
          "description": "e.g. \"actions_linux_4core\", \"agent_tokens_input\"",
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "unitPriceMicroUsd": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.BillingUsageLineItem",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.QueryBillingUsageResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for QueryBillingUsage.",
  "properties": {
    "dataCompleteUntil": {
      "description": "usage after this may still arrive",
      "format": "date-time",
      "type": "string"
    },
    "lineItems": {
      "items": {
        "$ref": "#/$defs/bee.v1.BillingUsageLineItem"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "totalGrossMicroUsd": {
      "description": "across all pages",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "totalNetMicroUsd": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.QueryBillingUsageResponse",
  "type": "object"
}
