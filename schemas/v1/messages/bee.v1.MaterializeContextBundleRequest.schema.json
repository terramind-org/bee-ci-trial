{
  "$defs": {
    "bee.v1.Revision": {
      "description": "A revision expression: ref name, ref@version, changeset id or unique prefix.",
      "properties": {
        "expr": {
          "type": "string"
        }
      },
      "title": "bee.v1.Revision",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.MaterializeContextBundleRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for MaterializeContextBundle.",
  "properties": {
    "id": {
      "type": "string"
    },
    "includeBodies": {
      "type": "boolean"
    },
    "maxFiles": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "revision": {
      "$ref": "#/$defs/bee.v1.Revision",
      "description": "unset = default branch tip"
    }
  },
  "title": "bee.v1.MaterializeContextBundleRequest",
  "type": "object"
}
