{
  "$defs": {
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WorkflowRequirement": {
      "description": "A workflow an org requires to run, and pass, on its repos' change requests.",
      "properties": {
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "enforced": {
          "description": "false = evaluate only",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "org": {
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/bee.v1.WorkflowRequirementScope"
        },
        "selectedRepos": {
          "items": {
            "$ref": "#/$defs/bee.v1.RepoRef"
          },
          "type": "array"
        },
        "sourcePath": {
          "type": "string"
        },
        "sourceRef": {
          "description": "empty = source repo's default ref",
          "type": "string"
        },
        "sourceRepo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowRequirement",
      "type": "object"
    },
    "bee.v1.WorkflowRequirementScope": {
      "description": "Which repos a required workflow applies to.",
      "enum": [
        "WORKFLOW_REQUIREMENT_SCOPE_UNSPECIFIED",
        "WORKFLOW_REQUIREMENT_SCOPE_ALL",
        "WORKFLOW_REQUIREMENT_SCOPE_SELECTED"
      ],
      "title": "bee.v1.WorkflowRequirementScope",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListRequiredWorkflowsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListRequiredWorkflows.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "workflows": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkflowRequirement"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListRequiredWorkflowsResponse",
  "type": "object"
}
