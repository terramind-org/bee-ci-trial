{
  "$defs": {
    "bee.v1.IssueRef": {
      "description": "Names an issue by id, or by repo and number. Used for cross-repo relations.",
      "properties": {
        "id": {
          "description": "alternative to repo + number",
          "type": "string"
        },
        "number": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.IssueRef",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.AddIssueSubIssueRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for AddIssueSubIssue.",
  "properties": {
    "afterId": {
      "description": "insert after this child id; empty = at the end",
      "type": "string"
    },
    "number": {
      "description": "the parent",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "replaceParent": {
      "description": "move from an existing parent",
      "type": "boolean"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "subIssue": {
      "$ref": "#/$defs/bee.v1.IssueRef"
    }
  },
  "title": "bee.v1.AddIssueSubIssueRequest",
  "type": "object"
}
