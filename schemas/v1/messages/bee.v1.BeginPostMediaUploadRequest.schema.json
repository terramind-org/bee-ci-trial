{
  "$defs": {
    "bee.v1.PostMediaKind": {
      "description": "Kind of a post's media.",
      "enum": [
        "POST_MEDIA_KIND_UNSPECIFIED",
        "POST_MEDIA_KIND_IMAGE",
        "POST_MEDIA_KIND_VIDEO"
      ],
      "title": "bee.v1.PostMediaKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.BeginPostMediaUploadRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for BeginPostMediaUpload.",
  "properties": {
    "changeId": {
      "description": "empty: for a post of its own (CreatePost)",
      "type": "string"
    },
    "contentType": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/bee.v1.PostMediaKind"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sizeBytes": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.BeginPostMediaUploadRequest",
  "type": "object"
}
