        },
        "replacement": {
          "description": "new content for start_line..end_line, without trailing newline",
          "type": "string"
        }
      },
      "title": "bee.v1.Suggestion",
      "type": "object"
    },
    "bee.v1.Verdict": {
      "enum": [
        "VERDICT_UNSPECIFIED",
        "VERDICT_APPROVE",
        "VERDICT_REQUEST_CHANGES",
        "VERDICT_COMMENT"
      ],
      "title": "bee.v1.Verdict",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListAgentActivityResponse.schema.json",
