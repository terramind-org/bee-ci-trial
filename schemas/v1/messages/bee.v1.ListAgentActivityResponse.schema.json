          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Ref",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Review": {
      "properties": {
        "body": {
          "type": "string"
        },
        "changeId": {
          "description": "change request id",
          "type": "string"
        },
        "comments": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReviewComment"
          },
          "type": "array"
        },
        "countsTowardPolicy": {
          "description": "e.g. false for agent approvals where policy says so",
          "type": "boolean"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "dismissReason": {
          "type": "string"
        },
        "dismissed": {
          "type": "boolean"
        },
        "dismissedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "id": {
          "type": "string"
        },
        "reviewer": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "revision": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stale": {
          "description": "made on an older revision and policy marks it stale",
          "type": "boolean"
        },
        "verdict": {
          "$ref": "#/$defs/bee.v1.Verdict"
        }
      },
      "title": "bee.v1.Review",
      "type": "object"
    },
    "bee.v1.ReviewComment": {
      "properties": {
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "body": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "fileLevel": {
          "description": "anchored to the file, not to lines",
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "inReplyTo": {
          "description": "comment id this replies to",
          "type": "string"
        },
        "minimizedReason": {
          "$ref": "#/$defs/bee.v1.MinimizedReason"
        },
        "outdated": {
          "description": "the anchored lines changed in a later revision",
          "type": "boolean"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReactionGroup"
          },
          "type": "array"
        },
        "revision": {
          "description": "revision the anchor was last valid on",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "side": {
          "description": "\"old\" | \"new\"",
          "type": "string"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "suggestion": {
          "$ref": "#/$defs/bee.v1.Suggestion",
          "description": "a suggested replacement for the anchored lines"
        },
        "threadId": {
          "type": "string"
        }
      },
      "title": "bee.v1.ReviewComment",
      "type": "object"
    },
    "bee.v1.ReviewRequest": {
      "description": "A pending review request for a principal or a team.",
      "properties": {
        "autoAssigned": {
          "type": "boolean"
        },
        "requestedAt": {
          "format": "date-time",
          "type": "string"
        },
        "requestedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "reviewer": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "set for principals"
        },
        "teamId": {
          "description": "set for teams",
          "type": "string"
        }
      },
      "title": "bee.v1.ReviewRequest",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    },
    "bee.v1.Suggestion": {
