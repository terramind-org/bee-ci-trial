{
  "$defs": {
    "bee.v1.AnnotationLevel": {
      "description": "Severity of a check annotation.",
      "enum": [
        "ANNOTATION_LEVEL_UNSPECIFIED",
        "ANNOTATION_LEVEL_NOTICE",
        "ANNOTATION_LEVEL_WARNING",
        "ANNOTATION_LEVEL_FAILURE"
      ],
      "title": "bee.v1.AnnotationLevel",
      "type": "string"
    },
    "bee.v1.AutoMerge": {
      "description": "Auto-merge settings on a CR.",
      "properties": {
        "commitMessage": {
          "type": "string"
        },
        "enabledAt": {
          "format": "date-time",
          "type": "string"
        },
        "enabledBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "method": {
          "$ref": "#/$defs/bee.v1.LandMethod"
        },
        "onBehalfOf": {
          "description": "Delegation chain the land is evaluated for (enabled_by first, the root last).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.AutoMerge",
      "type": "object"
    },
    "bee.v1.BriefAsk": {
      "description": "A decision the author asks a person to make. Answering posts a comment\n`Decision on \"<question>\": <option>` that agents read.",
      "properties": {
        "options": {
          "description": "2-6 options, each at most 80 characters",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "question": {
          "description": "at most 280 characters",
          "type": "string"
        }
      },
      "title": "bee.v1.BriefAsk",
      "type": "object"
    },
    "bee.v1.BriefHighlight": {
      "description": "One thing the change does, with the paths that do it.",
      "properties": {
        "paths": {
          "description": "repo paths (UTF-8), at most 20",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "description": "at most 280 characters",
          "type": "string"
        }
      },
      "title": "bee.v1.BriefHighlight",
      "type": "object"
    },
    "bee.v1.BriefRisk": {
      "description": "A risk the author sees, and what mitigates it.",
      "properties": {
        "mitigation": {
          "description": "at most 280 characters",
          "type": "string"
        },
        "text": {
          "description": "at most 280 characters",
          "type": "string"
        }
      },
      "title": "bee.v1.BriefRisk",
      "type": "object"
    },
    "bee.v1.ChangeBrief": {
      "description": "A change request's brief (SPEC §11.9): what a busy person reads first. Set through\nBriefService.SetChangeBrief or OpenChangeRequest.brief; fields 7-9 are set by the server.",
      "properties": {
        "asks": {
          "description": "decisions the author wants from a person, at most 20",
          "items": {
            "$ref": "#/$defs/bee.v1.BriefAsk"
          },
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "highlights": {
          "description": "at most 20",
          "items": {
            "$ref": "#/$defs/bee.v1.BriefHighlight"
          },
          "type": "array"
        },
        "outcome": {
          "description": "one line: what is different for users, at most 280 characters",
          "type": "string"
        },
        "risks": {
          "description": "at most 20",
          "items": {
            "$ref": "#/$defs/bee.v1.BriefRisk"
          },
          "type": "array"
        },
        "rollback": {
          "description": "how to undo it, in words",
          "type": "string"
        },
        "tryItUrl": {
          "description": "https URL where the change can be tried",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "writtenForRevision": {
          "description": "the current revision when the brief was set",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.ChangeBrief",
      "type": "object"
    },
    "bee.v1.ChangeId": {
      "description": "16-byte stable identity of a piece of work (SPEC §3.3).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ChangeId",
      "type": "object"
    },
    "bee.v1.ChangeRequest": {
      "properties": {
        "allowMaintainerEdits": {
          "description": "fork CRs: target-repo writers may push to head_ref",
          "type": "boolean"
        },
        "assignees": {
          "items": {
            "$ref": "#/$defs/bee.v1.Principal"
          },
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "autoMerge": {
          "$ref": "#/$defs/bee.v1.AutoMerge",
          "description": "set while auto-merge is enabled"
        },
        "body": {
          "type": "string"
        },
        "brief": {
          "$ref": "#/$defs/bee.v1.ChangeBrief",
          "description": "what it does, in words (SPEC §11.9); unset until written"
        },
        "changeIds": {
          "items": {
            "$ref": "#/$defs/bee.v1.ChangeId"
          },
          "type": "array"
        },
        "closeReason": {
          "type": "string"
        },
        "closedAt": {
          "format": "date-time",
          "type": "string"
        },
        "closingIssues": {
          "description": "The linked issues that close when the CR lands (closing keywords, plus manual links\nmade with close_on_land), sorted; a subset of linked_issues.",
          "items": {
            "format": "uint64",
            "pattern": "^[0-9]+$",
            "type": [
              "string",
              "integer"
            ]
          },
          "type": "array"
        },
        "commentCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "dependsOn": {
          "description": "parent CR id for stacked CRs",
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "headRef": {
          "description": "ref (in head_repo_id, else this repo) the CR was opened from",
          "type": "string"
        },
        "headRepoId": {
          "description": "fork the head comes from; empty = this repo",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inspiredBy": {
          "$ref": "#/$defs/bee.v1.PostRef",
          "description": "the post that inspired it; empty when its repo is unreadable"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/bee.v1.Label"
          },
          "type": "array"
        },
        "landedAt": {
          "format": "date-time",
          "type": "string"
        },
        "landedRef": {
          "$ref": "#/$defs/bee.v1.Ref",
          "description": "ref and version the CR landed at"
        },
        "linkedIssues": {
          "description": "issue numbers this CR implements",
          "items": {
            "format": "uint64",
            "pattern": "^[0-9]+$",
            "type": [
              "string",
              "integer"
            ]
          },
          "type": "array"
        },
        "locked": {
          "type": "boolean"
        },
        "mergeQueueEntry": {
          "$ref": "#/$defs/bee.v1.MergeQueueEntry",
          "description": "set while queued"
        },
        "milestone": {
          "$ref": "#/$defs/bee.v1.Milestone"
        },
        "number": {
          "description": "per-repo number shared with issues",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "post": {
          "$ref": "#/$defs/bee.v1.Post",
          "description": "the CR's post, read-only summary; unset when it has none"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReactionGroup"
          },
          "type": "array"
        },
        "repoId": {
          "type": "string"
        },
        "revertOf": {
          "description": "CR id this CR reverts",
          "type": "string"
        },
        "reviewRequests": {
          "items": {
            "$ref": "#/$defs/bee.v1.ReviewRequest"
          },
          "type": "array"
        },
        "revisions": {
          "items": {
            "$ref": "#/$defs/bee.v1.ChangeRevision"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.ChangeState"
        },
        "summary": {
          "description": "agent- or human-authored summary",
          "type": "string"
        },
        "summaryAuthor": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "targetRef": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.ChangeRequest",
      "type": "object"
    },
    "bee.v1.ChangeRevision": {
      "properties": {
        "base": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "diffClass": {
          "description": "highest-risk class in this revision",
          "type": "string"
        },
        "head": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "n": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pusher": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "who pushed this revision"
        }
      },
      "title": "bee.v1.ChangeRevision",
      "type": "object"
    },
    "bee.v1.ChangeState": {
      "enum": [
        "CHANGE_STATE_UNSPECIFIED",
        "CHANGE_STATE_OPEN",
        "CHANGE_STATE_LANDED",
        "CHANGE_STATE_CLOSED"
      ],
      "title": "bee.v1.ChangeState",
      "type": "string"
    },
    "bee.v1.CheckAction": {
      "description": "A button the reporter offers on a check run; pressing it sends a `check_run.requested_action` event.",
      "properties": {
        "description": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "title": "bee.v1.CheckAction",
      "type": "object"
    },
    "bee.v1.CheckAnnotation": {
      "description": "A finding attached to a line range of a file.",
      "properties": {
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "$ref": "#/$defs/bee.v1.AnnotationLevel"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "rawDetails": {
          "type": "string"
        },
        "startColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.CheckAnnotation",
      "type": "object"
    },
    "bee.v1.CheckImage": {
      "description": "An image shown in a check's output.",
      "properties": {
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        }
      },
      "title": "bee.v1.CheckImage",
      "type": "object"
    },
    "bee.v1.CheckOutput": {
      "description": "Rich output of a check run (Markdown).",
      "properties": {
        "annotations": {
          "description": "appended on each report, up to the limit",
          "items": {
            "$ref": "#/$defs/bee.v1.CheckAnnotation"
          },
          "type": "array"
        },
        "images": {
          "items": {
            "$ref": "#/$defs/bee.v1.CheckImage"
          },
          "type": "array"
        },
        "summary": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.CheckOutput",
      "type": "object"
    },
    "bee.v1.CheckRun": {
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/bee.v1.CheckAction"
          },
          "type": "array"
        },
        "annotationsCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "externalId": {
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/bee.v1.CheckOutput"
        },
        "postLand": {
          "type": "boolean"
        },
        "repoId": {
          "type": "string"
        },
        "reporter": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "app, workflow or agent that reported it"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/bee.v1.CheckStatus"
        },
        "suiteId": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "workflowJobId": {
          "description": "set when a Beehive workflow job produced it",
          "type": "string"
        }
      },
      "title": "bee.v1.CheckRun",
      "type": "object"
    },
    "bee.v1.CheckStatus": {
      "enum": [
        "CHECK_STATUS_UNSPECIFIED",
        "CHECK_STATUS_QUEUED",
        "CHECK_STATUS_RUNNING",
        "CHECK_STATUS_PASSED",
        "CHECK_STATUS_FAILED",
        "CHECK_STATUS_SKIPPED",
        "CHECK_STATUS_CANCELLED",
        "CHECK_STATUS_TIMED_OUT",
        "CHECK_STATUS_NEUTRAL",
        "CHECK_STATUS_ACTION_REQUIRED",
        "CHECK_STATUS_STALE"
      ],
      "title": "bee.v1.CheckStatus",
      "type": "string"
    },
    "bee.v1.Event": {
      "description": "Oneof `body`: at most one of `refUpdated`, `change`, `review`, `check`, `lease`, `policyEpoch`, `revokedToken`, `post` is set.",
      "properties": {
        "change": {
          "$ref": "#/$defs/bee.v1.ChangeRequest"
        },
        "check": {
          "$ref": "#/$defs/bee.v1.CheckRun"
        },
        "kind": {
          "description": "e.g. \"ref.updated\", \"lease.acquired\"",
          "type": "string"
        },
        "lease": {
          "$ref": "#/$defs/bee.v1.Lease"
        },
        "onBehalfOf": {
          "description": "delegation chain of `principal`",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "orgId": {
          "type": "string"
        },
        "payloadJson": {
          "type": "string"
        },
        "policyEpoch": {
          "type": "string"
        },
        "post": {
          "$ref": "#/$defs/bee.v1.Post",
          "description": "\"post.*\" events"
        },
        "principal": {
          "type": "string"
        },
        "refUpdated": {
          "$ref": "#/$defs/bee.v1.Ref"
        },
        "repoId": {
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/bee.v1.Review"
        },
        "revokedToken": {
          "type": "string"
        },
        "seq": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "subject": {
          "$ref": "#/$defs/bee.v1.SubjectRef",
          "description": "Every event names its subject. Events of areas without a typed body above (issues,\ndiscussions, workflows, releases, ...) carry the subject's resource as proto3-JSON in\n`payload_json`, for example kind \"issue.opened\" with a bee.v1.Issue."
        },
        "time": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.Event",
      "type": "object"
    },
    "bee.v1.Label": {
      "description": "A repo label shared by issues, change requests and discussions.",
      "properties": {
        "color": {
          "description": "six hex digits, no '#'",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "isDefault": {
          "description": "part of the repo's default label set",
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "title": "bee.v1.Label",
      "type": "object"
    },
    "bee.v1.LandMethod": {
      "description": "How Land puts a stack onto a ref (PRODUCT §4.13 merge methods).",
      "enum": [
        "LAND_METHOD_UNSPECIFIED",
        "LAND_METHOD_REBASE",
        "LAND_METHOD_SQUASH",
        "LAND_METHOD_MERGE_COMMIT"
      ],
      "title": "bee.v1.LandMethod",
      "type": "string"
    },
    "bee.v1.Lease": {
      "properties": {
        "changeId": {
          "$ref": "#/$defs/bee.v1.ChangeId"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "holder": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.LeaseMode"
        },
        "note": {
          "type": "string"
        },
        "paths": {
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        },
        "ref": {
          "type": "string"
        },
        "repoId": {
          "type": "string"
        }
      },
      "title": "bee.v1.Lease",
      "type": "object"
    },
    "bee.v1.LeaseMode": {
      "enum": [
        "LEASE_MODE_UNSPECIFIED",
        "LEASE_MODE_ADVISORY",
        "LEASE_MODE_EXCLUSIVE"
      ],
      "title": "bee.v1.LeaseMode",
      "type": "string"
    },
    "bee.v1.MergeQueueEntry": {
      "description": "One CR's place in a ref's merge queue.",
      "properties": {
        "changeNumber": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "changeRequestId": {
          "type": "string"
        },
        "ejectReason": {
          "description": "ErrorReason name when EJECTED",
          "type": "string"
        },
        "enqueuedAt": {
          "format": "date-time",
          "type": "string"
        },
        "enqueuedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "estimatedLandAt": {
          "format": "date-time",
          "type": "string"
        },
        "landMethod": {
          "$ref": "#/$defs/bee.v1.LandMethod",
          "description": "how the entry lands (UNSPECIFIED = the repo default)"
        },
        "onBehalfOf": {
          "description": "Delegation chain the land is evaluated for (enqueued_by first, the root last).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "position": {
          "description": "1 = next",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "priority": {
          "description": "higher jumps ahead within policy limits",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "ref": {
          "type": "string"
        },
        "speculativeHead": {
          "$ref": "#/$defs/bee.v1.ObjectId",
          "description": "the queued result being checked"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.MergeQueueState"
        },
        "title": {
          "description": "Title of the change request in the queue (gap G9).",
          "type": "string"
        }
      },
      "title": "bee.v1.MergeQueueEntry",
      "type": "object"
    },
    "bee.v1.MergeQueueState": {
      "description": "State of a CR in a merge queue.",
      "enum": [
        "MERGE_QUEUE_STATE_UNSPECIFIED",
        "MERGE_QUEUE_STATE_QUEUED",
        "MERGE_QUEUE_STATE_CHECKING",
        "MERGE_QUEUE_STATE_LANDING",
        "MERGE_QUEUE_STATE_LANDED",
        "MERGE_QUEUE_STATE_EJECTED"
      ],
      "title": "bee.v1.MergeQueueState",
      "type": "string"
    },
    "bee.v1.Milestone": {
      "description": "A repo milestone with progress.",
      "properties": {
        "closedAt": {
          "format": "date-time",
          "type": "string"
        },
        "closedItems": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "dueOn": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "number": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "openItems": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.MilestoneState"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.Milestone",
      "type": "object"
    },
    "bee.v1.MilestoneState": {
      "description": "Open or closed state of a milestone.",
      "enum": [
        "MILESTONE_STATE_UNSPECIFIED",
        "MILESTONE_STATE_OPEN",
        "MILESTONE_STATE_CLOSED"
      ],
      "title": "bee.v1.MilestoneState",
      "type": "string"
    },
    "bee.v1.MinimizedReason": {
      "description": "Why a comment is minimized (PRODUCT §4.21).",
      "enum": [
        "MINIMIZED_REASON_UNSPECIFIED",
        "MINIMIZED_REASON_SPAM",
        "MINIMIZED_REASON_ABUSE",
        "MINIMIZED_REASON_OFF_TOPIC",
        "MINIMIZED_REASON_OUTDATED",
        "MINIMIZED_REASON_DUPLICATE",
        "MINIMIZED_REASON_RESOLVED"
      ],
      "title": "bee.v1.MinimizedReason",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Post": {
      "description": "A post: on its own, or on a change request.",
      "properties": {
        "approvedBy": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "article": {
          "$ref": "#/$defs/bee.v1.PostArticle",
          "description": "unset when the post has no article"
        },
        "attachments": {
          "description": "What the post is about, in order. A post on a change request lists that change request\nfirst, whether or not it was written before attachments existed.",
          "items": {
            "$ref": "#/$defs/bee.v1.PostAttachment"
          },
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/bee.v1.Principal",
          "description": "the caller who last set the text; may be an agent"
        },
        "bodyMarkdown": {
          "description": "Markdown, at most 20000 characters; may be empty",
          "type": "string"
        },
        "changeId": {
          "description": "the change request carrying it; empty for a post of its own",
          "type": "string"
        },
        "changeNumber": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "changeTitle": {
          "type": "string"
        },
        "counts": {
          "$ref": "#/$defs/bee.v1.PostCounts"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "media": {
          "items": {
            "$ref": "#/$defs/bee.v1.PostMedia"
          },
          "type": "array"
        },
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.PostState"
        },
        "text": {
          "description": "the summary: NFC plain text, at most 500 characters",
          "type": "string"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "viewer": {
          "$ref": "#/$defs/bee.v1.PostViewer"
        },
        "withdrawnReason": {
          "type": "string"
        }
      },
      "title": "bee.v1.Post",
      "type": "object"
    },
    "bee.v1.PostArticle": {
      "description": "The long-form part of a post.",
      "properties": {
        "bodyMarkdown": {
          "description": "Markdown, at most 100000 characters, not empty",
          "type": "string"
        },
        "title": {
          "description": "NFC plain text on one line, 1-200 characters",
          "type": "string"
        }
      },
      "title": "bee.v1.PostArticle",
      "type": "object"
    },
    "bee.v1.PostAttachment": {
      "description": "Something in the post's repo that the post is about, with what a client needs to show it as\na card. A writer sets `kind` and `id` (or, for a change request or an issue, `number`); the\nserver checks it and fills the rest on every read from the attachment as it is now. When the\nattachment is gone (or a release went back to draft) only `kind` and `id` are set.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PostAttachmentKind"
        },
        "number": {
          "description": "change request and issue only",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "state": {
          "description": "The attachment's state in lower case: `open`, `landed` or `closed` for a change request,\n`open` or `closed` for an issue, `published` or `prerelease` for a release, and the\nAgentRunState name without its prefix (`running`, `succeeded`, ...) for an agent run.",
          "type": "string"
        },
        "tagName": {
          "description": "release only",
          "type": "string"
        },
        "title": {
          "description": "A release's name (else its tag); the first line of an agent run's prompt (else its agent's\nname).",
          "type": "string"
        }
      },
      "title": "bee.v1.PostAttachment",
      "type": "object"
    },
    "bee.v1.PostAttachmentKind": {
      "description": "What a post's attachment points at.",
      "enum": [
        "POST_ATTACHMENT_KIND_UNSPECIFIED",
        "POST_ATTACHMENT_KIND_CHANGE_REQUEST",
        "POST_ATTACHMENT_KIND_RELEASE",
        "POST_ATTACHMENT_KIND_ISSUE",
        "POST_ATTACHMENT_KIND_AGENT_RUN",
        "POST_ATTACHMENT_KIND_SWARM"
      ],
      "title": "bee.v1.PostAttachmentKind",
      "type": "string"
    },
    "bee.v1.PostCounts": {
      "description": "Engagement counts of a post.",
      "properties": {
        "adoptions": {
          "description": "adoptions in repos the caller can read",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "comments": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "likes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "reposts": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.PostCounts",
      "type": "object"
    },
    "bee.v1.PostMedia": {
      "description": "An image or video attached to a post.",
      "properties": {
        "altText": {
          "description": "required for images, optional for video",
          "type": "string"
        },
        "contentType": {
          "type": "string"
        },
        "durationMs": {
          "description": "video only",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PostMediaKind"
        },
        "sha256": {
          "description": "lowercase hex",
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "url": {
          "description": "signed download URL, filled on every read, never stored",
          "type": "string"
        },
        "width": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.PostMedia",
      "type": "object"
    },
    "bee.v1.PostMediaKind": {
      "description": "Kind of a post's media.",
      "enum": [
        "POST_MEDIA_KIND_UNSPECIFIED",
        "POST_MEDIA_KIND_IMAGE",
        "POST_MEDIA_KIND_VIDEO"
      ],
      "title": "bee.v1.PostMediaKind",
      "type": "string"
    },
    "bee.v1.PostRef": {
      "description": "A reference to a post, as carried by the issues and change requests it inspired. Empty when\nthe reader cannot read the post's repo.",
      "properties": {
        "changeNumber": {
          "description": "0 for a post of its own",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "changeTitle": {
          "description": "empty for a post of its own",
          "type": "string"
        },
        "postId": {
          "type": "string"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.PostRef",
      "type": "object"
    },
    "bee.v1.PostState": {
      "description": "Lifecycle of a post.",
      "enum": [
        "POST_STATE_UNSPECIFIED",
        "POST_STATE_DRAFT",
        "POST_STATE_PENDING_APPROVAL",
        "POST_STATE_PUBLISHED",
        "POST_STATE_WITHDRAWN",
        "POST_STATE_DISCARDED"
      ],
      "title": "bee.v1.PostState",
      "type": "string"
    },
    "bee.v1.PostViewer": {
      "description": "What the caller has done with a post and may do with it.",
      "properties": {
        "canApprove": {
          "type": "boolean"
        },
        "canEdit": {
          "type": "boolean"
        },
        "canWithdraw": {
          "type": "boolean"
        },
        "liked": {
          "type": "boolean"
        },
        "reposted": {
          "type": "boolean"
        }
      },
      "title": "bee.v1.PostViewer",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
