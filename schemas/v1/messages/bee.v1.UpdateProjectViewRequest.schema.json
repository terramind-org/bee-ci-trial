{
  "$defs": {
    "bee.v1.ProjectRoadmapZoom": {
      "description": "Time scale of a roadmap view.",
      "enum": [
        "PROJECT_ROADMAP_ZOOM_UNSPECIFIED",
        "PROJECT_ROADMAP_ZOOM_MONTH",
        "PROJECT_ROADMAP_ZOOM_QUARTER",
        "PROJECT_ROADMAP_ZOOM_YEAR"
      ],
      "title": "bee.v1.ProjectRoadmapZoom",
      "type": "string"
    },
    "bee.v1.ProjectViewLayout": {
      "description": "How a view lays out items.",
      "enum": [
        "PROJECT_VIEW_LAYOUT_UNSPECIFIED",
        "PROJECT_VIEW_LAYOUT_TABLE",
        "PROJECT_VIEW_LAYOUT_BOARD",
        "PROJECT_VIEW_LAYOUT_ROADMAP"
      ],
      "title": "bee.v1.ProjectViewLayout",
      "type": "string"
    },
    "bee.v1.ProjectViewSort": {
      "description": "One sort key of a view.",
      "properties": {
        "descending": {
          "type": "boolean"
        },
        "fieldId": {
          "type": "string"
        }
      },
      "title": "bee.v1.ProjectViewSort",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateProjectViewRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateProjectView. Repeated settings replace the current list only when their\n`set_*` flag is true.",
  "properties": {
    "columnFieldId": {
      "type": "string"
    },
    "expectedVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "filter": {
      "type": "string"
    },
    "groupByFieldIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "layout": {
      "$ref": "#/$defs/bee.v1.ProjectViewLayout",
      "description": "UNSPECIFIED = unchanged"
    },
    "name": {
      "type": "string"
    },
    "position": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "projectId": {
      "type": "string"
    },
    "roadmapZoom": {
      "$ref": "#/$defs/bee.v1.ProjectRoadmapZoom",
      "description": "UNSPECIFIED = unchanged"
    },
    "setGroupBy": {
      "type": "boolean"
    },
    "setSortBy": {
      "type": "boolean"
    },
    "setSumFields": {
      "type": "boolean"
    },
    "setVisibleFields": {
      "type": "boolean"
    },
    "sliceByFieldId": {
      "type": "string"
    },
    "sortBy": {
      "items": {
        "$ref": "#/$defs/bee.v1.ProjectViewSort"
      },
      "type": "array"
    },
    "startDateFieldId": {
      "type": "string"
    },
    "sumFieldIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "targetDateFieldId": {
      "type": "string"
    },
    "viewId": {
      "type": "string"
    },
    "visibleFieldIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.UpdateProjectViewRequest",
  "type": "object"
}
