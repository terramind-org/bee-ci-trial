{
  "$defs": {
    "bee.v1.OpsComponentStatus": {
      "description": "Status of a status page component.",
      "enum": [
        "OPS_COMPONENT_STATUS_UNSPECIFIED",
        "OPS_COMPONENT_STATUS_OPERATIONAL",
        "OPS_COMPONENT_STATUS_DEGRADED",
        "OPS_COMPONENT_STATUS_PARTIAL_OUTAGE",
        "OPS_COMPONENT_STATUS_MAJOR_OUTAGE",
        "OPS_COMPONENT_STATUS_MAINTENANCE"
      ],
      "title": "bee.v1.OpsComponentStatus",
      "type": "string"
    },
    "bee.v1.OpsStatusComponent": {
      "description": "A component shown on the status page.",
      "properties": {
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "description": "\"Git operations\", \"Change requests\", \"Webhooks\", ...",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/bee.v1.OpsComponentStatus"
        },
        "updatedAt": {
          "format": "date-time",
          "type": "string"
        }
      },
      "title": "bee.v1.OpsStatusComponent",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListOpsStatusComponentsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListOpsStatusComponents.",
  "properties": {
    "components": {
      "items": {
        "$ref": "#/$defs/bee.v1.OpsStatusComponent"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListOpsStatusComponentsResponse",
  "type": "object"
}
