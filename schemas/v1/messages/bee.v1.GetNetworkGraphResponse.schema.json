{
  "$defs": {
    "bee.v1.NetworkEdge": {
      "description": "A parent edge in the network graph.",
      "properties": {
        "child": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "parent": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        }
      },
      "title": "bee.v1.NetworkEdge",
      "type": "object"
    },
    "bee.v1.NetworkNode": {
      "description": "A changeset node in the network graph.",
      "properties": {
        "author": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "committedAt": {
          "format": "date-time",
          "type": "string"
        },
        "lane": {
          "description": "layout column hint",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "refs": {
          "description": "refs pointing at it",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef",
          "description": "the fork or repo it was seen in"
        },
        "repoFullName": {
          "type": "string"
        },
        "summary": {
          "description": "first line of the message",
          "type": "string"
        }
      },
      "title": "bee.v1.NetworkNode",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetNetworkGraphResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GetNetworkGraph.",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/bee.v1.NetworkEdge"
      },
      "type": "array"
    },
    "nodes": {
      "description": "newest first",
      "items": {
        "$ref": "#/$defs/bee.v1.NetworkNode"
      },
      "type": "array"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.GetNetworkGraphResponse",
  "type": "object"
}
