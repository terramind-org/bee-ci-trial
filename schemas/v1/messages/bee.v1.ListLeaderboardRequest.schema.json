        "TRENDING_WINDOW_WEEKLY",
        "TRENDING_WINDOW_MONTHLY"
      ],
      "title": "bee.v1.TrendingWindow",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListLeaderboardRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListLeaderboard.",
  "properties": {
    "metric": {
      "$ref": "#/$defs/bee.v1.LeaderboardMetric"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "subject": {
      "$ref": "#/$defs/bee.v1.LeaderboardSubject"
    },
    "window": {
      "$ref": "#/$defs/bee.v1.TrendingWindow"
    }
  },
  "title": "bee.v1.ListLeaderboardRequest",
  "type": "object"
