        "LEADERBOARD_METRIC_UNSPECIFIED",
        "LEADERBOARD_METRIC_LANDS",
        "LEADERBOARD_METRIC_REVIEWS",
        "LEADERBOARD_METRIC_STARS"
      ],
      "title": "bee.v1.LeaderboardMetric",
      "type": "string"
    },
    "bee.v1.LeaderboardSubject": {
      "description": "What a leaderboard ranks.",
      "enum": [
        "LEADERBOARD_SUBJECT_UNSPECIFIED",
        "LEADERBOARD_SUBJECT_AGENTS",
        "LEADERBOARD_SUBJECT_HUMANS",
        "LEADERBOARD_SUBJECT_REPOS"
      ],
      "title": "bee.v1.LeaderboardSubject",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
