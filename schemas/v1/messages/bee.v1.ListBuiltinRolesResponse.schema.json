{
  "$defs": {
    "bee.v1.PolicyBuiltinRole": {
      "description": "A built-in role.",
      "properties": {
        "description": {
          "type": "string"
        },
        "inherits": {
          "description": "the next weaker built-in role",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PolicyRoleKind"
        },
        "name": {
          "description": "e.g. \"read\", \"triage\", \"write\", \"maintain\", \"admin\", \"billing_manager\"",
          "type": "string"
        },
        "permissions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.PolicyBuiltinRole",
      "type": "object"
    },
    "bee.v1.PolicyRoleKind": {
      "description": "Whether a role applies to repos or to an org.",
      "enum": [
        "POLICY_ROLE_KIND_UNSPECIFIED",
        "POLICY_ROLE_KIND_REPO",
        "POLICY_ROLE_KIND_ORG"
      ],
      "title": "bee.v1.PolicyRoleKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListBuiltinRolesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListBuiltinRoles.",
  "properties": {
    "roles": {
      "items": {
        "$ref": "#/$defs/bee.v1.PolicyBuiltinRole"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListBuiltinRolesResponse",
  "type": "object"
}
