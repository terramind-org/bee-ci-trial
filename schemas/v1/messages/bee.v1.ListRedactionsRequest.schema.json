{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RedactionState": {
      "description": "Lifecycle of a redacted object (SPEC §13): live → quarantined → purged.",
      "enum": [
        "REDACTION_STATE_UNSPECIFIED",
        "REDACTION_STATE_QUARANTINED",
        "REDACTION_STATE_PURGED",
        "REDACTION_STATE_UNREDACTED"
      ],
      "title": "bee.v1.RedactionState",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListRedactionsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sinceEpoch": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "state": {
      "$ref": "#/$defs/bee.v1.RedactionState",
      "description": "UNSPECIFIED = all"
    }
  },
  "title": "bee.v1.ListRedactionsRequest",
  "type": "object"
}
