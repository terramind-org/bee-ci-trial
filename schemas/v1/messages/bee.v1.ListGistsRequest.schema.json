{
  "$defs": {
    "bee.v1.GistListFilter": {
      "description": "Which gists ListGists returns.",
      "enum": [
        "GIST_LIST_FILTER_UNSPECIFIED",
        "GIST_LIST_FILTER_MINE",
        "GIST_LIST_FILTER_USER",
        "GIST_LIST_FILTER_PUBLIC",
        "GIST_LIST_FILTER_STARRED"
      ],
      "title": "bee.v1.GistListFilter",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListGistsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListGists.",
  "properties": {
    "filter": {
      "$ref": "#/$defs/bee.v1.GistListFilter"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "since": {
      "description": "only gists updated at or after",
      "format": "date-time",
      "type": "string"
    },
    "user": {
      "description": "login, for USER",
      "type": "string"
    }
  },
  "title": "bee.v1.ListGistsRequest",
  "type": "object"
}
