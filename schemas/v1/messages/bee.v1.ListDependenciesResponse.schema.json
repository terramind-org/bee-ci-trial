{
  "$defs": {
    "bee.v1.Dependency": {
      "description": "One resolved package in the dependency graph.",
      "properties": {
        "dependencyUrls": {
          "description": "purls this package depends on",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ecosystem": {
          "description": "\"npm\", \"cargo\", \"pip\", \"maven\", \"go\", ...",
          "type": "string"
        },
        "licenses": {
          "description": "SPDX expressions",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "manifestPath": {
          "description": "manifest or lockfile that declared it",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "packageUrl": {
          "description": "purl, e.g. \"pkg:cargo/serde@1.0.200\"",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/bee.v1.DependencyRelationship"
        },
        "scope": {
          "$ref": "#/$defs/bee.v1.DependencyScope"
        },
        "submitted": {
          "description": "came from the submission API rather than manifest parsing",
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "title": "bee.v1.Dependency",
      "type": "object"
    },
    "bee.v1.DependencyRelationship": {
      "description": "Whether a dependency is declared directly or pulled in transitively.",
      "enum": [
        "DEPENDENCY_RELATIONSHIP_UNSPECIFIED",
        "DEPENDENCY_RELATIONSHIP_DIRECT",
        "DEPENDENCY_RELATIONSHIP_INDIRECT"
      ],
      "title": "bee.v1.DependencyRelationship",
      "type": "string"
    },
    "bee.v1.DependencyScope": {
      "description": "How a dependency is used.",
      "enum": [
        "DEPENDENCY_SCOPE_UNSPECIFIED",
        "DEPENDENCY_SCOPE_RUNTIME",
        "DEPENDENCY_SCOPE_DEVELOPMENT"
      ],
      "title": "bee.v1.DependencyScope",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListDependenciesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListDependencies.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "the resolved revision"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/bee.v1.Dependency"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListDependenciesResponse",
  "type": "object"
}
