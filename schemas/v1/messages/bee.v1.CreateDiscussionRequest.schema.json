{
  "$defs": {
    "bee.v1.KeyValue": {
      "description": "A key/value pair with a string value (metadata, custom properties, variables).",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "bee.v1.KeyValue",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateDiscussionRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateDiscussion.",
  "properties": {
    "body": {
      "type": "string"
    },
    "categoryId": {
      "description": "id or slug",
      "type": "string"
    },
    "formResponses": {
      "description": "discussion form field id -> answer",
      "items": {
        "$ref": "#/$defs/bee.v1.KeyValue"
      },
      "type": "array"
    },
    "labels": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "org": {
      "type": "string"
    },
    "pollOptions": {
      "description": "2 to 8 options",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "pollQuestion": {
      "description": "poll categories only",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "set repo or org"
    },
    "title": {
      "type": "string"
    }
  },
  "title": "bee.v1.CreateDiscussionRequest",
  "type": "object"
