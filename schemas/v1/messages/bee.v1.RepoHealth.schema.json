{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoHealthFile": {
      "description": "One file at or above the large-file threshold.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.RepoHealthFile",
      "type": "object"
    },
    "bee.v1.RepoHealthWarning": {
      "description": "A health finding, e.g. `large_file`, `near_push_limit`, `large_tree`, `many_refs`.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "description": "the file it concerns, if any",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoHealthWarning",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.RepoHealth.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "directories": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "files": {
      "description": "files (and symlinks) at the tip",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "hiddenPaths": {
      "description": "files under paths the caller cannot read (counted, not listed)",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "historyDepth": {
      "description": "first-parent changesets from the tip to the root",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "largeFileBytes": {
      "description": "the threshold used",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "largeFiles": {
      "description": "largest first, at most 100",
      "items": {
        "$ref": "#/$defs/bee.v1.RepoHealthFile"
      },
      "type": "array"
    },
    "largestFileBytes": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "ref": {
      "type": "string"
    },
    "refVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "refs": {
      "description": "live refs in the repo",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "tip": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "tipBytes": {
      "description": "sum of file sizes at the tip",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/bee.v1.RepoHealthWarning"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.RepoHealth",
  "type": "object"
}
