{
  "$defs": {
    "bee.v1.BillingPaymentMethodKind": {
      "description": "Kind of payment method on file.",
      "enum": [
        "BILLING_PAYMENT_METHOD_KIND_UNSPECIFIED",
        "BILLING_PAYMENT_METHOD_KIND_NONE",
        "BILLING_PAYMENT_METHOD_KIND_CARD",
        "BILLING_PAYMENT_METHOD_KIND_INVOICE"
      ],
      "title": "bee.v1.BillingPaymentMethodKind",
      "type": "string"
    },
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.BillingPaymentMethod.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Summary of the payment method on file; no card number or bank details.",
  "properties": {
    "billingName": {
      "type": "string"
    },
    "cardBrand": {
      "type": "string"
    },
    "cardExpMonth": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "cardExpYear": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "cardLast4": {
      "type": "string"
    },
    "country": {
      "description": "ISO 3166-1 alpha-2",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/bee.v1.BillingPaymentMethodKind"
    },
    "portalUrl": {
      "description": "where to change it",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.BillingPaymentMethod",
  "type": "object"
}
