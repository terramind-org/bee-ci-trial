{
  "$defs": {
    "bee.v1.InsightsWindow": {
      "description": "Time window for activity aggregates.",
      "enum": [
        "INSIGHTS_WINDOW_UNSPECIFIED",
        "INSIGHTS_WINDOW_DAY",
        "INSIGHTS_WINDOW_THREE_DAYS",
        "INSIGHTS_WINDOW_WEEK",
        "INSIGHTS_WINDOW_MONTH",
        "INSIGHTS_WINDOW_QUARTER",
        "INSIGHTS_WINDOW_YEAR"
      ],
      "title": "bee.v1.InsightsWindow",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetPulseRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GetPulse.",
  "properties": {
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "window": {
      "$ref": "#/$defs/bee.v1.InsightsWindow"
    }
  },
  "title": "bee.v1.GetPulseRequest",
  "type": "object"
}
