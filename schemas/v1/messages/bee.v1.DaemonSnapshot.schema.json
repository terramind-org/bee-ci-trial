{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.DaemonSnapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A verified, periodically refreshed snapshot of objects a daemon can start from.",
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "digest": {
      "contentEncoding": "base64",
      "description": "BLAKE3 over the snapshot file; verify before use",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "redactionEpoch": {
      "description": "objects redacted after this epoch must be dropped on load",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "ref": {
      "type": "string"
    },
    "refVersion": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "rootChangeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "signedUrl": {
      "type": "string"
    },
    "signedUrlExpiresUnix": {
      "format": "int64",
      "pattern": "^-?[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "sizeBytes": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.DaemonSnapshot",
  "type": "object"
}
