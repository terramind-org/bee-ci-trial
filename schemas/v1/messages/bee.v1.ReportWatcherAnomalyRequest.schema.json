{
  "$defs": {
    "bee.v1.AnomalyEvidence": {
      "description": "One piece of evidence behind an anomaly.",
      "properties": {
        "baseline": {
          "type": "number"
        },
        "kind": {
          "description": "\"metric\", \"log\", \"trace\", \"changeset\"",
          "type": "string"
        },
        "labels": {
          "items": {
            "$ref": "#/$defs/bee.v1.KeyValue"
          },
          "type": "array"
        },
        "logQuery": {
          "type": "string"
        },
        "metricName": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "observed": {
          "type": "number"
        },
        "suspectChangeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "traceId": {
          "type": "string"
        }
      },
      "title": "bee.v1.AnomalyEvidence",
      "type": "object"
    },
    "bee.v1.AnomalySeverity": {
      "description": "How bad an anomaly is.",
      "enum": [
        "ANOMALY_SEVERITY_UNSPECIFIED",
        "ANOMALY_SEVERITY_INFO",
        "ANOMALY_SEVERITY_WARNING",
        "ANOMALY_SEVERITY_CRITICAL"
      ],
      "title": "bee.v1.AnomalySeverity",
      "type": "string"
    },
    "bee.v1.KeyValue": {
      "description": "A key/value pair with a string value (metadata, custom properties, variables).",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "title": "bee.v1.KeyValue",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ReportWatcherAnomalyRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ReportWatcherAnomaly.",
  "properties": {
    "description": {
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/bee.v1.AnomalyEvidence"
      },
      "type": "array"
    },
    "fingerprint": {
      "description": "an open anomaly with the same fingerprint is updated instead",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "severity": {
      "$ref": "#/$defs/bee.v1.AnomalySeverity"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "watcherId": {
      "type": "string"
    }
  },
  "title": "bee.v1.ReportWatcherAnomalyRequest",
  "type": "object"
}
