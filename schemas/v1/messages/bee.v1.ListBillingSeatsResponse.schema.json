{
  "$defs": {
    "bee.v1.BillingSeat": {
      "description": "A principal consuming a paid seat.",
      "properties": {
        "consumedSince": {
          "format": "date-time",
          "type": "string"
        },
        "costCenterId": {
          "type": "string"
        },
        "lastActivityAt": {
          "format": "date-time",
          "type": "string"
        },
        "org": {
          "description": "org through which the seat is consumed",
          "type": "string"
        },
        "outsideCollaborator": {
          "type": "boolean"
        },
        "principal": {
          "$ref": "#/$defs/bee.v1.Principal"
        }
      },
      "title": "bee.v1.BillingSeat",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListBillingSeatsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListBillingSeats.",
  "properties": {
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    },
    "seats": {
      "items": {
        "$ref": "#/$defs/bee.v1.BillingSeat"
      },
      "type": "array"
    },
    "totalConsumed": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.ListBillingSeatsResponse",
  "type": "object"
}
