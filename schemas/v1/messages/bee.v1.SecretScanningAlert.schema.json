{
  "$defs": {
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SecretScanningAlertState": {
      "description": "State of a secret scanning alert.",
      "enum": [
        "SECRET_SCANNING_ALERT_STATE_UNSPECIFIED",
        "SECRET_SCANNING_ALERT_STATE_OPEN",
        "SECRET_SCANNING_ALERT_STATE_RESOLVED"
      ],
      "title": "bee.v1.SecretScanningAlertState",
      "type": "string"
    },
    "bee.v1.SecretScanningResolution": {
      "description": "Why a secret scanning alert was resolved.",
      "enum": [
        "SECRET_SCANNING_RESOLUTION_UNSPECIFIED",
        "SECRET_SCANNING_RESOLUTION_FALSE_POSITIVE",
        "SECRET_SCANNING_RESOLUTION_WONT_FIX",
        "SECRET_SCANNING_RESOLUTION_REVOKED",
        "SECRET_SCANNING_RESOLUTION_USED_IN_TESTS",
        "SECRET_SCANNING_RESOLUTION_PATTERN_DELETED",
        "SECRET_SCANNING_RESOLUTION_PATTERN_EDITED"
      ],
      "title": "bee.v1.SecretScanningResolution",
      "type": "string"
    },
    "bee.v1.SecretScanningValidity": {
      "description": "Result of a partner validity check.",
      "enum": [
        "SECRET_SCANNING_VALIDITY_UNSPECIFIED",
        "SECRET_SCANNING_VALIDITY_ACTIVE",
        "SECRET_SCANNING_VALIDITY_INACTIVE",
        "SECRET_SCANNING_VALIDITY_UNKNOWN"
      ],
      "title": "bee.v1.SecretScanningValidity",
      "type": "string"
    },
    "bee.v1.SecuritySeverity": {
      "description": "Severity used by advisories, alerts and findings.",
      "enum": [
        "SECURITY_SEVERITY_UNSPECIFIED",
        "SECURITY_SEVERITY_LOW",
        "SECURITY_SEVERITY_MEDIUM",
        "SECURITY_SEVERITY_HIGH",
        "SECURITY_SEVERITY_CRITICAL"
      ],
      "title": "bee.v1.SecuritySeverity",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SecretScanningAlert.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A secret found in repo content.",
  "properties": {
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "number": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "patternId": {
      "description": "custom pattern id, when a custom pattern matched",
      "type": "string"
    },
    "publiclyLeaked": {
      "type": "boolean"
    },
    "pushProtectionBypassId": {
      "type": "string"
    },
    "pushProtectionBypassed": {
      "type": "boolean"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "resolution": {
      "$ref": "#/$defs/bee.v1.SecretScanningResolution"
    },
    "resolutionComment": {
      "type": "string"
    },
    "resolvedAt": {
      "format": "date-time",
      "type": "string"
    },
    "resolvedBy": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "secretPreview": {
      "description": "redacted, e.g. \"AKIA****WXYZ\"; never the value",
      "type": "string"
    },
    "secretType": {
      "description": "e.g. \"aws_access_key_id\"",
      "type": "string"
    },
    "secretTypeDisplayName": {
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/bee.v1.SecuritySeverity",
      "description": "Severity of the leaked secret (gap G11)."
    },
    "state": {
      "$ref": "#/$defs/bee.v1.SecretScanningAlertState"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "validity": {
      "$ref": "#/$defs/bee.v1.SecretScanningValidity"
    }
  },
  "title": "bee.v1.SecretScanningAlert",
  "type": "object"
}
