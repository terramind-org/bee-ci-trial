{
  "$defs": {
    "bee.v1.GistFileChange": {
      "description": "One file change in UpdateGist: edit content, rename, or delete.",
      "properties": {
        "content": {
          "description": "new content; unset keeps it",
          "type": "string"
        },
        "delete": {
          "type": "boolean"
        },
        "filename": {
          "description": "existing or new file name",
          "type": "string"
        },
        "newFilename": {
          "description": "rename",
          "type": "string"
        }
      },
      "title": "bee.v1.GistFileChange",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateGistRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateGist.",
  "properties": {
    "commentsLocked": {
      "type": "boolean"
    },
    "description": {
      "type": "string"
    },
    "expectedHead": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "unset = any"
    },
    "fileChanges": {
      "items": {
        "$ref": "#/$defs/bee.v1.GistFileChange"
      },
      "type": "array"
    },
    "gistId": {
      "type": "string"
    }
  },
  "title": "bee.v1.UpdateGistRequest",
  "type": "object"
}
