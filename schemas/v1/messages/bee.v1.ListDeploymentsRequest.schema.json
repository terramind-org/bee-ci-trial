{
  "$defs": {
    "bee.v1.DeploymentState": {
      "description": "The state carried by a deployment status (GitHub-compatible set).",
      "enum": [
        "DEPLOYMENT_STATE_UNSPECIFIED",
        "DEPLOYMENT_STATE_PENDING",
        "DEPLOYMENT_STATE_QUEUED",
        "DEPLOYMENT_STATE_IN_PROGRESS",
        "DEPLOYMENT_STATE_SUCCESS",
        "DEPLOYMENT_STATE_FAILURE",
        "DEPLOYMENT_STATE_ERROR",
        "DEPLOYMENT_STATE_INACTIVE"
      ],
      "title": "bee.v1.DeploymentState",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListDeploymentsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListDeployments.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "creatorId": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.DeploymentState",
      "description": "filter by latest state; UNSPECIFIED = any"
    },
    "task": {
      "type": "string"
    }
  },
  "title": "bee.v1.ListDeploymentsRequest",
  "type": "object"
}
