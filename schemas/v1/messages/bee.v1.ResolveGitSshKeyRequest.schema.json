{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ResolveGitSshKeyRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ResolveGitSshKey.",
  "properties": {
    "command": {
      "description": "\"git-upload-pack\" or \"git-receive-pack\"",
      "type": "string"
    },
    "fingerprint": {
      "description": "\"SHA256:...\", alternative to the blob",
      "type": "string"
    },
    "keyType": {
      "description": "e.g. \"ssh-ed25519\"",
      "type": "string"
    },
    "publicKey": {
      "contentEncoding": "base64",
      "description": "the key blob as presented",
      "type": "string"
    },
    "remoteIp": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "the repo the SSH command names"
    }
  },
  "title": "bee.v1.ResolveGitSshKeyRequest",
  "type": "object"
}
