{
  "$defs": {
    "bee.v1.CodeownersPathOwners": {
      "description": "The owners of one path.",
      "properties": {
        "owners": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/bee.v1.CodeownersRule",
          "description": "unset when the path has no owner"
        }
      },
      "title": "bee.v1.CodeownersPathOwners",
      "type": "object"
    },
    "bee.v1.CodeownersRule": {
      "description": "The CODEOWNERS or policy-owners rule that matched a path.",
      "properties": {
        "file": {
          "description": "\"CODEOWNERS\", \".bee/CODEOWNERS\" or \".bee/policy.toml\"",
          "type": "string"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "owners": {
          "description": "principals, \"@org/team\" groups or emails",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "pattern": {
          "type": "string"
        },
        "section": {
          "description": "optional section name",
          "type": "string"
        }
      },
      "title": "bee.v1.CodeownersRule",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetCodeownersResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GetCodeowners.",
  "properties": {
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "the revision resolved"
    },
    "errorCount": {
      "description": "see ValidateCodeowners for details",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "paths": {
      "items": {
        "$ref": "#/$defs/bee.v1.CodeownersPathOwners"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.GetCodeownersResponse",
  "type": "object"
}
