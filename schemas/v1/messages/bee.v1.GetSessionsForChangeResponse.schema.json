{
  "$defs": {
    "bee.v1.AgentSession": {
      "description": "An agent session: one run's provenance.",
      "properties": {
        "agentPrincipalId": {
          "type": "string"
        },
        "chain": {
          "description": "delegation chain, agent first, root last",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "changeRequestIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "changesets": {
          "items": {
            "$ref": "#/$defs/bee.v1.ObjectId"
          },
          "type": "array"
        },
        "cost": {
          "$ref": "#/$defs/bee.v1.Cost"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "promptDigest": {
          "contentEncoding": "base64",
          "description": "BLAKE3 of the prompt the runner received",
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "session": {
          "type": "string"
        }
      },
      "title": "bee.v1.AgentSession",
      "type": "object"
    },
    "bee.v1.Cost": {
      "properties": {
        "inputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "outputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Cost",
      "type": "object"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetSessionsForChangeResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GetSessionsForChange.",
  "properties": {
    "sessions": {
      "items": {
        "$ref": "#/$defs/bee.v1.AgentSession"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.GetSessionsForChangeResponse",
  "type": "object"
}
