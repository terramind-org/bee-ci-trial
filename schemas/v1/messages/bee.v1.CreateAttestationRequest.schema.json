{
  "$defs": {
    "bee.v1.AttestationSubject": {
      "description": "An artifact an attestation is about.",
      "properties": {
        "digest": {
          "description": "\"sha256:<hex>\"",
          "type": "string"
        },
        "name": {
          "description": "e.g. image reference or file name",
          "type": "string"
        }
      },
      "title": "bee.v1.AttestationSubject",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateAttestationRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateAttestation.",
  "properties": {
    "jobId": {
      "type": "string"
    },
    "predicateJson": {
      "description": "JSON; empty with SLSA type = server-generated build provenance",
      "type": "string"
    },
    "predicateType": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "subjects": {
      "items": {
        "$ref": "#/$defs/bee.v1.AttestationSubject"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.CreateAttestationRequest",
  "type": "object"
}
