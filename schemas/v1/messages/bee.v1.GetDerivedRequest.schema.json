{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetDerivedRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "deriveIfMissing": {
      "description": "lazily derive (SPEC §8); false returns NOT_FOUND when absent",
      "type": "boolean"
    },
    "key": {
      "$ref": "#/$defs/bee.v1.ObjectId",
      "description": "changeset or object id the value is keyed by"
    },
    "path": {
      "contentEncoding": "base64",
      "description": "for per-path types",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "type": {
      "description": "derived type name, e.g. \"blame\", \"diff_class\", \"language_stats\"",
      "type": "string"
    },
    "version": {
      "description": "0 = the current version",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.GetDerivedRequest",
  "type": "object"
}
