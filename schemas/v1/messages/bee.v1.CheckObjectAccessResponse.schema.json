{
  "$defs": {
    "bee.v1.AccessClass": {
      "description": "Whether an object is readable by every repo reader or only by principals allowed on a\nrestricted path (SPEC §9.3, §10.2).",
      "enum": [
        "ACCESS_CLASS_UNSPECIFIED",
        "ACCESS_CLASS_ROOT",
        "ACCESS_CLASS_RESTRICTED"
      ],
      "title": "bee.v1.AccessClass",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CheckObjectAccessResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "accessClasses": {
      "items": {
        "$ref": "#/$defs/bee.v1.AccessClass"
      },
      "type": "array"
    },
    "allowed": {
      "items": {
        "type": "boolean"
      },
      "type": "array"
    },
    "cacheTtlSeconds": {
      "description": "how long the cache may reuse these decisions",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "policyEpoch": {
      "type": "string"
    },
    "principalId": {
      "description": "subject the token resolved to",
      "type": "string"
    },
    "redactionEpoch": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    }
  },
  "title": "bee.v1.CheckObjectAccessResponse",
  "type": "object"
}
