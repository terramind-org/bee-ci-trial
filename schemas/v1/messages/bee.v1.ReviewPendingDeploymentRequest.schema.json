{
  "$defs": {
    "bee.v1.DeploymentReviewDecision": {
      "description": "A reviewer's or rule's decision on a gated deployment.",
      "enum": [
        "DEPLOYMENT_REVIEW_DECISION_UNSPECIFIED",
        "DEPLOYMENT_REVIEW_DECISION_APPROVED",
        "DEPLOYMENT_REVIEW_DECISION_REJECTED"
      ],
      "title": "bee.v1.DeploymentReviewDecision",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ReviewPendingDeploymentRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ReviewPendingDeployment.",
  "properties": {
    "comment": {
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/bee.v1.DeploymentReviewDecision"
    },
    "deploymentId": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.ReviewPendingDeploymentRequest",
  "type": "object"
}
