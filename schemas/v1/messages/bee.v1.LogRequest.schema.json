{
  "$defs": {
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Revision": {
      "description": "A revision expression: ref name, ref@version, changeset id or unique prefix.",
      "properties": {
        "expr": {
          "type": "string"
        }
      },
      "title": "bee.v1.Revision",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.LogRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "author": {
      "description": "principal id or author name substring",
      "type": "string"
    },
    "firstParent": {
      "type": "boolean"
    },
    "followRenames": {
      "description": "keep following a path across renames and re-adds",
      "type": "boolean"
    },
    "from": {
      "$ref": "#/$defs/bee.v1.Revision"
    },
    "includeMeta": {
      "type": "boolean"
    },
    "minVersion": {
      "description": "read-your-writes (SPEC §6.3)",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "path": {
      "contentEncoding": "base64",
      "description": "optional path filter",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "since": {
      "description": "committer time lower bound",
      "format": "date-time",
      "type": "string"
    },
    "until": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.LogRequest",
  "type": "object"
}
