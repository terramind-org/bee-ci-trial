{
  "$defs": {
    "bee.v1.NotificationReminderChannel": {
      "description": "Delivery channel for a scheduled reminder.",
      "enum": [
        "NOTIFICATION_REMINDER_CHANNEL_UNSPECIFIED",
        "NOTIFICATION_REMINDER_CHANNEL_SLACK",
        "NOTIFICATION_REMINDER_CHANNEL_TEAMS",
        "NOTIFICATION_REMINDER_CHANNEL_EMAIL"
      ],
      "title": "bee.v1.NotificationReminderChannel",
      "type": "string"
    },
    "bee.v1.NotificationReminderDay": {
      "description": "Day of the week for reminder schedules.",
      "enum": [
        "NOTIFICATION_REMINDER_DAY_UNSPECIFIED",
        "NOTIFICATION_REMINDER_DAY_MONDAY",
        "NOTIFICATION_REMINDER_DAY_TUESDAY",
        "NOTIFICATION_REMINDER_DAY_WEDNESDAY",
        "NOTIFICATION_REMINDER_DAY_THURSDAY",
        "NOTIFICATION_REMINDER_DAY_FRIDAY",
        "NOTIFICATION_REMINDER_DAY_SATURDAY",
        "NOTIFICATION_REMINDER_DAY_SUNDAY"
      ],
      "title": "bee.v1.NotificationReminderDay",
      "type": "string"
    },
    "bee.v1.NotificationReminderFilter": {
      "description": "Which review requests a reminder reports.",
      "properties": {
        "ignoreApproved": {
          "description": "skip change requests with enough approvals",
          "type": "boolean"
        },
        "ignoreDrafts": {
          "type": "boolean"
        },
        "ignoreLabels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "includeAssignedIssues": {
          "type": "boolean"
        },
        "includeMentions": {
          "type": "boolean"
        },
        "includeTeamRequests": {
          "type": "boolean"
        },
        "minAgeHours": {
          "description": "only requests waiting at least this long",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "repos": {
          "description": "empty = all repos in scope",
          "items": {
            "$ref": "#/$defs/bee.v1.RepoRef"
          },
          "type": "array"
        },
        "requireLabels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.NotificationReminderFilter",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.NotificationReminder.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A scheduled digest of pending review requests sent to a chat channel or email.",
  "properties": {
    "channel": {
      "$ref": "#/$defs/bee.v1.NotificationReminderChannel"
    },
    "channelTarget": {
      "description": "Slack/Teams channel id, or email address",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "days": {
      "items": {
        "$ref": "#/$defs/bee.v1.NotificationReminderDay"
      },
      "type": "array"
    },
    "enabled": {
      "type": "boolean"
    },
    "filter": {
      "$ref": "#/$defs/bee.v1.NotificationReminderFilter"
    },
    "id": {
      "type": "string"
    },
    "lastSentAt": {
      "format": "date-time",
      "type": "string"
    },
    "org": {
      "description": "set for team reminders",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "realTimeAlerts": {
      "description": "also post immediately on new review requests",
      "type": "boolean"
    },
    "teamId": {
      "description": "team reminders only",
      "type": "string"
    },
    "timeZone": {
      "description": "IANA name, e.g. \"Europe/Berlin\"",
      "type": "string"
    },
    "times": {
      "description": "\"HH:MM\" local times",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.NotificationReminder",
  "type": "object"
}
