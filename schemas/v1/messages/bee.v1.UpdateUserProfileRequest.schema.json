{
  "$defs": {
    "bee.v1.UserSocialAccount": {
      "description": "A linked social account on a profile.",
      "properties": {
        "provider": {
          "description": "e.g. \"mastodon\", \"linkedin\", \"x\", \"bluesky\", \"generic\"",
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "title": "bee.v1.UserSocialAccount",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateUserProfileRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateUserProfile.",
  "properties": {
    "bio": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "hireable": {
      "type": "boolean"
    },
    "location": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "pronouns": {
      "type": "string"
    },
    "publicEmail": {
      "description": "must be verified; empty hides it",
      "type": "string"
    },
    "replaceSocialAccounts": {
      "type": "boolean"
    },
    "socialAccounts": {
      "description": "replaces all when replace_social_accounts",
      "items": {
        "$ref": "#/$defs/bee.v1.UserSocialAccount"
      },
      "type": "array"
    },
    "website": {
      "type": "string"
    }
  },
  "title": "bee.v1.UpdateUserProfileRequest",
  "type": "object"
}
