{
  "$defs": {
    "bee.v1.HealthStatus": {
      "description": "Health of one component.",
      "enum": [
        "HEALTH_STATUS_UNSPECIFIED",
        "HEALTH_STATUS_OK",
        "HEALTH_STATUS_DEGRADED",
        "HEALTH_STATUS_DOWN"
      ],
      "title": "bee.v1.HealthStatus",
      "type": "string"
    },
    "bee.v1.OpsCell": {
      "description": "One cell's status.",
      "properties": {
        "configVersion": {
          "type": "string"
        },
        "metadataPrimaryUp": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "orgs": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "policyEpoch": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "redactionEpoch": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "region": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "servingStaleReads": {
          "description": "refs served stale and marked stale (SPEC §15.1)",
          "type": "boolean"
        },
        "staleLagMs": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "status": {
          "$ref": "#/$defs/bee.v1.HealthStatus"
        },
        "version": {
          "description": "binary version",
          "type": "string"
        }
      },
      "title": "bee.v1.OpsCell",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.OpsClusterStatus.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Status of the deployment.",
  "properties": {
    "cells": {
      "items": {
        "$ref": "#/$defs/bee.v1.OpsCell"
      },
      "type": "array"
    },
    "directoryUp": {
      "type": "boolean"
    },
    "directoryVersion": {
      "type": "string"
    },
    "observedAt": {
      "format": "date-time",
      "type": "string"
    }
  },
  "title": "bee.v1.OpsClusterStatus",
  "type": "object"
}
