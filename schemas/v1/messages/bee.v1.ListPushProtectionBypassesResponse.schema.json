{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.PushProtectionBypass": {
      "description": "A request to write content that push protection blocked.",
      "properties": {
        "auditEntryId": {
          "type": "string"
        },
        "blockId": {
          "description": "from the SECRET_DETECTED error's bypass request URL",
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "createdAt": {
          "format": "date-time",
          "type": "string"
        },
        "expiresAt": {
          "description": "an approved bypass must be used before this",
          "format": "date-time",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/bee.v1.SecretFinding"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/bee.v1.PushProtectionBypassReason"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        },
        "requester": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "reviewComment": {
          "type": "string"
        },
        "reviewedAt": {
          "format": "date-time",
          "type": "string"
        },
        "reviewer": {
          "$ref": "#/$defs/bee.v1.Principal"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.PushProtectionBypassState"
        }
      },
      "title": "bee.v1.PushProtectionBypass",
      "type": "object"
    },
    "bee.v1.PushProtectionBypassReason": {
      "description": "Why the requester says the blocked secret is safe to write.",
      "enum": [
        "PUSH_PROTECTION_BYPASS_REASON_UNSPECIFIED",
        "PUSH_PROTECTION_BYPASS_REASON_USED_IN_TESTS",
        "PUSH_PROTECTION_BYPASS_REASON_FALSE_POSITIVE",
        "PUSH_PROTECTION_BYPASS_REASON_WILL_FIX_LATER"
      ],
      "title": "bee.v1.PushProtectionBypassReason",
      "type": "string"
    },
    "bee.v1.PushProtectionBypassState": {
      "description": "State of a bypass request.",
      "enum": [
        "PUSH_PROTECTION_BYPASS_STATE_UNSPECIFIED",
        "PUSH_PROTECTION_BYPASS_STATE_PENDING",
        "PUSH_PROTECTION_BYPASS_STATE_APPROVED",
        "PUSH_PROTECTION_BYPASS_STATE_DENIED",
        "PUSH_PROTECTION_BYPASS_STATE_EXPIRED",
        "PUSH_PROTECTION_BYPASS_STATE_GRANTED"
      ],
      "title": "bee.v1.PushProtectionBypassState",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SecretFinding": {
      "description": "One secret found by push protection.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "patternId": {
          "type": "string"
        },
        "secretType": {
          "description": "e.g. \"aws_access_key_id\"",
          "type": "string"
        }
      },
      "title": "bee.v1.SecretFinding",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListPushProtectionBypassesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListPushProtectionBypasses.",
  "properties": {
    "bypasses": {
      "items": {
        "$ref": "#/$defs/bee.v1.PushProtectionBypass"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListPushProtectionBypassesResponse",
  "type": "object"
}
