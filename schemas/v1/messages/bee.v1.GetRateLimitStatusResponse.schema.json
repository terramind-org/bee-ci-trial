{
  "$defs": {
    "bee.v1.OpsRateLimitBucket": {
      "description": "One rate-limit bucket.",
      "properties": {
        "costPerRequest": {
          "description": "cost units the last request of this kind consumed",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "limit": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "description": "e.g. \"interactive\", \"land\", \"bulk\"",
          "type": "string"
        },
        "remaining": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "resetAt": {
          "format": "date-time",
          "type": "string"
        },
        "scope": {
          "description": "\"principal\", \"delegation_root\", \"org\", \"anonymous\"",
          "type": "string"
        },
        "scopeId": {
          "type": "string"
        },
        "windowSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.OpsRateLimitBucket",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetRateLimitStatusResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GetRateLimitStatus.",
  "properties": {
    "buckets": {
      "items": {
        "$ref": "#/$defs/bee.v1.OpsRateLimitBucket"
      },
      "type": "array"
    },
    "limiterHealthy": {
      "description": "false = failing open for authenticated traffic",
      "type": "boolean"
    },
    "priorityTier": {
      "description": "tier the caller's requests are classified into",
      "type": "string"
    }
  },
  "title": "bee.v1.GetRateLimitStatusResponse",
  "type": "object"
}
