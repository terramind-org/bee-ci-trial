{
  "$defs": {
    "bee.v1.Bisect": {
      "description": "A bisect of a landed range for a failing post-land check (SPEC §11.6).",
      "properties": {
        "bad": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "checkName": {
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "firstBad": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "good": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "id": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "repoId": {
          "type": "string"
        },
        "revertChangeRequestId": {
          "description": "revert CR opened (or landed) for first_bad",
          "type": "string"
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.BisectState"
        },
        "tested": {
          "items": {
            "$ref": "#/$defs/bee.v1.ObjectId"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.Bisect",
      "type": "object"
    },
    "bee.v1.BisectState": {
      "description": "State of a bisect.",
      "enum": [
        "BISECT_STATE_UNSPECIFIED",
        "BISECT_STATE_RUNNING",
        "BISECT_STATE_FOUND",
        "BISECT_STATE_INCONCLUSIVE",
        "BISECT_STATE_CANCELLED",
        "BISECT_STATE_FLAKY"
      ],
      "title": "bee.v1.BisectState",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListBisectsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bisects": {
      "items": {
        "$ref": "#/$defs/bee.v1.Bisect"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListBisectsResponse",
  "type": "object"
}
