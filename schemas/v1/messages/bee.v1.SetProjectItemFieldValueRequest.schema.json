{
  "$defs": {
    "bee.v1.ProjectFieldKind": {
      "description": "Type of a project field. Custom fields use TEXT through ITERATION; the rest are built-in\nfields derived from the item's content.",
      "enum": [
        "PROJECT_FIELD_KIND_UNSPECIFIED",
        "PROJECT_FIELD_KIND_TEXT",
        "PROJECT_FIELD_KIND_NUMBER",
        "PROJECT_FIELD_KIND_DATE",
        "PROJECT_FIELD_KIND_SINGLE_SELECT",
        "PROJECT_FIELD_KIND_ITERATION",
        "PROJECT_FIELD_KIND_TITLE",
        "PROJECT_FIELD_KIND_ASSIGNEES",
        "PROJECT_FIELD_KIND_LABELS",
        "PROJECT_FIELD_KIND_MILESTONE",
        "PROJECT_FIELD_KIND_REPOSITORY",
        "PROJECT_FIELD_KIND_LINKED_CHANGES",
        "PROJECT_FIELD_KIND_REVIEWERS",
        "PROJECT_FIELD_KIND_PARENT_ISSUE",
        "PROJECT_FIELD_KIND_SUB_ISSUES_PROGRESS",
        "PROJECT_FIELD_KIND_ISSUE_TYPE"
      ],
      "title": "bee.v1.ProjectFieldKind",
      "type": "string"
    },
    "bee.v1.ProjectFieldValue": {
      "description": "An item's value for one field. Custom fields set exactly one typed value; built-in fields\nare read-only and set `display_value`.\n\nOneof `value`: at most one of `text`, `number`, `dateOn`, `optionId`, `iterationId` is set.",
      "properties": {
        "dateOn": {
          "format": "date-time",
          "type": "string"
        },
        "displayValue": {
          "description": "human-readable rendering of any field",
          "type": "string"
        },
        "fieldId": {
          "type": "string"
        },
        "fieldName": {
          "description": "filled by the server",
          "type": "string"
        },
        "iterationId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.ProjectFieldKind",
          "description": "filled by the server"
        },
        "number": {
          "type": "number"
        },
        "optionId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "title": "bee.v1.ProjectFieldValue",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SetProjectItemFieldValueRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for SetProjectItemFieldValue.",
  "properties": {
    "expectedVersion": {
      "description": "the item's version",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "itemId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/bee.v1.ProjectFieldValue"
    }
  },
  "title": "bee.v1.SetProjectItemFieldValueRequest",
  "type": "object"
}
