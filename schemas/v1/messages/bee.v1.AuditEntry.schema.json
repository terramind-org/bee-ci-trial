{
  "$defs": {
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
        "PRINCIPAL_KIND_AGENT",
        "PRINCIPAL_KIND_SERVICE"
      ],
      "title": "bee.v1.PrincipalKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.SubjectKind": {
      "description": "The kind of forge object a SubjectRef names.",
      "enum": [
        "SUBJECT_KIND_UNSPECIFIED",
        "SUBJECT_KIND_REPO",
        "SUBJECT_KIND_ISSUE",
        "SUBJECT_KIND_CHANGE_REQUEST",
        "SUBJECT_KIND_DISCUSSION",
        "SUBJECT_KIND_COMMENT",
        "SUBJECT_KIND_CHANGESET",
        "SUBJECT_KIND_RELEASE",
        "SUBJECT_KIND_GIST",
        "SUBJECT_KIND_WIKI_PAGE",
        "SUBJECT_KIND_CHECK_RUN",
        "SUBJECT_KIND_WORKFLOW_RUN",
        "SUBJECT_KIND_SECURITY_ALERT",
        "SUBJECT_KIND_PROJECT",
        "SUBJECT_KIND_PACKAGE",
        "SUBJECT_KIND_DEPLOYMENT",
        "SUBJECT_KIND_USER",
        "SUBJECT_KIND_ORG",
        "SUBJECT_KIND_TEAM",
        "SUBJECT_KIND_AGENT_RUN",
        "SUBJECT_KIND_ADVISORY",
        "SUBJECT_KIND_POST",
        "SUBJECT_KIND_SWARM",
        "SUBJECT_KIND_SAFETY_RECORD"
      ],
      "title": "bee.v1.SubjectKind",
      "type": "string"
    },
    "bee.v1.SubjectRef": {
      "description": "Names any forge object generically, for reactions, notifications, moderation, search hits\nand project items. `id` is the object's ULID, or for issues and change requests its number\nin decimal; `repo` is unset for objects that are not repo-scoped.",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.SubjectKind"
        },
        "repo": {
          "$ref": "#/$defs/bee.v1.RepoRef"
        }
      },
      "title": "bee.v1.SubjectRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.AuditEntry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One audit entry. `hash` = BLAKE3 over `prev_hash` and the canonical encoding of every other\nfield except `hash` itself.",
  "properties": {
    "action": {
      "description": "e.g. \"policy.update\", \"repo.delete\", \"push_protection.bypass\"",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/bee.v1.Principal"
    },
    "after": {
      "description": "JSON summary of the state after",
      "type": "string"
    },
    "before": {
      "description": "JSON summary of the state before",
      "type": "string"
    },
    "countryCode": {
      "type": "string"
    },
    "delegationChain": {
      "description": "principal ids from the actor back to its root",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "enterprise": {
      "type": "string"
    },
    "hash": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "id": {
      "description": "ULID",
      "type": "string"
    },
    "ip": {
      "description": "raw or hashed per the org's setting",
      "type": "string"
    },
    "ipHashed": {
      "type": "boolean"
    },
    "onBehalfOf": {
      "description": "the root principal id (human or service)",
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "policyRule": {
      "description": "The policy rule that allowed or denied the action; empty when none applied.",
      "type": "string"
    },
    "prevHash": {
      "contentEncoding": "base64",
      "type": "string"
    },
    "reason": {
      "description": "reason the actor supplied, if any",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "requestId": {
      "type": "string"
    },
    "result": {
      "description": "\"ok\" or an ErrorReason name for audited denials",
      "type": "string"
    },
    "seq": {
      "description": "per org (or enterprise), strictly increasing, no gaps",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "target": {
      "$ref": "#/$defs/bee.v1.SubjectRef"
    },
    "targetDisplay": {
      "description": "What was acted on, in words (gap G4).",
      "type": "string"
    },
    "time": {
      "format": "date-time",
      "type": "string"
    },
    "tokenId": {
      "type": "string"
    },
    "userAgent": {
      "type": "string"
    }
  },
  "title": "bee.v1.AuditEntry",
  "type": "object"
}
