{
  "$defs": {
    "bee.v1.BackupState": {
      "description": "State of a backup or restore job.",
      "enum": [
        "BACKUP_STATE_UNSPECIFIED",
        "BACKUP_STATE_RUNNING",
        "BACKUP_STATE_SUCCEEDED",
        "BACKUP_STATE_FAILED"
      ],
      "title": "bee.v1.BackupState",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.Restore.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A restore job.",
  "properties": {
    "backupId": {
      "type": "string"
    },
    "conformancePassed": {
      "type": "boolean"
    },
    "detail": {
      "type": "string"
    },
    "finishedAt": {
      "format": "date-time",
      "type": "string"
    },
    "fsckClean": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.BackupState"
    },
    "targetCell": {
      "type": "string"
    }
  },
  "title": "bee.v1.Restore",
  "type": "object"
}
