{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GetGitObjectsRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for GetGitObjects.",
  "properties": {
    "allowSignedUrls": {
      "description": "accept signed URLs in place of large bytes",
      "type": "boolean"
    },
    "oids": {
      "description": "hex, 40 or 64 chars",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "resumeOffset": {
      "description": "Resume an interrupted stream: skip this many bytes of the first oid.",
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "sizesOnly": {
      "description": "object-info: type and size, no bytes",
      "type": "boolean"
    }
  },
  "title": "bee.v1.GetGitObjectsRequest",
  "type": "object"
}
