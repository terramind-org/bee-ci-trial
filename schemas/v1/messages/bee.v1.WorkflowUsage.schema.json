{
  "$defs": {
    "bee.v1.WorkflowRunnerUsage": {
      "description": "Usage of one runner class.",
      "properties": {
        "billableMs": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "jobCount": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "machineClass": {
          "description": "e.g. \"linux-x64-4\", or \"self-hosted\"",
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowRunnerUsage",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.WorkflowUsage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Time used by a workflow's runs in the current billing period.",
  "properties": {
    "periodStartAt": {
      "format": "date-time",
      "type": "string"
    },
    "runDurationMs": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "runners": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkflowRunnerUsage"
      },
      "type": "array"
    },
    "workflowId": {
      "type": "string"
    }
  },
  "title": "bee.v1.WorkflowUsage",
  "type": "object"
}
