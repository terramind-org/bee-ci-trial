{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.Visibility": {
      "enum": [
        "VISIBILITY_UNSPECIFIED",
        "VISIBILITY_PRIVATE",
        "VISIBILITY_INTERNAL",
        "VISIBILITY_PUBLIC"
      ],
      "title": "bee.v1.Visibility",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateRepoFromTemplateRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "description": {
      "type": "string"
    },
    "includeAllRefs": {
      "description": "copy every ref's tip, not only the default ref",
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "template": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "visibility": {
      "$ref": "#/$defs/bee.v1.Visibility"
    }
  },
  "title": "bee.v1.CreateRepoFromTemplateRequest",
  "type": "object"
}
