{
  "$defs": {
    "bee.v1.AnnotationLevel": {
      "description": "Severity of a check annotation.",
      "enum": [
        "ANNOTATION_LEVEL_UNSPECIFIED",
        "ANNOTATION_LEVEL_NOTICE",
        "ANNOTATION_LEVEL_WARNING",
        "ANNOTATION_LEVEL_FAILURE"
      ],
      "title": "bee.v1.AnnotationLevel",
      "type": "string"
    },
    "bee.v1.CheckAnnotation": {
      "description": "A finding attached to a line range of a file.",
      "properties": {
        "endColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "endLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "level": {
          "$ref": "#/$defs/bee.v1.AnnotationLevel"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "rawDetails": {
          "type": "string"
        },
        "startColumn": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "startLine": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.CheckAnnotation",
      "type": "object"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListCheckAnnotationsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "annotations": {
      "items": {
        "$ref": "#/$defs/bee.v1.CheckAnnotation"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListCheckAnnotationsResponse",
  "type": "object"
}
