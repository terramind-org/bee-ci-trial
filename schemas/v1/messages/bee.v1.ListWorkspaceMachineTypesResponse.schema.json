{
  "$defs": {
    "bee.v1.WorkspaceMachineType": {
      "description": "A machine size.",
      "properties": {
        "cpus": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "displayName": {
          "type": "string"
        },
        "gpu": {
          "type": "boolean"
        },
        "memoryBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "name": {
          "description": "e.g. \"standard-4\"",
          "type": "string"
        },
        "prebuildAvailable": {
          "description": "a ready prebuild exists for the requested repo/ref",
          "type": "boolean"
        },
        "regions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "storageBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "usdMicrosPerHour": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.WorkspaceMachineType",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWorkspaceMachineTypesResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for ListWorkspaceMachineTypes.",
  "properties": {
    "machineTypes": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkspaceMachineType"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.ListWorkspaceMachineTypesResponse",
  "type": "object"
}
