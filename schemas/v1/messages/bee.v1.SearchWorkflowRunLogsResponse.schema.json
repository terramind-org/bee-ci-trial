{
  "$defs": {
    "bee.v1.WorkflowLogMatch": {
      "description": "One matching log line.",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "jobName": {
          "type": "string"
        },
        "line": {
          "description": "1-based line in the job log",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "title": "bee.v1.WorkflowLogMatch",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.SearchWorkflowRunLogsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for SearchWorkflowRunLogs.",
  "properties": {
    "matches": {
      "items": {
        "$ref": "#/$defs/bee.v1.WorkflowLogMatch"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.SearchWorkflowRunLogsResponse",
  "type": "object"
}
