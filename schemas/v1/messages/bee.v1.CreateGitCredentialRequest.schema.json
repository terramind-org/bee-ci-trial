{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateGitCredentialRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateGitCredential.",
  "properties": {
    "host": {
      "description": "e.g. \"beehive.example.com\"",
      "type": "string"
    },
    "repos": {
      "description": "empty = every repo the caller's token covers",
      "items": {
        "$ref": "#/$defs/bee.v1.RepoRef"
      },
      "type": "array"
    },
    "ttlSeconds": {
      "description": "default 3600; capped by the caller's token expiry",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "write": {
      "description": "allow push; default read-only",
      "type": "boolean"
    }
  },
  "title": "bee.v1.CreateGitCredentialRequest",
  "type": "object"
}
