{
  "$defs": {
    "bee.v1.AmbiguousPrefix": {
      "description": "Candidates for an ambiguous revision prefix (reason AMBIGUOUS_PREFIX).",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/bee.v1.ObjectId"
          },
          "type": "array"
        },
        "prefix": {
          "type": "string"
        }
      },
      "title": "bee.v1.AmbiguousPrefix",
      "type": "object"
    },
    "bee.v1.ChangeId": {
      "description": "16-byte stable identity of a piece of work (SPEC §3.3).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ChangeId",
      "type": "object"
    },
    "bee.v1.Conflict": {
      "properties": {
        "base": {
          "$ref": "#/$defs/bee.v1.ConflictSide"
        },
        "hunks": {
          "items": {
            "$ref": "#/$defs/bee.v1.ConflictHunk"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.ConflictKind"
        },
        "ours": {
          "$ref": "#/$defs/bee.v1.ConflictSide"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "theirs": {
          "$ref": "#/$defs/bee.v1.ConflictSide"
        }
      },
      "title": "bee.v1.Conflict",
      "type": "object"
    },
    "bee.v1.ConflictHunk": {
      "properties": {
        "baseLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "baseStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oursLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "oursStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "theirsLen": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "theirsStart": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "title": "bee.v1.ConflictHunk",
      "type": "object"
    },
    "bee.v1.ConflictKind": {
      "enum": [
        "CONFLICT_KIND_UNSPECIFIED",
        "CONFLICT_KIND_CONTENT",
        "CONFLICT_KIND_ADD_ADD",
        "CONFLICT_KIND_MODIFY_DELETE",
        "CONFLICT_KIND_SYMLINK",
        "CONFLICT_KIND_BINARY",
        "CONFLICT_KIND_REDACTED",
        "CONFLICT_KIND_MODE",
        "CONFLICT_KIND_FILE_DIRECTORY"
      ],
      "title": "bee.v1.ConflictKind",
      "type": "string"
    },
    "bee.v1.ConflictSet": {
      "description": "Structured conflicts: the server never writes markers (SPEC §7.3.2).",
      "properties": {
        "base": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "cleanEntries": {
          "items": {
            "$ref": "#/$defs/bee.v1.DeltaEntry"
          },
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/bee.v1.Conflict"
          },
          "type": "array"
        },
        "ours": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "theirs": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        }
      },
      "title": "bee.v1.ConflictSet",
      "type": "object"
    },
    "bee.v1.ConflictSide": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.Mode"
        }
      },
      "title": "bee.v1.ConflictSide",
      "type": "object"
    },
    "bee.v1.DeltaEntry": {
      "description": "Oneof `op`: at most one of `put`, `delete` is set.",
      "properties": {
        "delete": {
          "type": "boolean"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "put": {
          "$ref": "#/$defs/bee.v1.Put"
        }
      },
      "title": "bee.v1.DeltaEntry",
      "type": "object"
    },
    "bee.v1.ErrorDetail": {
      "description": "Stable machine-readable error detail attached to every failed RPC (SPEC §12.2).\n\nOneof `payload`: at most one of `conflicts`, `leaseConflict`, `policyDenial`, `versionMismatch`, `ambiguousPrefix`, `limitExceeded`, `missingObjects`, `pushProtection` is set.",
      "properties": {
        "ambiguousPrefix": {
          "$ref": "#/$defs/bee.v1.AmbiguousPrefix"
        },
        "conflicts": {
          "$ref": "#/$defs/bee.v1.ConflictSet"
        },
        "leaseConflict": {
          "$ref": "#/$defs/bee.v1.LeaseConflict"
        },
        "limitExceeded": {
          "$ref": "#/$defs/bee.v1.LimitExceeded"
        },
        "message": {
          "type": "string"
        },
        "missingObjects": {
          "$ref": "#/$defs/bee.v1.MissingObjects"
        },
        "policyDenial": {
          "$ref": "#/$defs/bee.v1.PolicyDenial"
        },
        "pushProtection": {
          "$ref": "#/$defs/bee.v1.PushProtectionBlock"
        },
        "reason": {
          "description": "an ErrorReason name without its prefix, e.g. MERGE_CONFLICT",
          "type": "string"
        },
        "requestId": {
          "description": "correlates with server logs",
          "type": "string"
        },
        "retryAfterMs": {
          "description": "set with RESOURCE_EXHAUSTED and other retryable reasons",
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "subcode": {
          "description": "finer rule for INVALID_ARGUMENT and others, snake_case",
          "type": "string"
        },
        "versionMismatch": {
          "$ref": "#/$defs/bee.v1.VersionMismatch"
        }
      },
      "title": "bee.v1.ErrorDetail",
      "type": "object"
    },
    "bee.v1.GitChangeIdMapping": {
      "description": "The changeset and ChangeId a pushed commit became.",
      "properties": {
        "changeId": {
          "$ref": "#/$defs/bee.v1.ChangeId"
        },
        "changeIdTrailer": {
          "description": "trailer value found or assigned, e.g. \"I1a2b...\"",
          "type": "string"
        },
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "gitOid": {
          "type": "string"
        },
        "trailerAdded": {
          "description": "the commit had no trailer; one was assigned",
          "type": "boolean"
        }
      },
      "title": "bee.v1.GitChangeIdMapping",
      "type": "object"
    },
    "bee.v1.GitPushApplyKind": {
      "description": "How an accepted ref update was applied.",
      "enum": [
        "GIT_PUSH_APPLY_KIND_UNSPECIFIED",
        "GIT_PUSH_APPLY_KIND_WORKSPACE_UPDATE",
        "GIT_PUSH_APPLY_KIND_LAND",
        "GIT_PUSH_APPLY_KIND_CHANGE_REQUEST_OPENED",
        "GIT_PUSH_APPLY_KIND_CHANGE_REQUEST_REVISED",
        "GIT_PUSH_APPLY_KIND_REF_UPDATE",
        "GIT_PUSH_APPLY_KIND_REF_DELETE"
      ],
      "title": "bee.v1.GitPushApplyKind",
      "type": "string"
    },
    "bee.v1.GitRefUpdateResult": {
      "description": "Result of one ref update (`ok` or `ng`).",
      "properties": {
        "applied": {
          "$ref": "#/$defs/bee.v1.GitPushApplyKind"
        },
        "changeRequestNumber": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "changeRequestUrl": {
          "type": "string"
        },
        "changeset": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "error": {
          "$ref": "#/$defs/bee.v1.ErrorDetail",
          "description": "set when not ok; its reason maps to the `ng` message"
        },
        "ok": {
          "type": "boolean"
        },
        "refName": {
          "type": "string"
        },
        "refVersion": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "resultOid": {
          "description": "final git oid of the ref (a land may rebase onto the tip)",
          "type": "string"
        }
      },
      "title": "bee.v1.GitRefUpdateResult",
      "type": "object"
    },
    "bee.v1.LeaseConflict": {
      "properties": {
        "leaseIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "contentEncoding": "base64",
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.LeaseConflict",
      "type": "object"
    },
    "bee.v1.LimitExceeded": {
      "description": "The limit a request exceeded (reason TOO_LARGE or QUOTA_EXCEEDED).",
      "properties": {
        "actual": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "limit": {
          "description": "e.g. \"max_blob_bytes\", \"max_path_bytes\", \"open_change_requests\"",
          "type": "string"
        },
        "maximum": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.LimitExceeded",
      "type": "object"
    },
    "bee.v1.MissingObjects": {
      "description": "Objects the server has no row for (reason MISSING_OBJECT).",
      "properties": {
        "ids": {
          "items": {
            "$ref": "#/$defs/bee.v1.ObjectId"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.MissingObjects",
      "type": "object"
    },
    "bee.v1.Mode": {
      "description": "File mode as stored in trees (SPEC §4.2).",
      "enum": [
        "MODE_UNSPECIFIED",
        "MODE_FILE",
        "MODE_EXECUTABLE",
        "MODE_SYMLINK",
        "MODE_TREE"
      ],
      "title": "bee.v1.Mode",
      "type": "string"
    },
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.PolicyDenial": {
      "properties": {
        "missing": {
          "description": "e.g. \"approval:owner:src/auth\", \"check:test\"",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "rule": {
          "type": "string"
        }
      },
      "title": "bee.v1.PolicyDenial",
      "type": "object"
    },
    "bee.v1.PushProtectionBlock": {
      "description": "Secrets that blocked a write (reason SECRET_DETECTED, PRODUCT §4.18).",
      "properties": {
        "bypassAllowed": {
          "description": "the caller may request a bypass through SecurityService",
          "type": "boolean"
        },
        "bypassRequestUrl": {
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/bee.v1.SecretFinding"
          },
          "type": "array"
        }
      },
      "title": "bee.v1.PushProtectionBlock",
      "type": "object"
    },
    "bee.v1.Put": {
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "mode": {
          "$ref": "#/$defs/bee.v1.Mode"
        },
        "size": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.Put",
      "type": "object"
    },
    "bee.v1.SecretFinding": {
      "description": "One secret found by push protection.",
      "properties": {
        "blob": {
          "$ref": "#/$defs/bee.v1.ObjectId"
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "contentEncoding": "base64",
          "type": "string"
        },
        "patternId": {
          "type": "string"
        },
        "secretType": {
          "description": "e.g. \"aws_access_key_id\"",
          "type": "string"
        }
      },
      "title": "bee.v1.SecretFinding",
      "type": "object"
    },
    "bee.v1.VersionMismatch": {
      "description": "Current state when a compare-and-swap failed (reason VERSION_MISMATCH).",
      "properties": {
        "currentTarget": {
          "$ref": "#/$defs/bee.v1.ObjectId",
          "description": "refs only"
        },
        "currentVersion": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "expectedVersion": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "ref": {
          "description": "ref name, or the resource id for forge objects",
          "type": "string"
        }
      },
      "title": "bee.v1.VersionMismatch",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.GitIngestCommitsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for GitIngestCommits.",
  "properties": {
    "atomicRejected": {
      "description": "atomic push rejected as a whole",
      "type": "boolean"
    },
    "changeIds": {
      "items": {
        "$ref": "#/$defs/bee.v1.GitChangeIdMapping"
      },
      "type": "array"
    },
    "messages": {
      "description": "sideband `remote:` lines (CR links, hints)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "results": {
      "description": "one per command, in order",
      "items": {
        "$ref": "#/$defs/bee.v1.GitRefUpdateResult"
      },
      "type": "array"
    },
    "unpackError": {
      "description": "`unpack <error>` when not ok",
      "type": "string"
    },
    "unpackOk": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.GitIngestCommitsResponse",
  "type": "object"
}
