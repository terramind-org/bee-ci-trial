{
  "$defs": {
    "bee.v1.OAuthClientKind": {
      "description": "Which kind of client an OAuth token or grant belongs to.",
      "enum": [
        "OAUTH_CLIENT_KIND_UNSPECIFIED",
        "OAUTH_CLIENT_KIND_OAUTH_APP",
        "OAUTH_CLIENT_KIND_APP"
      ],
      "title": "bee.v1.OAuthClientKind",
      "type": "string"
    },
    "bee.v1.OAuthTokenSet": {
      "description": "Tokens issued by the OAuth provider.",
      "properties": {
        "accessToken": {
          "description": "a Biscuit token",
          "type": "string"
        },
        "clientKind": {
          "$ref": "#/$defs/bee.v1.OAuthClientKind"
        },
        "expiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "refreshToken": {
          "description": "empty when the client does not use expiring tokens",
          "type": "string"
        },
        "refreshTokenExpiresAt": {
          "format": "date-time",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "tokenId": {
          "type": "string"
        },
        "tokenType": {
          "description": "\"bearer\"",
          "type": "string"
        }
      },
      "title": "bee.v1.OAuthTokenSet",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.RefreshOAuthTokenResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for RefreshOAuthToken.",
  "properties": {
    "tokens": {
      "$ref": "#/$defs/bee.v1.OAuthTokenSet"
    }
  },
  "title": "bee.v1.RefreshOAuthTokenResponse",
  "type": "object"
}
