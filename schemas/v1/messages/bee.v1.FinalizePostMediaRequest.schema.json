{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.FinalizePostMediaRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for FinalizePostMedia.",
  "properties": {
    "altText": {
      "description": "1-1000 characters; required for images",
      "type": "string"
    },
    "durationMs": {
      "description": "video only",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "height": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "mediaId": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "sha256": {
      "description": "lowercase hex of the uploaded bytes",
      "type": "string"
    },
    "width": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.FinalizePostMediaRequest",
  "type": "object"
}
