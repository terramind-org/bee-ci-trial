{
  "$defs": {
    "bee.v1.ProjectWorkflowKind": {
      "description": "Built-in automation kinds.",
      "enum": [
        "PROJECT_WORKFLOW_KIND_UNSPECIFIED",
        "PROJECT_WORKFLOW_KIND_ITEM_ADDED",
        "PROJECT_WORKFLOW_KIND_ITEM_REOPENED",
        "PROJECT_WORKFLOW_KIND_ITEM_CLOSED",
        "PROJECT_WORKFLOW_KIND_CHANGE_LANDED",
        "PROJECT_WORKFLOW_KIND_CHANGES_REQUESTED",
        "PROJECT_WORKFLOW_KIND_CHANGE_APPROVED",
        "PROJECT_WORKFLOW_KIND_AUTO_ARCHIVE",
        "PROJECT_WORKFLOW_KIND_AUTO_ADD",
        "PROJECT_WORKFLOW_KIND_AUTO_CLOSE_ISSUE",
        "PROJECT_WORKFLOW_KIND_AUTO_ADD_SUB_ISSUES"
      ],
      "title": "bee.v1.ProjectWorkflowKind",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateProjectWorkflowRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateProjectWorkflow.",
  "properties": {
    "archiveAfterDays": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "enabled": {
      "type": "boolean"
    },
    "fieldId": {
      "type": "string"
    },
    "filter": {
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/bee.v1.ProjectWorkflowKind"
    },
    "name": {
      "type": "string"
    },
    "optionId": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "sourceRepo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.CreateProjectWorkflowRequest",
  "type": "object"
}
