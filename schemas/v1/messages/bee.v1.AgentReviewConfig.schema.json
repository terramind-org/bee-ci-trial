{
  "$defs": {
    "bee.v1.AgentReviewTrigger": {
      "description": "When the review agent is requested.",
      "enum": [
        "AGENT_REVIEW_TRIGGER_UNSPECIFIED",
        "AGENT_REVIEW_TRIGGER_DISABLED",
        "AGENT_REVIEW_TRIGGER_ON_OPEN",
        "AGENT_REVIEW_TRIGGER_ON_EVERY_REVISION",
        "AGENT_REVIEW_TRIGGER_ON_REQUEST"
      ],
      "title": "bee.v1.AgentReviewTrigger",
      "type": "string"
    },
    "bee.v1.AgentRunBudget": {
      "description": "Spending and time limits for a run.",
      "properties": {
        "maxChangesets": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxDurationSeconds": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxInputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxLanded": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxOutputTokens": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "maxUsdMicros": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "title": "bee.v1.AgentRunBudget",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.AgentReviewConfig.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Automatic agent review settings for a repo.",
  "properties": {
    "agentPrincipalId": {
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/bee.v1.AgentRunBudget",
      "description": "per review"
    },
    "includeDrafts": {
      "type": "boolean"
    },
    "instructions": {
      "type": "string"
    },
    "paths": {
      "description": "only CRs touching these prefixes; empty = all",
      "items": {
        "contentEncoding": "base64",
        "type": "string"
      },
      "type": "array"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "reviewAgentAuthored": {
      "description": "also review CRs opened by agents",
      "type": "boolean"
    },
    "runtimeId": {
      "type": "string"
    },
    "trigger": {
      "$ref": "#/$defs/bee.v1.AgentReviewTrigger"
    }
  },
  "title": "bee.v1.AgentReviewConfig",
  "type": "object"
}
