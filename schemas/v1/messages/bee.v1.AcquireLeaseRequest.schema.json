{
  "$defs": {
    "bee.v1.ChangeId": {
      "description": "16-byte stable identity of a piece of work (SPEC §3.3).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ChangeId",
      "type": "object"
    },
    "bee.v1.LeaseMode": {
      "enum": [
        "LEASE_MODE_UNSPECIFIED",
        "LEASE_MODE_ADVISORY",
        "LEASE_MODE_EXCLUSIVE"
      ],
      "title": "bee.v1.LeaseMode",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.AcquireLeaseRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "changeId": {
      "$ref": "#/$defs/bee.v1.ChangeId"
    },
    "mode": {
      "$ref": "#/$defs/bee.v1.LeaseMode"
    },
    "note": {
      "type": "string"
    },
    "paths": {
      "items": {
        "contentEncoding": "base64",
        "type": "string"
      },
      "type": "array"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "ttlSeconds": {
      "description": "0 = default (2 hours)",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.AcquireLeaseRequest",
  "type": "object"
}
