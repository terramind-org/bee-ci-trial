{
  "$defs": {
    "bee.v1.Backup": {
      "description": "A metadata backup with the blob manifest needed to restore it.",
      "properties": {
        "cell": {
          "type": "string"
        },
        "expiresAt": {
          "description": "retention is at most 30 days",
          "format": "date-time",
          "type": "string"
        },
        "finishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "sizeBytes": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "startedAt": {
          "format": "date-time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/bee.v1.BackupState"
        }
      },
      "title": "bee.v1.Backup",
      "type": "object"
    },
    "bee.v1.BackupState": {
      "description": "State of a backup or restore job.",
      "enum": [
        "BACKUP_STATE_UNSPECIFIED",
        "BACKUP_STATE_RUNNING",
        "BACKUP_STATE_SUCCEEDED",
        "BACKUP_STATE_FAILED"
      ],
      "title": "bee.v1.BackupState",
      "type": "string"
    },
    "bee.v1.PageResponse": {
      "properties": {
        "nextPageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageResponse",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListBackupsResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "backups": {
      "items": {
        "$ref": "#/$defs/bee.v1.Backup"
      },
      "type": "array"
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageResponse"
    }
  },
  "title": "bee.v1.ListBackupsResponse",
  "type": "object"
}
