{
  "$defs": {
    "bee.v1.CodeScanningSetupState": {
      "description": "Default setup state.",
      "enum": [
        "CODE_SCANNING_SETUP_STATE_UNSPECIFIED",
        "CODE_SCANNING_SETUP_STATE_NOT_CONFIGURED",
        "CODE_SCANNING_SETUP_STATE_CONFIGURED"
      ],
      "title": "bee.v1.CodeScanningSetupState",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.UpdateCodeScanningDefaultSetupRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for UpdateCodeScanningDefaultSetup.",
  "properties": {
    "languages": {
      "description": "empty = unchanged",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "querySuite": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "schedule": {
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/bee.v1.CodeScanningSetupState"
    }
  },
  "title": "bee.v1.UpdateCodeScanningDefaultSetupRequest",
  "type": "object"
}
