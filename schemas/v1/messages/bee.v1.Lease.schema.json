          "type": "string"
        }
      },
      "title": "bee.v1.ChangeId",
      "type": "object"
    },
    "bee.v1.LeaseMode": {
      "enum": [
        "LEASE_MODE_UNSPECIFIED",
        "LEASE_MODE_ADVISORY",
        "LEASE_MODE_EXCLUSIVE"
      ],
      "title": "bee.v1.LeaseMode",
      "type": "string"
    },
    "bee.v1.Principal": {
      "properties": {
        "display": {
          "type": "string"
        },
        "externalIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/bee.v1.PrincipalKind"
        },
        "ownerId": {
          "description": "agents only",
          "type": "string"
        },
        "runtime": {
          "description": "agents only, e.g. \"claude-code\"",
          "type": "string"
        }
      },
      "title": "bee.v1.Principal",
      "type": "object"
    },
    "bee.v1.PrincipalKind": {
      "enum": [
        "PRINCIPAL_KIND_UNSPECIFIED",
        "PRINCIPAL_KIND_HUMAN",
