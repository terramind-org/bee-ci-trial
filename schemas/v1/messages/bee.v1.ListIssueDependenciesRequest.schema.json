{
  "$defs": {
    "bee.v1.IssueDependencyDirection": {
      "description": "Direction of a dependency listing.",
      "enum": [
        "ISSUE_DEPENDENCY_DIRECTION_UNSPECIFIED",
        "ISSUE_DEPENDENCY_DIRECTION_BLOCKED_BY",
        "ISSUE_DEPENDENCY_DIRECTION_BLOCKING"
      ],
      "title": "bee.v1.IssueDependencyDirection",
      "type": "string"
    },
    "bee.v1.PageRequest": {
      "properties": {
        "pageSize": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pageToken": {
          "type": "string"
        }
      },
      "title": "bee.v1.PageRequest",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListIssueDependenciesRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for ListIssueDependencies.",
  "properties": {
    "direction": {
      "$ref": "#/$defs/bee.v1.IssueDependencyDirection",
      "description": "required"
    },
    "number": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "page": {
      "$ref": "#/$defs/bee.v1.PageRequest"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.ListIssueDependenciesRequest",
  "type": "object"
}
