{
  "$defs": {
    "bee.v1.IssueFieldIteration": {
      "description": "One iteration of an iteration issue field.",
      "properties": {
        "completed": {
          "type": "boolean"
        },
        "durationDays": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "server-assigned; send empty to create",
          "type": "string"
        },
        "startOn": {
          "format": "date-time",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "title": "bee.v1.IssueFieldIteration",
      "type": "object"
    },
    "bee.v1.IssueFieldKind": {
      "description": "Value type of a custom issue field.",
      "enum": [
        "ISSUE_FIELD_KIND_UNSPECIFIED",
        "ISSUE_FIELD_KIND_TEXT",
        "ISSUE_FIELD_KIND_NUMBER",
        "ISSUE_FIELD_KIND_DATE",
        "ISSUE_FIELD_KIND_SINGLE_SELECT",
        "ISSUE_FIELD_KIND_ITERATION"
      ],
      "title": "bee.v1.IssueFieldKind",
      "type": "string"
    },
    "bee.v1.IssueFieldOption": {
      "description": "One choice of a single-select issue field.",
      "properties": {
        "color": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "description": "server-assigned; send empty to create",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "title": "bee.v1.IssueFieldOption",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CreateIssueFieldRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CreateIssueField.",
  "properties": {
    "description": {
      "type": "string"
    },
    "issueTypeIds": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "iterations": {
      "items": {
        "$ref": "#/$defs/bee.v1.IssueFieldIteration"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/bee.v1.IssueFieldKind"
    },
    "name": {
      "type": "string"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/bee.v1.IssueFieldOption"
      },
      "type": "array"
    },
    "org": {
      "type": "string"
    }
  },
  "title": "bee.v1.CreateIssueFieldRequest",
  "type": "object"
}
