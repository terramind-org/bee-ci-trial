{
  "$defs": {
    "bee.v1.ObjectId": {
      "description": "34-byte object id: algorithm byte, kind byte, 32-byte digest (SPEC §3.1).",
      "properties": {
        "raw": {
          "contentEncoding": "base64",
          "type": "string"
        }
      },
      "title": "bee.v1.ObjectId",
      "type": "object"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CodeScanningAnalysis.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One processed analysis.",
  "properties": {
    "category": {
      "type": "string"
    },
    "changeset": {
      "$ref": "#/$defs/bee.v1.ObjectId"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    },
    "resultsCount": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "rulesCount": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "sarifUploadId": {
      "type": "string"
    },
    "toolName": {
      "type": "string"
    },
    "toolVersion": {
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "bee.v1.CodeScanningAnalysis",
  "type": "object"
}
