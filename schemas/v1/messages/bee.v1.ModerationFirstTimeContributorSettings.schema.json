{
  "$defs": {
    "bee.v1.ModerationRunApproval": {
      "description": "When workflow runs from first-time contributors need approval.",
      "enum": [
        "MODERATION_RUN_APPROVAL_UNSPECIFIED",
        "MODERATION_RUN_APPROVAL_NEW_ACCOUNTS",
        "MODERATION_RUN_APPROVAL_FIRST_TIME",
        "MODERATION_RUN_APPROVAL_ALL_OUTSIDE"
      ],
      "title": "bee.v1.ModerationRunApproval",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ModerationFirstTimeContributorSettings.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Handling of first-time contributors.",
  "properties": {
    "holdChangeRequests": {
      "description": "CRs wait for maintainer approval before review starts",
      "type": "boolean"
    },
    "label": {
      "description": "e.g. \"first-time-contributor\"",
      "type": "string"
    },
    "labelFirstContributions": {
      "type": "boolean"
    },
    "org": {
      "description": "set for org settings",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "set for repo settings"
    },
    "runApproval": {
      "$ref": "#/$defs/bee.v1.ModerationRunApproval"
    },
    "treatNewAgentsAsFirstTime": {
      "type": "boolean"
    }
  },
  "title": "bee.v1.ModerationFirstTimeContributorSettings",
  "type": "object"
}
