{
  "$defs": {
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.VerifyAttestationRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for VerifyAttestation.",
  "properties": {
    "expectedSignerWorkflow": {
      "description": "e.g. \"org/repo/.github/workflows/release.yml\"",
      "type": "string"
    },
    "expectedSourceRef": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "predicateType": {
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef",
      "description": "or"
    },
    "subjectDigest": {
      "type": "string"
    }
  },
  "title": "bee.v1.VerifyAttestationRequest",
  "type": "object"
}
