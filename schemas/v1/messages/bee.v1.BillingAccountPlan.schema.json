{
  "$defs": {
    "bee.v1.BillingCycle": {
      "description": "Length of a billing cycle.",
      "enum": [
        "BILLING_CYCLE_UNSPECIFIED",
        "BILLING_CYCLE_MONTHLY",
        "BILLING_CYCLE_YEARLY"
      ],
      "title": "bee.v1.BillingCycle",
      "type": "string"
    },
    "bee.v1.BillingIncludedUsage": {
      "description": "Usage included in a plan before metered charges start.",
      "properties": {
        "product": {
          "$ref": "#/$defs/bee.v1.BillingProduct"
        },
        "quantity": {
          "type": "number"
        },
        "unit": {
          "description": "e.g. \"minute\", \"GB-month\", \"token\"",
          "type": "string"
        }
      },
      "title": "bee.v1.BillingIncludedUsage",
      "type": "object"
    },
    "bee.v1.BillingPlan": {
      "description": "A plan an account can be on.",
      "properties": {
        "description": {
          "type": "string"
        },
        "features": {
          "description": "feature keys enabled by the plan",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "description": "e.g. \"free\", \"team\", \"enterprise\"",
          "type": "string"
        },
        "included": {
          "items": {
            "$ref": "#/$defs/bee.v1.BillingIncludedUsage"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "seatMonthlyPriceMicroUsd": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "seatYearlyPriceMicroUsd": {
          "format": "uint64",
          "pattern": "^[0-9]+$",
          "type": [
            "string",
            "integer"
          ]
        },
        "selfServe": {
          "description": "false = contact sales",
          "type": "boolean"
        }
      },
      "title": "bee.v1.BillingPlan",
      "type": "object"
    },
    "bee.v1.BillingProduct": {
      "description": "A metered product.",
      "enum": [
        "BILLING_PRODUCT_UNSPECIFIED",
        "BILLING_PRODUCT_ACTIONS_MINUTES",
        "BILLING_PRODUCT_STORAGE_GB",
        "BILLING_PRODUCT_WORKSPACES_HOURS",
        "BILLING_PRODUCT_AGENT_TOKENS",
        "BILLING_PRODUCT_PACKAGES_TRANSFER",
        "BILLING_PRODUCT_LFS",
        "BILLING_PRODUCT_SEATS",
        "BILLING_PRODUCT_MARKETPLACE"
      ],
      "title": "bee.v1.BillingProduct",
      "type": "string"
    },
    "bee.v1.EnterpriseScope": {
      "description": "An org or an enterprise account: the owner of a setting, a bill or a cost center.\n\nOneof `scope`: at most one of `org`, `enterprise` is set.",
      "properties": {
        "enterprise": {
          "description": "enterprise slug or id",
          "type": "string"
        },
        "org": {
          "description": "org name or id",
          "type": "string"
        }
      },
      "title": "bee.v1.EnterpriseScope",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.BillingAccountPlan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "An account's plan subscription.",
  "properties": {
    "billingDisabled": {
      "description": "self-hosted or comped: nothing is charged",
      "type": "boolean"
    },
    "cycle": {
      "$ref": "#/$defs/bee.v1.BillingCycle"
    },
    "cycleStartedAt": {
      "format": "date-time",
      "type": "string"
    },
    "nextBillingAt": {
      "format": "date-time",
      "type": "string"
    },
    "pendingPlanId": {
      "description": "scheduled change at the end of the cycle",
      "type": "string"
    },
    "pendingSeats": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "plan": {
      "$ref": "#/$defs/bee.v1.BillingPlan"
    },
    "scope": {
      "$ref": "#/$defs/bee.v1.EnterpriseScope"
    },
    "seatsConsumed": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "seatsPurchased": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "title": "bee.v1.BillingAccountPlan",
  "type": "object"
}
