{
  "$defs": {
    "bee.v1.DiscussionStateReason": {
      "description": "Why a discussion was closed, or that it was reopened.",
      "enum": [
        "DISCUSSION_STATE_REASON_UNSPECIFIED",
        "DISCUSSION_STATE_REASON_RESOLVED",
        "DISCUSSION_STATE_REASON_OUTDATED",
        "DISCUSSION_STATE_REASON_DUPLICATE",
        "DISCUSSION_STATE_REASON_REOPENED"
      ],
      "title": "bee.v1.DiscussionStateReason",
      "type": "string"
    },
    "bee.v1.RepoRef": {
      "description": "Every repo-scoped request names its repo by id or by \"org/name\".\n\nOneof `repo`: at most one of `id`, `fullName` is set.",
      "properties": {
        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.CloseDiscussionRequest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Request for CloseDiscussion.",
  "properties": {
    "number": {
      "format": "uint64",
      "pattern": "^[0-9]+$",
      "type": [
        "string",
        "integer"
      ]
    },
    "org": {
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/bee.v1.DiscussionStateReason",
      "description": "UNSPECIFIED = RESOLVED"
    },
    "repo": {
      "$ref": "#/$defs/bee.v1.RepoRef"
    }
  },
  "title": "bee.v1.CloseDiscussionRequest",
  "type": "object"
}
