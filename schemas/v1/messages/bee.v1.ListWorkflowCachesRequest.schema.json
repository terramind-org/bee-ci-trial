        "fullName": {
          "description": "\"org/name\"",
          "type": "string"
        },
        "id": {
          "description": "ULID",
          "type": "string"
        }
      },
      "title": "bee.v1.RepoRef",
      "type": "object"
    },
    "bee.v1.WorkflowCacheSort": {
      "description": "Sort order for ListWorkflowCaches.",
      "enum": [
        "WORKFLOW_CACHE_SORT_UNSPECIFIED",
        "WORKFLOW_CACHE_SORT_LAST_ACCESSED",
        "WORKFLOW_CACHE_SORT_CREATED",
        "WORKFLOW_CACHE_SORT_SIZE"
      ],
      "title": "bee.v1.WorkflowCacheSort",
      "type": "string"
    }
  },
  "$id": "https://bee.dev/schemas/v1/messages/bee.v1.ListWorkflowCachesRequest.schema.json",
