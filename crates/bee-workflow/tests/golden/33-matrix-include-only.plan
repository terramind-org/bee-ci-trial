# event push action=-
run .github/workflows/sites.yml "Sites"
  run-name: "Update code"
  event: push ref=refs/heads/main sha=2222222222222222222222222222222222222222
  permissions: default
  job smoke decided=true
    instance "smoke (production, site-a)"
      matrix: {"site":"production","datacenter":"site-a"}
      strategy: index=0 total=2 fail-fast=true max-parallel=2
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run curl -fsS https://production.site-a.example/health"
        run: "curl -fsS https://production.site-a.example/health"
        shell: default -> "bash -e {0}"
    instance "smoke (staging, site-b)"
      matrix: {"site":"staging","datacenter":"site-b"}
      strategy: index=1 total=2 fail-fast=true max-parallel=2
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run curl -fsS https://staging.site-b.example/health"
        run: "curl -fsS https://staging.site-b.example/health"
        shell: default -> "bash -e {0}"
