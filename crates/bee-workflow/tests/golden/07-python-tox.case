event: push refs/heads/main files=src/pkg/core.py
--- .github/workflows/tests.yml
name: tests
on: push
jobs:
  tox:
    runs-on: ubuntu-22.04
    strategy:
      matrix:
        # Unquoted 3.10 is the number 3.1, as on GitHub.
        python-version: ['3.9', '3.10', 3.10, "3.12"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - run: python -m pip install --upgrade pip tox tox-gh-actions
      - run: tox
        env:
          PLATFORM: ${{ runner.os }}
