event: push refs/heads/main
--- .github/workflows/integration.yml
name: Integration
on: push
jobs:
  integration:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        postgres: [15, 16]
    services:
      postgres:
        image: postgres:${{ matrix.postgres }}
        env:
          POSTGRES_PASSWORD: ${{ secrets.PG_PASSWORD }}
          POSTGRES_DB: widget_test
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
      redis:
        image: redis:7
        ports: ['6379:6379']
      optional:
        image: ${{ matrix.postgres == 16 && 'memcached:1.6' || '' }}
    env:
      DATABASE_URL: postgres://postgres:${{ secrets.PG_PASSWORD }}@localhost:5432/widget_test
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-go@v5
        with:
          go-version: '1.23'
      - run: go test -tags=integration ./...
