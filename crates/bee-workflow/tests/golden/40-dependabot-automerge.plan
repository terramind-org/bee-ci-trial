# event pull_request action=opened
# event pull_request_target action=opened
run .github/workflows/automerge.yml "Dependabot auto-merge"
  run-name: "Add feature"
  event: pull_request_target ref=refs/heads/main sha=dddddddddddddddddddddddddddddddddddddddd
  permissions: contents=write, pull-requests=write
  job dependabot if="github.actor == 'dependabot[bot]'" decided=true
    instance "dependabot"
      runs-on: ["ubuntu-latest"]
      permissions: contents=write, pull-requests=write
      timeout-minutes: 360
      step 1 "Dependabot metadata" id=metadata
        uses: dependabot/fetch-metadata@v2
        with:
          github-token: "${{ secrets.GITHUB_TOKEN }}"
      step 2 "Enable auto-merge for patch updates" if="steps.metadata.outputs.update-type == 'version-update:semver-patch'"
        run: "gh pr merge --auto --merge \"$PR_URL\""
        shell: default -> "bash -e {0}"
        env:
          PR_URL: "https://beehive.test/octo-org/widget/pull/42"
          GH_TOKEN: "${{ secrets.GITHUB_TOKEN }}"
