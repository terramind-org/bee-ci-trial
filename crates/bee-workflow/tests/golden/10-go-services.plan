# event push action=-
run .github/workflows/integration.yml "Integration"
  run-name: "Update code"
  event: push ref=refs/heads/main sha=2222222222222222222222222222222222222222
  permissions: default
  job integration decided=true
    instance "integration (15)"
      matrix: {"postgres":15}
      strategy: index=0 total=2 fail-fast=true max-parallel=2
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      service postgres: "postgres:15"
        env:
          POSTGRES_PASSWORD: "${{ secrets.PG_PASSWORD }}"
          POSTGRES_DB: "widget_test"
        ports: 5432:5432
        options: "--health-cmd pg_isready --health-interval 10s --health-timeout 5s --health-retries 5"
      service redis: "redis:7"
        ports: 6379:6379
      env:
        DATABASE_URL: "postgres://postgres:${{ secrets.PG_PASSWORD }}@localhost:5432/widget_test"
      step 1 "Run actions/checkout@v4"
        uses: actions/checkout@v4
      step 2 "Run actions/setup-go@v5"
        uses: actions/setup-go@v5
        with:
          go-version: "1.23"
      step 3 "Run go test -tags=integration ./..."
        run: "go test -tags=integration ./..."
        shell: default -> "bash -e {0}"
    instance "integration (16)"
      matrix: {"postgres":16}
      strategy: index=1 total=2 fail-fast=true max-parallel=2
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      service postgres: "postgres:16"
        env:
          POSTGRES_PASSWORD: "${{ secrets.PG_PASSWORD }}"
          POSTGRES_DB: "widget_test"
        ports: 5432:5432
        options: "--health-cmd pg_isready --health-interval 10s --health-timeout 5s --health-retries 5"
      service redis: "redis:7"
        ports: 6379:6379
      service optional: "memcached:1.6"
      env:
        DATABASE_URL: "postgres://postgres:${{ secrets.PG_PASSWORD }}@localhost:5432/widget_test"
      step 1 "Run actions/checkout@v4"
        uses: actions/checkout@v4
      step 2 "Run actions/setup-go@v5"
        uses: actions/setup-go@v5
        with:
          go-version: "1.23"
      step 3 "Run go test -tags=integration ./..."
        run: "go test -tags=integration ./..."
        shell: default -> "bash -e {0}"
