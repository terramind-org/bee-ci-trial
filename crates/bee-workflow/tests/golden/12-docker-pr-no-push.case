event: pr opened base=main head=deps/bump
--- .github/workflows/image.yml
name: Image
on:
  pull_request:
    branches: [main]
jobs:
  image:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v4
      - uses: docker/build-push-action@v6
        with:
          push: ${{ github.event_name != 'pull_request' }}
          tags: widget:pr-${{ github.event.number }}
          build-args: |
            VERSION=${{ github.sha }}
            REF=${{ github.ref }}
