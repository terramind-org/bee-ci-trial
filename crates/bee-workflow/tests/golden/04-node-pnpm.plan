# event push action=-
run .github/workflows/node.yml "Node CI"
  run-name: "Update code"
  event: push ref=refs/heads/main sha=2222222222222222222222222222222222222222
  permissions: default
  job build decided=true
    instance "build (18.x)"
      matrix: {"node-version":"18.x"}
      strategy: index=0 total=3 fail-fast=true max-parallel=3
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run actions/checkout@v4"
        uses: actions/checkout@v4
      step 2 "Run pnpm/action-setup@v4"
        uses: pnpm/action-setup@v4
        with:
          version: "9"
      step 3 "Use Node.js 18.x"
        uses: actions/setup-node@v4
        with:
          node-version: "18.x"
          cache: "pnpm"
      step 4 "Run pnpm install --frozen-lockfile"
        run: "pnpm install --frozen-lockfile"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
      step 5 "Run pnpm run build --if-present"
        run: "pnpm run build --if-present"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
      step 6 "Run pnpm test"
        run: "pnpm test"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
        env:
          CI: "true"
          NODE_OPTIONS: "--max-old-space-size=4096"
    instance "build (20.x)"
      matrix: {"node-version":"20.x"}
      strategy: index=1 total=3 fail-fast=true max-parallel=3
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run actions/checkout@v4"
        uses: actions/checkout@v4
      step 2 "Run pnpm/action-setup@v4"
        uses: pnpm/action-setup@v4
        with:
          version: "9"
      step 3 "Use Node.js 20.x"
        uses: actions/setup-node@v4
        with:
          node-version: "20.x"
          cache: "pnpm"
      step 4 "Run pnpm install --frozen-lockfile"
        run: "pnpm install --frozen-lockfile"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
      step 5 "Run pnpm run build --if-present"
        run: "pnpm run build --if-present"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
      step 6 "Run pnpm test"
        run: "pnpm test"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
        env:
          CI: "true"
          NODE_OPTIONS: "--max-old-space-size=4096"
    instance "build (22)"
      matrix: {"node-version":22}
      strategy: index=2 total=3 fail-fast=true max-parallel=3
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run actions/checkout@v4"
        uses: actions/checkout@v4
      step 2 "Run pnpm/action-setup@v4"
        uses: pnpm/action-setup@v4
        with:
          version: "9"
      step 3 "Use Node.js 22"
        uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: "pnpm"
      step 4 "Run pnpm install --frozen-lockfile"
        run: "pnpm install --frozen-lockfile"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
      step 5 "Run pnpm run build --if-present"
        run: "pnpm run build --if-present"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
      step 6 "Run pnpm test"
        run: "pnpm test"
        shell: default -> "bash -e {0}"
        working-directory: "packages/app"
        env:
          CI: "true"
          NODE_OPTIONS: "--max-old-space-size=4096"
