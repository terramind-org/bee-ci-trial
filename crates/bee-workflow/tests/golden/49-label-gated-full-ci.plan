# event pull_request action=synchronize
run .github/workflows/full.yml "Full CI"
  run-name: "Add feature"
  event: pull_request ref=refs/pull/42/merge sha=ffffffffffffffffffffffffffffffffffffffff
  permissions: default
  job quick decided=true
    instance "quick"
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run make quick"
        run: "make quick"
        shell: default -> "bash -e {0}"
  job full if="contains(github.event.pull_request.labels.*.name, 'CI:FULL')" decided=true
    instance "full (a)"
      matrix: {"suite":"a"}
      strategy: index=0 total=2 fail-fast=true max-parallel=2
      runs-on: ["self-hosted", "gpu"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run make suite-a LABELS='ci:full area/core'"
        run: "make suite-a LABELS='ci:full area/core'"
        shell: default -> "bash -e {0}"
    instance "full (c)"
      matrix: {"suite":"c"}
      strategy: index=1 total=2 fail-fast=true max-parallel=2
      runs-on: ["self-hosted", "gpu"]
      permissions: default
      timeout-minutes: 360
      step 1 "Run make suite-c LABELS='ci:full area/core'"
        run: "make suite-c LABELS='ci:full area/core'"
        shell: default -> "bash -e {0}"
# event pull_request_target action=synchronize
