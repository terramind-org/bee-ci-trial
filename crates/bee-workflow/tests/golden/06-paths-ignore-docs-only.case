event: push refs/heads/main files=docs/guide.md,README.md
--- .github/workflows/ci.yml
name: CI
on:
  push:
    paths-ignore:
      - 'docs/**'
      - '**.md'
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - run: make test
--- .github/workflows/docs.yml
name: Docs
on:
  push:
    branches: [main]
    paths: ['docs/**']
jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - run: make docs
