# event push action=-
run .github/workflows/ci.yml "CI"
  run-name: "Update code"
  event: push ref=refs/heads/main sha=2222222222222222222222222222222222222222
  permissions: default
  job lint decided=true
    instance "lint"
      runs-on: ["ubuntu-latest"]
      permissions: default
      timeout-minutes: 360
      env:
        CALLER_ONLY: "not-propagated"
      step 1 "Run make lint"
        run: "make lint"
        shell: default -> "bash -e {0}"
  job test needs=[lint]
    call "test"
      inputs: {"node-version":"20","coverage":true,"shards":2,"ref":"main"}
      secrets: inherit
      workflow: "Reusable tests"
      job unit decided=true
        instance "unit (1)"
          matrix: {"shard":1}
          strategy: index=0 total=2 fail-fast=true max-parallel=2
          runs-on: ["ubuntu-latest"]
          permissions: default
          timeout-minutes: 360
          env:
            CALLEE_ENV: "from-callee"
          outputs:
            report: "${{ steps.cov.outputs.url }}"
          step 1 "Run actions/checkout@v4"
            uses: actions/checkout@v4
            with:
              ref: "main"
          step 2 "Run actions/setup-node@v4"
            uses: actions/setup-node@v4
            with:
              node-version: "20"
          step 3 "Run npm test -- --shard=1/2"
            run: "npm test -- --shard=1/2"
            shell: default -> "bash -e {0}"
          step 4 "Run echo \"url=https://cov.example/2222222222222222222222222222222222222222\" >> \"$GITHUB_OUTPUT\"" id=cov if="inputs.coverage"
            run: "echo \"url=https://cov.example/2222222222222222222222222222222222222222\" >> \"$GITHUB_OUTPUT\""
            shell: default -> "bash -e {0}"
        instance "unit (2)"
          matrix: {"shard":2}
          strategy: index=1 total=2 fail-fast=true max-parallel=2
          runs-on: ["ubuntu-latest"]
          permissions: default
          timeout-minutes: 360
          env:
            CALLEE_ENV: "from-callee"
          outputs:
            report: "${{ steps.cov.outputs.url }}"
          step 1 "Run actions/checkout@v4"
            uses: actions/checkout@v4
            with:
              ref: "main"
          step 2 "Run actions/setup-node@v4"
            uses: actions/setup-node@v4
            with:
              node-version: "20"
          step 3 "Run npm test -- --shard=2/2"
            run: "npm test -- --shard=2/2"
            shell: default -> "bash -e {0}"
          step 4 "Run echo \"url=https://cov.example/2222222222222222222222222222222222222222\" >> \"$GITHUB_OUTPUT\"" id=cov if="inputs.coverage"
            run: "echo \"url=https://cov.example/2222222222222222222222222222222222222222\" >> \"$GITHUB_OUTPUT\""
            shell: default -> "bash -e {0}"
