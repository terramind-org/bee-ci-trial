# event push action=-
run .github/workflows/docker.yml "Docker"
  run-name: "Update code"
  event: push ref=refs/tags/v2.0.1 sha=2222222222222222222222222222222222222222
  permissions: default
  job build decided=true
    instance "build"
      runs-on: ["ubuntu-latest"]
      permissions: contents=read, packages=write, id-token=write
      timeout-minutes: 360
      env:
        REGISTRY: "ghcr.io"
        IMAGE_NAME: "octo-org/widget"
      step 1 "Checkout repository"
        uses: actions/checkout@v4
      step 2 "Set up QEMU"
        uses: docker/setup-qemu-action@v3
      step 3 "Set up Docker Buildx"
        uses: docker/setup-buildx-action@v3
      step 4 "Log into registry ${{ env.REGISTRY }}" if="github.event_name != 'pull_request'"
        uses: docker/login-action@v3
        with:
          registry: "${{ env.REGISTRY }}"
          username: "mona"
          password: "${{ secrets.GITHUB_TOKEN }}"
      step 5 "Extract Docker metadata" id=meta
        uses: docker/metadata-action@v5
        with:
          images: "${{ env.REGISTRY }}/${{ env.IMAGE_NAME }}"
      step 6 "Build and push Docker image" id=build-and-push
        uses: docker/build-push-action@v6
        with:
          context: "."
          platforms: "linux/amd64,linux/arm64"
          push: "true"
          tags: "${{ steps.meta.outputs.tags }}"
          labels: "${{ steps.meta.outputs.labels }}"
          cache-from: "type=gha"
          cache-to: "type=gha,mode=max"
