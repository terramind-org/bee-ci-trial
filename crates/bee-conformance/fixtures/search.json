{
  "service": "bee.v1.SearchService",
  "note": "The code index is filled by a background indexer (every search.poll_ms = 500 ms on the dev server), so whether main's seed content is indexed when a fixture runs depends on timing. The index-backed fixtures (SearchCode, StreamSearchCode, SearchSymbols, GetSymbolDefinitions, GetSymbolReferences) therefore ask for names that never reach an indexed ref: the code queries use a needle no file contains, and the symbol lookups read a unique function from a changeset kept on a side ref (only main is indexed), so their answers are the same whenever the indexer runs.",
  "fixtures": [
    {"method": "SearchCode", "request": {"query": "zqx_search_code_fixture_needle repo:{{repo}}", "contextLines": 1, "includeFacets": true}, "expect": "ok"},
    {"method": "StreamSearchCode", "request": {"query": "zqx_stream_search_code_fixture_needle repo:{{repo}}", "contextLines": 1, "includeFacets": true}, "expect": "ok"},
    {"method": "SearchSymbols", "request": {"query": "zqx_search_symbols_fixture_needle repo:{{repo}}", "kinds": ["SYMBOL_KIND_FUNCTION"]}, "expect": "ok"},
    {"method": "GetSymbolDefinitions",
     "setup": [{"commit": {"repo": "{{repo}}", "parent": "main", "files": {"src/get_symbol_definitions.rs": "pub fn get_symbol_definitions_fixture() {}\n\npub fn caller() {\n    get_symbol_definitions_fixture();\n}\n"}, "message": "get-symbol-definitions fixture", "change": 8001, "createRef": "get-symbol-definitions-fixture"}, "save": "c"}],
     "request": {"repo": {"fullName": "{{repo}}"}, "at": {"expr": "{{c.id}}"}, "path": "c3JjL2dldF9zeW1ib2xfZGVmaW5pdGlvbnMucnM=", "line": 4, "column": 8}, "expect": "ok"},
    {"method": "GetSymbolReferences",
     "setup": [{"commit": {"repo": "{{repo}}", "parent": "main", "files": {"src/get_symbol_references.rs": "pub fn get_symbol_references_fixture() {}\n\npub fn caller() {\n    get_symbol_references_fixture();\n}\n"}, "message": "get-symbol-references fixture", "change": 8002, "createRef": "get-symbol-references-fixture"}, "save": "c"}],
     "request": {"repo": {"fullName": "{{repo}}"}, "at": {"expr": "{{c.id}}"}, "path": "c3JjL2dldF9zeW1ib2xfcmVmZXJlbmNlcy5ycw==", "line": 1, "column": 8, "includeDeclaration": true}, "expect": "ok"},
    {"method": "GetDocumentSymbols", "request": {"repo": {"fullName": "{{repo}}"}, "at": {"expr": "main"}, "path": "c3JjL2xpYi5ycw=="}, "expect": "ok"},
    {"method": "SearchIssues", "request": {"query": "seed repo:{{repo}} is:issue", "sort": "created", "order": "SEARCH_SORT_ORDER_DESC", "includeTextMatches": true}, "expect": "ok"},
    {"method": "SearchRepos", "request": {"query": "playground", "includeTextMatches": true}, "expect": "ok"},
    {"method": "SearchChangesets", "request": {"query": "seed repo:{{repo}}", "includeTextMatches": true}, "expect": "ok"},
    {"method": "SearchUsers", "request": {"query": "type:org dev"}, "expect": "ok"},
    {"method": "SearchTopics",
     "setup": [{"call": "RepoService/CreateRepo", "request": {"org": "{{org}}", "name": "search-topics-fixture", "description": "search-topics fixture", "topics": ["search-topics-fixture"]}}],
     "request": {"query": "search-topics"}, "expect": "ok"},
    {"method": "SearchDiscussions",
     "setup": [
       {"call": "RepoService/CreateRepo", "request": {"org": "{{org}}", "name": "search-discussions-fixture", "description": "search-discussions fixture"}},
       {"call": "RepoService/UpdateRepoSettings", "request": {"repo": {"fullName": "{{org}}/search-discussions-fixture"}, "hasDiscussions": true}},
       {"call": "DiscussionService/CreateDiscussionCategory", "save": "cat", "request": {"repo": {"fullName": "{{org}}/search-discussions-fixture"}, "name": "search-discussions-fixture", "emoji": ":speech_balloon:", "description": "search-discussions fixture", "format": "DISCUSSION_CATEGORY_FORMAT_OPEN_ENDED"}},
       {"call": "DiscussionService/CreateDiscussion", "request": {"repo": {"fullName": "{{org}}/search-discussions-fixture"}, "categoryId": "{{cat.id}}", "title": "Searchable discussion fixture", "body": "a discussion the search finds"}}
     ],
     "request": {"query": "searchable repo:{{org}}/search-discussions-fixture", "includeTextMatches": true}, "expect": "ok"},
    {"method": "SearchPackages", "request": {"query": "search-packages-fixture", "sort": "updated"}, "expect": "ok"},
    {"method": "ParseSearchQuery", "request": {"kind": "SEARCH_QUERY_KIND_ISSUES", "query": "is:open author:@me billing"}, "expect": "ok"},
    {"method": "CreateSavedSearch", "save": "ss",
     "request": {"name": "create-saved-search-fixture", "kind": "SEARCH_QUERY_KIND_ISSUES", "query": "IS:open author:@me", "sort": "created", "order": "SEARCH_SORT_ORDER_DESC", "repo": {"fullName": "{{repo}}"}}, "expect": "ok"},
    {"method": "GetSavedSearch", "request": {"savedSearchId": "{{ss.id}}"}, "expect": "ok"},
    {"method": "UpdateSavedSearch", "request": {"savedSearchId": "{{ss.id}}", "name": "update-saved-search-fixture", "pinned": true}, "expect": "ok"},
    {"method": "ListSavedSearches", "request": {"kind": "SEARCH_QUERY_KIND_ISSUES"}, "expect": "ok"},
    {"method": "DeleteSavedSearch", "request": {"savedSearchId": "{{ss.id}}"}, "expect": "ok"},
    {"method": "ListTrendingRepos", "request": {"window": "TRENDING_WINDOW_WEEKLY"}, "expect": "ok"},
    {"method": "ListTrendingDevelopers", "request": {"window": "TRENDING_WINDOW_WEEKLY", "includeAgents": true}, "expect": "ok"},
    {"method": "ListLeaderboard", "request": {"window": "TRENDING_WINDOW_WEEKLY", "subject": "LEADERBOARD_SUBJECT_REPOS", "metric": "LEADERBOARD_METRIC_LANDS", "page": {"pageSize": 10}}, "expect": "ok"},
    {"method": "GetTopic",
     "setup": [{"call": "RepoService/CreateRepo", "request": {"org": "{{org}}", "name": "get-topic-fixture", "description": "get-topic fixture", "topics": ["get-topic-fixture"]}}],
     "request": {"name": "get-topic-fixture", "topRepoCount": 5}, "expect": "ok"},
    {"method": "ListFeaturedTopics", "request": {"page": {"pageSize": 10}}, "expect": "ok"},
    {"method": "ListTopicCollections", "request": {"page": {"pageSize": 10}}, "expect": "ok"},
    {"method": "GetTopicCollection", "request": {"slug": "get-topic-collection-fixture"}, "expect": "NOT_FOUND",
     "note": "topic collections come only from the server's [[search.collections]] config (no RPC creates one) and the dev server configures none (ListTopicCollections is empty), so any slug is NOT_FOUND"}
  ]
}
