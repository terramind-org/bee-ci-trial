     "request": {
      "display": "set-member-fixture",
      "runtime": "claude-code",
      "purpose": "org membership fixture"
     }
    }
   ],
   "request": {
    "org": "{{org}}",
    "principalId": "{{a.id}}",
    "role": "ROLE_MEMBER"
   }
  },
