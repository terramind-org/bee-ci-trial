{
 "service": "bee.v1.GistService",
 "note": "Each fixture creates the gist it acts on in its own setup.",
 "fixtures": [
  {
   "method": "CreateGist",
   "request": {
    "files": {
     "create-gist-fixture.md": "# create-gist fixture\n",
     "hello.rs": "fn main() {}\n"
    },
    "description": "create-gist fixture",
    "public": true
   }
  },
  {
   "method": "GetGist",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "request": {
      "files": {
       "get-gist-fixture.txt": "get gist\n"
      },
      "description": "get-gist fixture",
      "public": true
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}",
    "maxInlineBytes": 4096
   }
  },
  {
   "method": "ListGists",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "request": {
      "files": {
       "list-gists-fixture.txt": "list gists\n"
      },
      "description": "list-gists fixture",
      "public": false
     }
    }
   ],
   "request": {
    "filter": "GIST_LIST_FILTER_MINE",
    "page": {
     "pageSize": 50
    }
   }
  },
  {
   "method": "UpdateGist",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "request": {
      "files": {
       "update-gist-fixture.txt": "before\n",
       "remove-me.txt": "gone soon\n"
      },
      "description": "update-gist fixture",
      "public": true
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}",
    "expectedHead": "{{g.head}}",
    "description": "update-gist fixture (edited)",
    "fileChanges": [
     {
      "filename": "update-gist-fixture.txt",
      "content": "after\n"
     },
     {
      "filename": "remove-me.txt",
      "delete": true
     },
     {
      "filename": "added.txt",
      "content": "new file\n"
     }
    ]
   }
  },
  {
   "method": "DeleteGist",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "request": {
      "files": {
       "delete-gist-fixture.txt": "delete me\n"
      },
      "description": "delete-gist fixture",
      "public": true
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}"
   }
  },
  {
   "method": "ListGistRevisions",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "request": {
      "files": {
       "list-gist-revisions-fixture.txt": "v1\n"
      },
      "description": "list-gist-revisions fixture",
      "public": true
     }
    },
    {
     "call": "GistService/UpdateGist",
     "request": {
      "gistId": "{{g.id}}",
      "fileChanges": [
       {
        "filename": "list-gist-revisions-fixture.txt",
        "content": "v2\n"
       }
      ]
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}",
    "page": {
     "pageSize": 20
    }
   }
  },
  {
   "method": "GetGistRevision",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "request": {
      "files": {
       "get-gist-revision-fixture.txt": "v1\n"
      },
      "description": "get-gist-revision fixture",
      "public": true
     }
    },
    {
     "call": "GistService/UpdateGist",
     "request": {
      "gistId": "{{g.id}}",
      "fileChanges": [
       {
        "filename": "get-gist-revision-fixture.txt",
        "content": "v2\n"
       }
      ]
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}",
    "changeset": "{{g.head}}",
    "maxInlineBytes": 4096
   }
  },
  {
   "method": "GetGistFileRawUrl",
   "setup": [
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "request": {
      "files": {
       "get-gist-file-raw-url-fixture.txt": "raw content\n"
