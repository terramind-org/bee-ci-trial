     "request": {
      "files": {
       "list-gist-forks-fixture.txt": "fork me\n"
      },
      "description": "list-gist-forks fixture (owned by an agent)",
      "public": true
     }
    },
    {
     "call": "GistService/ForkGist",
     "request": {
      "gistId": "{{g.id}}"
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}",
    "page": {
     "pageSize": 20
    }
   },
   "note": "The gist belongs to an agent created in setup (created with its token), so the dev caller may fork it."
  },
  {
