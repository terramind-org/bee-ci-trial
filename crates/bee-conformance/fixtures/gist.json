    }
   ],
   "request": {
    "gistId": "{{g.id}}",
    "filename": "get-gist-file-raw-url-fixture.txt",
    "changeset": "{{g.head}}"
   }
  },
  {
   "method": "ForkGist",
   "setup": [
    {
     "call": "AuthService/CreateAgent",
     "save": "a",
     "request": {
      "display": "fork-gist-owner",
      "runtime": "claude-code",
      "purpose": "second principal for a fixture",
      "org": "{{org}}"
     }
    },
    {
     "call": "AuthService/MintToken",
     "save": "at",
     "request": {
      "principalId": "{{a.id}}",
      "scope": {}
     }
    },
    {
     "call": "GistService/CreateGist",
     "save": "g",
     "token": "{{at.token}}",
     "request": {
      "files": {
       "fork-gist-fixture.txt": "fork me\n"
      },
      "description": "fork-gist fixture (owned by an agent)",
      "public": true
     }
    }
   ],
   "request": {
    "gistId": "{{g.id}}"
   },
   "note": "The gist belongs to an agent created in setup (created with its token), so the dev caller may fork it."
  },
  {
   "method": "ListGistForks",
   "setup": [
    {
     "call": "AuthService/CreateAgent",
     "save": "a",
     "request": {
      "display": "list-gist-forks-owner",
