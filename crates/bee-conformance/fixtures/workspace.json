{
  "service": "bee.v1.WorkspaceService",
  "note": "The first fixture puts devcontainer configs (forwarding port 8080) on ref fixtures/workspaces. Owners may hold at most 10 workspaces, so fixtures share workspaces through CreateWorkspace idempotency keys: `workspace-fixture-shared` (running) and `workspace-fixture-stop-start` (stopped by StopWorkspace, started again by StartWorkspace).",
  "fixtures": [
    {"method": "ListWorkspaceMachineTypes",
     "setup": [{"commit": {"repo": "{{repo}}", "parent": "main", "files": {
        ".devcontainer/devcontainer.json": "{\"name\": \"workspace-fixture\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\", \"forwardPorts\": [8080], \"portsAttributes\": {\"8080\": {\"label\": \"web\", \"protocol\": \"http\"}}}\n",
        ".devcontainer/create-prebuild.json": "{\"name\": \"create-prebuild\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\"}\n",
        ".devcontainer/get-prebuild.json": "{\"name\": \"get-prebuild\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\"}\n",
        ".devcontainer/update-prebuild.json": "{\"name\": \"update-prebuild\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\"}\n",
        ".devcontainer/delete-prebuild.json": "{\"name\": \"delete-prebuild\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\"}\n",
        ".devcontainer/trigger-prebuild.json": "{\"name\": \"trigger-prebuild\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\"}\n",
        ".devcontainer/list-prebuilds.json": "{\"name\": \"list-prebuilds\", \"image\": \"mcr.microsoft.com/devcontainers/base:ubuntu\"}\n"},
        "message": "add workspace devcontainers", "change": 5101, "createRef": "fixtures/workspaces"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "org": "{{org}}", "ref": "fixtures/workspaces"}},
    {"method": "CreateWorkspace", "request": {"repo": {"fullName": "{{repo}}"}, "name": "create-workspace-fixture", "ref": "fixtures/workspaces", "machineType": "standard-4", "idleTimeoutSeconds": "1800", "retentionSeconds": "86400", "region": "local", "sparsePaths": ["c3Jj"], "idempotencyKey": "create-workspace-fixture"}},
    {"method": "GetWorkspace",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"id": "{{w.id}}"}},
    {"method": "ListWorkspaces", "request": {"repo": {"fullName": "{{repo}}"}, "org": "{{org}}", "ownerId": "{{user}}", "states": ["WORKSPACE_STATE_AVAILABLE"], "page": {"pageSize": 10}}},
    {"method": "UpdateWorkspace",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"id": "{{w.id}}", "displayName": "Shared workspace fixture", "idleTimeoutSeconds": "3600", "retentionSeconds": "172800"}},
    {"method": "StopWorkspace",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-stop-start", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-stop-start"}}],
     "request": {"id": "{{w.id}}"}},
    {"method": "StartWorkspace",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-stop-start", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-stop-start"}}],
     "request": {"id": "{{w.id}}"}},
    {"method": "DeleteWorkspace",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "delete-workspace-fixture", "ref": "fixtures/workspaces"}}],
     "request": {"id": "{{w.id}}", "force": false}},
    {"method": "RebuildWorkspace",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"id": "{{w.id}}", "full": true}},
    {"method": "ExportWorkspaceChanges",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"id": "{{w.id}}", "message": "export-workspace-changes fixture", "openChangeRequest": true, "targetRef": "main"},
     "expect": "EMPTY_CHANGE", "note": "the dev server's local workspace provider runs no container or command; a working copy only gains edits when something writes into its directory on the server's disk, which no RPC does, so a valid export reports EMPTY_CHANGE"},
    {"method": "GetWorkspaceConnection",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"id": "{{w.id}}"},
     "volatile": ["/ok/0/webIdeUrl"]},
    {"method": "CreateWorkspacePrebuildConfig", "request": {"repo": {"fullName": "{{repo}}"}, "ref": "fixtures/workspaces", "devcontainerPath": ".devcontainer/create-prebuild.json", "regions": ["local"], "machineTypes": ["basic-2"], "trigger": "WORKSPACE_PREBUILD_TRIGGER_MANUAL", "retainedVersions": 2}},
    {"method": "GetWorkspacePrebuildConfig",
     "setup": [{"call": "WorkspaceService/CreateWorkspacePrebuildConfig", "save": "p", "request": {"repo": {"fullName": "{{repo}}"}, "ref": "fixtures/workspaces", "devcontainerPath": ".devcontainer/get-prebuild.json", "trigger": "WORKSPACE_PREBUILD_TRIGGER_MANUAL"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{p.id}}"}},
    {"method": "ListWorkspacePrebuildConfigs", "request": {"repo": {"fullName": "{{repo}}"}, "page": {"pageSize": 10}}},
    {"method": "UpdateWorkspacePrebuildConfig",
     "setup": [{"call": "WorkspaceService/CreateWorkspacePrebuildConfig", "save": "p", "request": {"repo": {"fullName": "{{repo}}"}, "ref": "fixtures/workspaces", "devcontainerPath": ".devcontainer/update-prebuild.json", "trigger": "WORKSPACE_PREBUILD_TRIGGER_MANUAL"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{p.id}}", "machineTypes": ["standard-4"], "trigger": "WORKSPACE_PREBUILD_TRIGGER_SCHEDULED", "schedule": "0 3 * * *", "retainedVersions": 3, "enabled": false}},
    {"method": "DeleteWorkspacePrebuildConfig",
     "setup": [{"call": "WorkspaceService/CreateWorkspacePrebuildConfig", "save": "p", "request": {"repo": {"fullName": "{{repo}}"}, "ref": "fixtures/workspaces", "devcontainerPath": ".devcontainer/delete-prebuild.json", "trigger": "WORKSPACE_PREBUILD_TRIGGER_MANUAL"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{p.id}}"}},
    {"method": "TriggerWorkspacePrebuild",
     "setup": [{"call": "WorkspaceService/CreateWorkspacePrebuildConfig", "save": "p", "request": {"repo": {"fullName": "{{repo}}"}, "ref": "fixtures/workspaces", "devcontainerPath": ".devcontainer/trigger-prebuild.json", "trigger": "WORKSPACE_PREBUILD_TRIGGER_MANUAL"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "configId": "{{p.id}}"},
     "volatile": ["/ok/0/logUrl"]},
    {"method": "ListWorkspacePrebuilds",
     "setup": [{"call": "WorkspaceService/CreateWorkspacePrebuildConfig", "save": "p", "request": {"repo": {"fullName": "{{repo}}"}, "ref": "fixtures/workspaces", "devcontainerPath": ".devcontainer/list-prebuilds.json", "trigger": "WORKSPACE_PREBUILD_TRIGGER_MANUAL"}},
               {"call": "WorkspaceService/TriggerWorkspacePrebuild", "request": {"repo": {"fullName": "{{repo}}"}, "configId": "{{p.id}}"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "configId": "{{p.id}}", "state": "WORKSPACE_PREBUILD_STATE_READY", "page": {"pageSize": 10}},
     "volatile": ["/ok/0/prebuilds/*/logUrl"]},
    {"method": "ListWorkspacePorts",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"workspaceId": "{{w.id}}"}},
    {"method": "SetWorkspacePortVisibility",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"workspaceId": "{{w.id}}", "port": 8080, "visibility": "WORKSPACE_PORT_VISIBILITY_ORG"}},
    {"method": "GetWorkspaceDotfiles", "request": {"principalId": "{{user}}"}},
    {"method": "SetWorkspaceDotfiles", "request": {"repo": {"fullName": "{{repo}}"}, "installCommand": "./install.sh", "enabled": true}},
    {"method": "GetWorkspaceEgressPolicy", "request": {"scope": {"org": "{{org}}"}}},
    {"method": "SetWorkspaceEgressPolicy",
     "setup": [{"call": "WorkspaceService/CreateWorkspace", "save": "w", "request": {"repo": {"fullName": "{{repo}}"}, "name": "workspace-fixture-shared", "ref": "fixtures/workspaces", "idempotencyKey": "workspace-fixture-shared"}}],
     "request": {"scope": {"workspaceId": "{{w.id}}"}, "defaultAction": "WORKSPACE_EGRESS_DEFAULT_DENY", "allowedDomains": ["crates.io", "*.example.com"], "allowedCidrs": ["203.0.113.0/24"], "deniedDomains": ["blocked.example.org"], "allowPackageRegistries": true, "logDenied": true}},
    {"method": "GetWorkspaceUsage", "request": {"org": "{{org}}", "principalId": "{{user}}", "windowStart": "2026-01-01T00:00:00Z", "windowEnd": "2026-02-01T00:00:00Z"}}
  ]
}
