{
  "service": "bee.v1.BillingService",
  "note": "Read-only methods use org dev; anything that changes billing state acts on `billing-fixture-org`, created by the first fixture, so plans, budgets and hard stops never touch org dev.",
  "fixtures": [
    {"method": "ListBillingPlans",
     "setup": [{"call": "OrgService/CreateOrg", "request": {"name": "billing-fixture-org", "display": "Billing fixtures"}}],
     "request": {"scope": {"org": "{{org}}"}}},
    {"method": "GetAccountBillingPlan", "request": {"scope": {"org": "{{org}}"}}},
    {"method": "ChangeBillingPlan", "request": {"scope": {"org": "billing-fixture-org"}, "planId": "team", "seats": 5, "cycle": "BILLING_CYCLE_YEARLY"}, "expect": "UNIMPLEMENTED", "note": "billing is disabled on the dev server (forge.billing_enabled defaults to false and no RPC turns it on); a valid request gets UNIMPLEMENTED/billing_disabled"},
    {"method": "ListBillingSeats", "request": {"scope": {"org": "{{org}}"}, "page": {"pageSize": 10}}},
    {"method": "QueryBillingUsage", "request": {"scope": {"org": "{{org}}"}, "products": ["BILLING_PRODUCT_ACTIONS_MINUTES", "BILLING_PRODUCT_STORAGE_GB"], "startAt": "2026-01-01T00:00:00Z", "endAt": "2026-02-01T00:00:00Z", "groupBy": ["BILLING_USAGE_GROUPING_PRODUCT"], "repo": {"fullName": "{{repo}}"}, "page": {"pageSize": 10}}},
    {"method": "CreateBillingBudget", "request": {"scope": {"org": "billing-fixture-org"}, "name": "create-billing-budget-fixture", "product": "BILLING_PRODUCT_ACTIONS_MINUTES", "target": {"account": true}, "monthlyAmountMicroUsd": "50000000", "alertThresholdPercents": [75, 90, 100], "alertRecipientIds": ["{{user}}"], "hardStop": false}},
    {"method": "GetBillingBudget",
     "setup": [{"call": "BillingService/CreateBillingBudget", "save": "b", "request": {"scope": {"org": "billing-fixture-org"}, "name": "get-billing-budget-fixture", "product": "BILLING_PRODUCT_STORAGE_GB", "target": {"account": true}, "monthlyAmountMicroUsd": "10000000", "alertThresholdPercents": [90]}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "budgetId": "{{b.id}}"}},
    {"method": "UpdateBillingBudget",
     "setup": [{"call": "BillingService/CreateBillingBudget", "save": "b", "request": {"scope": {"org": "billing-fixture-org"}, "name": "update-billing-budget-fixture", "product": "BILLING_PRODUCT_WORKSPACES_HOURS", "target": {"account": true}, "monthlyAmountMicroUsd": "10000000", "alertThresholdPercents": [90]}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "budgetId": "{{b.id}}", "name": "update-billing-budget-fixture (renamed)", "monthlyAmountMicroUsd": "20000000", "alertThresholdPercents": [50, 100], "alertRecipientIds": ["{{user}}"], "replaceAlerts": true, "hardStop": true}},
    {"method": "DeleteBillingBudget",
     "setup": [{"call": "BillingService/CreateBillingBudget", "save": "b", "request": {"scope": {"org": "billing-fixture-org"}, "name": "delete-billing-budget-fixture", "product": "BILLING_PRODUCT_LFS", "target": {"account": true}, "monthlyAmountMicroUsd": "10000000"}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "budgetId": "{{b.id}}"}},
    {"method": "ListBillingBudgets", "request": {"scope": {"org": "billing-fixture-org"}, "page": {"pageSize": 10}}},
    {"method": "ListInvoices", "request": {"scope": {"org": "{{org}}"}, "status": "INVOICE_STATUS_PAID", "page": {"pageSize": 10}}, "expect": "UNIMPLEMENTED", "note": "billing is disabled on the dev server (forge.billing_enabled defaults to false and no RPC turns it on); a valid request gets UNIMPLEMENTED/billing_disabled"},
    {"method": "GetInvoice", "request": {"scope": {"org": "{{org}}"}, "invoiceId": "01HZZZZZZZZZZZZZZZZZZZZZZZ"}, "expect": "UNIMPLEMENTED", "note": "billing is disabled on the dev server (UNIMPLEMENTED/billing_disabled); even with billing on, invoices are only issued when the billing worker closes a cycle, so no RPC can make one to fetch"},
    {"method": "CreateCostCenter", "request": {"scope": {"org": "billing-fixture-org"}, "name": "create-cost-center-fixture"}},
    {"method": "GetCostCenter",
     "setup": [{"call": "BillingService/CreateCostCenter", "save": "c", "request": {"scope": {"org": "billing-fixture-org"}, "name": "get-cost-center-fixture"}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "costCenterId": "{{c.id}}"}},
    {"method": "UpdateCostCenter",
     "setup": [{"call": "BillingService/CreateCostCenter", "save": "c", "request": {"scope": {"org": "billing-fixture-org"}, "name": "update-cost-center-fixture"}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "costCenterId": "{{c.id}}", "name": "update-cost-center-fixture-renamed"}},
    {"method": "DeleteCostCenter",
     "setup": [{"call": "BillingService/CreateCostCenter", "save": "c", "request": {"scope": {"org": "billing-fixture-org"}, "name": "delete-cost-center-fixture"}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "costCenterId": "{{c.id}}"}},
    {"method": "ListCostCenters", "request": {"scope": {"org": "billing-fixture-org"}, "page": {"pageSize": 10}}},
    {"method": "AddCostCenterResources",
     "setup": [{"call": "BillingService/CreateCostCenter", "save": "c", "request": {"scope": {"org": "billing-fixture-org"}, "name": "add-cost-center-resources-fixture"}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "costCenterId": "{{c.id}}", "principalIds": ["{{user}}"]}},
    {"method": "RemoveCostCenterResources",
     "setup": [{"call": "BillingService/CreateCostCenter", "save": "c", "request": {"scope": {"org": "billing-fixture-org"}, "name": "remove-cost-center-resources-fixture"}},
               {"call": "BillingService/AddCostCenterResources", "request": {"scope": {"org": "billing-fixture-org"}, "costCenterId": "{{c.id}}", "principalIds": ["{{user}}"]}}],
     "request": {"scope": {"org": "billing-fixture-org"}, "costCenterId": "{{c.id}}", "principalIds": ["{{user}}"]}},
    {"method": "GetBillingPaymentMethod", "request": {"scope": {"org": "{{org}}"}}, "expect": "UNIMPLEMENTED", "note": "billing is disabled on the dev server (forge.billing_enabled defaults to false and no RPC turns it on); a valid request gets UNIMPLEMENTED/billing_disabled"},
    {"method": "GetBillingEmailSettings", "request": {"scope": {"org": "{{org}}"}}, "expect": "UNIMPLEMENTED", "note": "billing is disabled on the dev server (forge.billing_enabled defaults to false and no RPC turns it on); a valid request gets UNIMPLEMENTED/billing_disabled"},
    {"method": "UpdateBillingEmailSettings", "request": {"scope": {"org": "billing-fixture-org"}, "primaryEmail": "billing@billing-fixture-org.example.com", "additionalEmails": ["finance@billing-fixture-org.example.com"], "replaceAdditionalEmails": true, "sendReceipts": true, "sendUsageAlerts": true}, "expect": "UNIMPLEMENTED", "note": "billing is disabled on the dev server (forge.billing_enabled defaults to false and no RPC turns it on); a valid request gets UNIMPLEMENTED/billing_disabled"}
  ]
}
