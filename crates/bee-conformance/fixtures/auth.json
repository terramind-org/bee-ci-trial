{
  "service": "bee.v1.AuthService",
  "note": "Tokens that are revoked or pasted are minted in setup; agents that are updated or deactivated are created in setup. Logout always revokes the presented token (the caller's {{token}}), so it runs last, after every other fixture of this service.",
  "fixtures": [
    {"method": "Login", "note": "Token paste (oidc_id_token carrying a bee token): the only login method a dev server can complete without GitHub or an OIDC provider. The pasted token is minted in setup.", "setup": [{"call": "AuthService/MintToken", "save": "t", "request": {"scope": {"repos": ["{{org}}/*"], "actions": ["read"]}}}], "request": {"oidcIdToken": "{{t.token}}"}},
    {"method": "WhoAmI", "request": {}},
    {"method": "CheckAccess", "request": {"repo": {"fullName": "{{repo}}"}, "paths": ["c3JjLw==", "UkVBRE1FLm1k"], "action": "commit"}},
    {"method": "CreateAgent", "request": {"display": "create-agent-fixture", "runtime": "claude-code", "purpose": "conformance fixture agent", "org": "{{org}}"}},
    {"method": "MintToken", "setup": [{"call": "AuthService/CreateAgent", "save": "a", "request": {"display": "mint-token-fixture", "runtime": "claude-code", "purpose": "token minting fixture", "org": "{{org}}"}}], "request": {"principalId": "{{a.id}}", "scope": {"repos": ["{{org}}/*"], "refs": ["ws/*"], "actions": ["read", "commit"], "budget": {"maxChangesets": "10", "maxLanded": "2", "maxUploadBytes": "1048576"}, "session": "mint-token-fixture"}}},
    {"method": "Revoke", "setup": [{"call": "AuthService/MintToken", "save": "t", "request": {"scope": {"repos": ["{{org}}/*"], "actions": ["read"], "session": "revoke-fixture"}}}], "request": {"tokenId": "{{t.tokenId}}"}},
    {"method": "CheckObjectAccess", "setup": [{"call": "AuthService/MintToken", "save": "t", "request": {"scope": {"repos": ["{{org}}/*"], "actions": ["read"], "session": "check-object-access-fixture"}}}], "request": {"repo": {"fullName": "{{repo}}"}, "subjectToken": "{{t.token}}", "ids": ["{{base.objectId}}"]}},
    {"method": "ListTokens", "note": "Lists the tokens of an agent the setup creates and mints one token for: tokens are ordered by their (random) token id, so the caller's own list would order differently on each server.", "setup": [{"call": "AuthService/CreateAgent", "save": "a", "request": {"display": "list-tokens-fixture", "runtime": "claude-code", "purpose": "token listing fixture", "org": "{{org}}"}}, {"call": "AuthService/MintToken", "request": {"principalId": "{{a.id}}", "scope": {"repos": ["{{org}}/*"], "actions": ["read"], "session": "list-tokens-fixture"}}}], "request": {"principalId": "{{a.id}}", "includeRevoked": true, "page": {"pageSize": 100}}},
    {"method": "ListSigningKeys", "request": {}},
    {"method": "GetPrincipal", "request": {"principalId": "{{user}}"}},
    {"method": "UpdateAgentPrincipal", "setup": [{"call": "AuthService/CreateAgent", "save": "a", "request": {"display": "update-agent-fixture", "runtime": "claude-code", "purpose": "before", "org": "{{org}}"}}], "request": {"principalId": "{{a.id}}", "display": "update-agent-fixture-renamed", "runtime": "codex", "purpose": "after"}},
    {"method": "DeactivatePrincipal", "setup": [{"call": "AuthService/CreateAgent", "save": "a", "request": {"display": "deactivate-principal-fixture", "runtime": "claude-code", "purpose": "to be deactivated", "org": "{{org}}"}}], "request": {"principalId": "{{a.id}}", "reason": "deactivate-principal fixture"}},
    {"method": "ListSecondFactors", "request": {}},
    {"method": "BeginSecondFactorEnrollment", "note": "TOTP enrollment is begun but never finished (finishing needs a code computed from the server's random secret at call time), so the dev user gains no active factor; the otpauth URI carries that random secret.", "request": {"kind": "SECOND_FACTOR_KIND_TOTP", "nickname": "begin-second-factor-enrollment fixture"}, "volatile": ["/ok/0/totpUri"]},
    {"method": "FinishSecondFactorEnrollment", "note": "Finishes a recovery-code enrollment (no code needed). Recovery codes alone never trigger a login challenge, so later fixtures are unaffected; DeleteSecondFactor removes the set again.", "setup": [{"call": "AuthService/BeginSecondFactorEnrollment", "save": "b", "request": {"kind": "SECOND_FACTOR_KIND_RECOVERY_CODES"}}], "request": {"enrollmentId": "{{b.enrollmentId}}"}},
    {"method": "DeleteSecondFactor", "setup": [{"call": "AuthService/BeginSecondFactorEnrollment", "save": "b", "request": {"kind": "SECOND_FACTOR_KIND_RECOVERY_CODES"}}, {"call": "AuthService/FinishSecondFactorEnrollment", "save": "f", "request": {"enrollmentId": "{{b.enrollmentId}}"}}], "request": {"id": "{{f.id}}"}},
    {"method": "VerifySecondFactor", "expect": "UNAUTHENTICATED", "note": "A login challenge is only opened for a human with an active TOTP factor, and enrolling TOTP or answering a challenge needs a code computed from the server's random secret at call time, which fixture templates cannot do (harness limitation, reported). The request is well formed; the challenge id is unknown, so the server answers UNAUTHENTICATED.", "request": {"challengeId": "0123456789abcdef0123456789abcdef", "totpCode": "123456"}},
    {"method": "Logout", "request": {}}
  ]
}
