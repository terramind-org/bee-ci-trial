{
  "service": "bee.v1.EventService",
  "note": "Webhooks point at 127.0.0.1:9 (discard port, nothing listens), so pings and redeliveries are logged as failed deliveries without depending on a receiver.",
  "fixtures": [
    {"method": "Subscribe", "request": {"repo": {"fullName": "{{repo}}"}, "fromSeq": "1", "kinds": ["issue.*", "ref.*"]}, "maxItems": 2},
    {"method": "CreateWebhook",
     "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/create-webhook-fixture", "kinds": ["release.*"], "secret": "create-webhook-secret", "format": "WEBHOOK_FORMAT_BEE"}},
    {"method": "DeleteWebhook",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/delete-webhook-fixture", "kinds": ["release.*"]}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}"}},
    {"method": "ListWebhooks", "request": {"repo": {"fullName": "{{repo}}"}, "page": {"pageSize": 50}}},
    {"method": "GetWebhook",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/get-webhook-fixture", "kinds": ["release.*"]}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}"}},
    {"method": "UpdateWebhook",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/update-webhook-fixture", "kinds": ["release.*"]}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}", "url": "http://127.0.0.1:9/update-webhook-fixture-v2", "kinds": ["release.*", "issue.*"], "setKinds": true, "active": false}},
    {"method": "PingWebhook",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/ping-webhook-fixture", "kinds": ["release.*"]}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}"}, "volatile": ["/ok/0/durationMs"], "note": "durationMs is the measured connect time of the failed delivery."},
    {"method": "ListWebhookDeliveries",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/list-webhook-deliveries-fixture", "kinds": ["release.*"]}},
               {"call": "EventService/PingWebhook", "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "webhookId": "{{h.id}}", "page": {"pageSize": 50}}, "volatile": ["/ok/0/deliveries/*/durationMs"], "note": "durationMs is the measured connect time of the failed delivery."},
    {"method": "GetWebhookDelivery",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/get-webhook-delivery-fixture", "kinds": ["release.*"]}},
               {"call": "EventService/PingWebhook", "save": "d", "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "webhookId": "{{h.id}}", "deliveryId": "{{d.id}}"}, "volatile": ["/ok/0/durationMs"], "note": "durationMs is the measured connect time of the failed delivery."},
    {"method": "RedeliverWebhook",
     "setup": [{"call": "EventService/CreateWebhook", "save": "h", "request": {"repo": {"fullName": "{{repo}}"}, "url": "http://127.0.0.1:9/redeliver-webhook-fixture", "kinds": ["release.*"]}},
               {"call": "EventService/PingWebhook", "save": "d", "request": {"repo": {"fullName": "{{repo}}"}, "id": "{{h.id}}"}}],
     "request": {"repo": {"fullName": "{{repo}}"}, "webhookId": "{{h.id}}", "deliveryId": "{{d.id}}"}, "volatile": ["/ok/0/durationMs"], "note": "durationMs is the measured connect time of the failed delivery."},
    {"method": "ListEvents", "request": {"repo": {"fullName": "{{repo}}"}, "fromSeq": "1", "kinds": ["issue.*"], "limit": 10}},
    {"method": "GetEventLogInfo", "request": {"repo": {"fullName": "{{repo}}"}}}
  ]
}
