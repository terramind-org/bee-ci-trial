    {"method": "QueryAuditLog", "note": "filter.repo is given by id: a full_name RepoRef never matches (entries store the repo id; reported).", "setup": [{"call": "RepoService/GetRepo", "save": "r", "request": {"repo": {"fullName": "{{repo}}"}}}], "request": {"org": "{{org}}", "filter": {"actionPrefixes": ["issue."], "repo": {"id": "{{r.id}}"}}, "oldestFirst": true, "page": {"pageSize": 10}}},
