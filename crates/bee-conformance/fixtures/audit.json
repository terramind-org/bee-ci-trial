    {"method": "ExportAuditLog", "save": "ex", "request": {"org": "{{org}}", "filter": {"actionPrefixes": ["issue."]}, "format": "AUDIT_EXPORT_FORMAT_JSON"}},
    {"method": "CreateAuditSink", "save": "sink", "note": "The endpoint is a path on the server itself; the action prefix matches no action, so the worker never delivers and the sink's health is deterministic.", "request": {"org": "{{org}}", "name": "create-audit-sink-fixture", "kind": "AUDIT_SINK_KIND_HTTPS", "endpoint": "{{server}}/audit-sink-fixture/ingest", "actionPrefixes": ["audit-sink-fixture."]}},
