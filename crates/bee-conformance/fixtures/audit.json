    {"method": "UpdateAuditSink", "request": {"id": "{{sink.id}}", "name": "update-audit-sink-fixture", "endpoint": "{{server}}/audit-sink-fixture/ingest2", "actionPrefixes": ["audit-sink-fixture.updated."], "enabled": false}, "volatile": ["/ok/0/deliveredSeq", "/ok/0/lagEntries"], "note": "The delivery worker advances deliveredSeq (and so lagEntries) on its own poll timer; the sink's action prefix matches no action, so it never sends anything and its health stays deterministic."},
    {"method": "ListAuditSinks", "request": {"org": "{{org}}", "page": {"pageSize": 10}}, "volatile": ["/ok/0/sinks/*/deliveredSeq", "/ok/0/sinks/*/lagEntries"], "note": "The delivery worker advances deliveredSeq (and so lagEntries) on its own poll timer; the sink's action prefix matches no action, so it never sends anything and its health stays deterministic."},
    {"method": "TestAuditSink", "request": {"id": "{{sink.id}}"}, "note": "The sink's endpoint is a path the dev server does not serve, so the test delivery reaches the server and is answered 404 (delivered false); a receiver answering 2xx would need a listener outside the server. latencyMs is wall-clock and is omitted when it rounds to 0.", "volatile": ["/ok/0/latencyMs"]},
