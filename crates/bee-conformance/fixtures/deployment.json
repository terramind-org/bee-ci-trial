   "method": "ReportDeploymentProtectionRuleResult",
   "note": "The rule's app is an agent created in setup and made an org member (so it can see the repo); the result is reported as that agent (its minted token). CreateDeployment into an environment with protection rules creates the deployment and answers APPROVAL_REQUIRED (pending_review), so setup expects that and finds the deployment with ListDeployments.",
   "setup": [
    {
     "call": "AuthService/CreateAgent",
     "save": "a",
     "request": {
      "display": "report-rule-gate-agent",
      "runtime": "claude-code",
      "purpose": "deployment protection rule gate",
      "org": "{{org}}"
     }
    },
    {
     "call": "OrgService/SetMember",
     "request": {
      "org": "{{org}}",
      "principalId": "{{a.id}}",
      "role": "ROLE_MEMBER"
     }
