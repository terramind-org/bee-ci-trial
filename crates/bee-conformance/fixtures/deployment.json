     "request": {
      "principalId": "{{a.id}}",
      "scope": {}
     }
    },
    {
     "call": "DeploymentService/CreateDeploymentEnvironment",
     "request": {
      "repo": {
       "fullName": "{{repo}}"
      },
      "name": "report-rule-env-fixture"
     }
    },
    {
