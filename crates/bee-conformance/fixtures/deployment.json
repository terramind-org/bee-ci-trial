     "request": {
      "repo": {
       "fullName": "{{repo}}"
      },
      "environment": "report-rule-env-fixture",
      "appId": "{{a.id}}"
     }
    },
    {
     "call": "DeploymentService/CreateDeployment",
     "request": {
      "repo": {
       "fullName": "{{repo}}"
      },
      "ref": "main",
      "task": "deploy",
      "environment": "report-rule-env-fixture",
      "description": "report rule fixture"
     },
     "expect": "APPROVAL_REQUIRED"
    },
