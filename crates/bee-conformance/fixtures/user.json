{
  "service": "bee.v1.UserService",
  "note": "Most methods act on the caller, the dev user. Another user to follow is an agent principal made in setup. RenameUserLogin renames the dev user, so it runs last but one; DeleteUserAccount is refused because dev is the sole owner of org dev.",
  "fixtures": [
    {"method": "GetUser", "request": {"login": "{{userName}}"}},
    {"method": "GetViewer", "request": {}},
    {"method": "UpdateUserProfile", "request": {"name": "Dev Fixture", "bio": "Updated by the UpdateUserProfile fixture", "pronouns": "they/them", "company": "Bee", "location": "Internet", "website": "https://example.com/dev", "socialAccounts": [{"provider": "mastodon", "url": "https://mastodon.example/@dev"}], "replaceSocialAccounts": true, "hireable": true}},
    {"method": "BeginUserAvatarUpload", "request": {"contentType": "image/png", "size": "2048"}},
    {"method": "FinalizeUserAvatarUpload", "setup": [{"call": "UserService/BeginUserAvatarUpload", "save": "b", "request": {"contentType": "image/png", "size": "2048"}}], "request": {"uploadId": "{{b.uploadId}}", "sha256": "47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU="}},
    {"method": "SetUserStatus", "request": {"message": "Writing fixtures", "emoji": ":memo:", "busy": true, "org": "{{org}}"}},
    {"method": "ClearUserStatus", "setup": [{"call": "UserService/SetUserStatus", "request": {"message": "About to clear", "emoji": ":broom:"}}], "request": {}},
    {"method": "SetUserPinnedItems", "setup": [{"call": "RepoService/GetRepo", "save": "r", "request": {"repo": {"fullName": "{{repo}}"}}}], "request": {"items": [{"kind": "USER_PINNED_ITEM_KIND_REPO", "id": "{{r.id}}"}]}},
    {"method": "ListUserPinnedItems", "request": {"login": "{{userName}}"}},
    {"method": "FollowUser", "setup": [{"call": "AuthService/CreateAgent", "save": "a", "request": {"display": "follow-user-fixture", "runtime": "claude-code", "purpose": "FollowUser fixture", "org": "{{org}}"}}], "request": {"login": "follow-user-fixture"}},
    {"method": "UnfollowUser", "setup": [{"call": "AuthService/CreateAgent", "save": "a", "request": {"display": "unfollow-user-fixture", "runtime": "claude-code", "purpose": "UnfollowUser fixture", "org": "{{org}}"}}, {"call": "UserService/FollowUser", "request": {"login": "unfollow-user-fixture"}}], "request": {"login": "unfollow-user-fixture"}},
    {"method": "ListUserFollowers", "request": {"login": "follow-user-fixture"}},
    {"method": "ListUserFollowing", "request": {"login": "{{userName}}"}},
    {"method": "IsFollowingUser", "request": {"login": "{{userName}}", "targetLogin": "follow-user-fixture"}},
    {"method": "StarRepo", "request": {"repo": {"fullName": "{{repo}}"}}},
    {"method": "UnstarRepo", "setup": [{"call": "RepoService/CreateRepo", "request": {"org": "{{org}}", "name": "unstar-repo-fixture", "visibility": "VISIBILITY_PUBLIC"}}, {"call": "UserService/StarRepo", "request": {"repo": {"fullName": "{{org}}/unstar-repo-fixture"}}}], "request": {"repo": {"fullName": "{{org}}/unstar-repo-fixture"}}},
    {"method": "IsRepoStarred", "request": {"repo": {"fullName": "{{repo}}"}}},
    {"method": "ListStarredRepos", "request": {"login": "{{userName}}", "sort": "created"}},
    {"method": "ListRepoStargazers", "request": {"repo": {"fullName": "{{repo}}"}}},
    {"method": "CreateStarList", "request": {"name": "create-star-list-fixture", "description": "made by the CreateStarList fixture", "private": false}},
    {"method": "GetStarList", "setup": [{"call": "UserService/CreateStarList", "save": "l", "request": {"name": "get-star-list-fixture", "description": "for GetStarList"}}], "request": {"starListId": "{{l.id}}"}},
    {"method": "ListStarLists", "request": {"login": "{{userName}}"}},
    {"method": "UpdateStarList", "setup": [{"call": "UserService/CreateStarList", "save": "l", "request": {"name": "update-star-list-fixture", "description": "for UpdateStarList"}}], "request": {"starListId": "{{l.id}}", "name": "update-star-list-fixture-renamed", "description": "updated by the UpdateStarList fixture", "private": true}},
    {"method": "DeleteStarList", "setup": [{"call": "UserService/CreateStarList", "save": "l", "request": {"name": "delete-star-list-fixture", "description": "for DeleteStarList"}}], "request": {"starListId": "{{l.id}}"}},
    {"method": "AddStarListRepo", "setup": [{"call": "UserService/CreateStarList", "save": "l", "request": {"name": "add-star-list-repo-fixture", "description": "for AddStarListRepo"}}], "request": {"starListId": "{{l.id}}", "repo": {"fullName": "{{repo}}"}}},
    {"method": "RemoveStarListRepo", "setup": [{"call": "UserService/CreateStarList", "save": "l", "request": {"name": "remove-star-list-repo-fixture", "description": "for RemoveStarListRepo"}}, {"call": "UserService/AddStarListRepo", "request": {"starListId": "{{l.id}}", "repo": {"fullName": "{{repo}}"}}}], "request": {"starListId": "{{l.id}}", "repo": {"fullName": "{{repo}}"}}},
    {"method": "ListStarListRepos", "setup": [{"call": "UserService/CreateStarList", "save": "l", "request": {"name": "list-star-list-repos-fixture", "description": "for ListStarListRepos"}}, {"call": "UserService/AddStarListRepo", "request": {"starListId": "{{l.id}}", "repo": {"fullName": "{{repo}}"}}}], "request": {"starListId": "{{l.id}}"}},
    {"method": "GetUserContributionGraph", "request": {"login": "{{userName}}", "fromDate": "2026-01-01", "toDate": "2026-01-31", "timeZone": "UTC", "org": "{{org}}"}},
    {"method": "GetUserActivityOverview", "request": {"login": "{{userName}}", "fromDate": "2026-01-01", "toDate": "2026-01-31", "org": "{{org}}"}},
    {"method": "AddUserEmail", "request": {"email": "add-user-email-fixture@example.com"}},
    {"method": "DeleteUserEmail", "setup": [{"call": "UserService/AddUserEmail", "request": {"email": "delete-user-email-fixture@example.com"}}], "request": {"email": "delete-user-email-fixture@example.com"}},
    {"method": "ListUserEmails", "request": {}},
    {"method": "SetPrimaryUserEmail", "request": {"email": "set-primary-user-email-fixture@example.com"}, "setup": [{"call": "UserService/AddUserEmail", "request": {"email": "set-primary-user-email-fixture@example.com"}}], "expect": "INVALID_STATE", "note": "Only a verified address can be primary (unverified_email). Verifying needs the token mailed to the address (Users::verify_email has no RPC), and the dev user has no verified email, so no address can become primary on a dev server."},
    {"method": "UpdateUserEmailVisibility", "request": {"keepPrivate": true, "blockPrivatePushes": false}},
    {"method": "ResendUserEmailVerification", "setup": [{"call": "UserService/AddUserEmail", "request": {"email": "resend-user-email-verification-fixture@example.com"}}], "request": {"email": "resend-user-email-verification-fixture@example.com"}},
    {"method": "ResolveUserCommitEmails", "request": {"emails": ["add-user-email-fixture@example.com", "nobody-resolve-fixture@example.com"]}},
    {"method": "AddUserSshKey", "request": {"title": "add-user-ssh-key-fixture", "publicKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL4vNVPv68ywC+CyjFwXbvAy3JpPUtHrIPBxqoCpVU9l user-fixture-ssh"}, "expect": "UNIMPLEMENTED", "note": "The dev server answers served_elsewhere (owner: identity) for this valid request: UserService.AddUserSshKey is not served by the forge core."},
    {"method": "ListUserSshKeys", "request": {"login": "{{userName}}"}, "expect": "UNIMPLEMENTED", "note": "The dev server answers served_elsewhere (owner: identity) for this valid request: UserService.ListUserSshKeys is not served by the forge core."},
    {"method": "DeleteUserSshKey", "request": {"keyId": "01J0000000000000000000SSHK"}, "expect": "UNIMPLEMENTED", "note": "The dev server answers served_elsewhere (owner: identity) for this valid request: UserService.DeleteUserSshKey is not served by the forge core. Nothing on the dev server can create the key or session to name, so the id is a placeholder; the call is refused before it is looked up."},
    {"method": "AddUserSigningKey", "request": {"kind": "USER_SIGNING_KEY_KIND_SSH", "title": "add-user-signing-key-fixture", "publicKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIGxGB0dGKql7x3arsacxZZIEpbYSzhT2gZAA5b/8TLsN user-fixture-sign"}},
    {"method": "ListUserSigningKeys", "setup": [{"call": "UserService/AddUserSigningKey", "request": {"kind": "USER_SIGNING_KEY_KIND_SSH", "title": "list-user-signing-keys-fixture", "publicKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIL4vNVPv68ywC+CyjFwXbvAy3JpPUtHrIPBxqoCpVU9l"}}], "request": {"login": "{{userName}}", "kind": "USER_SIGNING_KEY_KIND_SSH"}},
    {"method": "DeleteUserSigningKey", "setup": [{"call": "UserService/AddUserSigningKey", "save": "k", "request": {"kind": "USER_SIGNING_KEY_KIND_SSH", "title": "delete-user-signing-key-fixture", "publicKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKMqFAz4tFxvtTTFxZ6xs4nrmpzRtNa95qlTqdnQcDD5"}}], "request": {"keyId": "{{k.id}}"}},
    {"method": "GetUserSettings", "request": {}},
    {"method": "UpdateUserSettings", "request": {"theme": "dark", "timeZone": "Europe/Berlin", "locale": "en-GB", "accessibility": [{"key": "reduce_motion", "value": "true"}], "keyboardShortcutsEnabled": true, "editorIndent": "spaces:4", "diffView": "split", "showPrivateContributions": true, "vigilantMode": false}},
    {"method": "ListUserSessions", "request": {}, "expect": "UNIMPLEMENTED", "note": "The dev server answers served_elsewhere (owner: identity) for this valid request: UserService.ListUserSessions is not served by the forge core."},
    {"method": "RevokeUserSession", "request": {"sessionId": "01J0000000000000000000SESS"}, "expect": "UNIMPLEMENTED", "note": "The dev server answers served_elsewhere (owner: identity) for this valid request: UserService.RevokeUserSession is not served by the forge core. Nothing on the dev server can create the key or session to name, so the id is a placeholder; the call is refused before it is looked up."},
    {"method": "ListUserSecurityEvents", "request": {"actionPrefix": "user."}},
    {"method": "RequestUserDataExport", "save": "export", "request": {"includeRepos": true, "includeAttachments": false}},
    {"method": "GetUserDataExport", "request": {"exportId": "{{export.id}}"}},
    {"method": "FollowRepo", "request": {"repo": {"fullName": "{{repo}}"}}},
    {"method": "UnfollowRepo", "setup": [{"call": "UserService/FollowRepo", "request": {"repo": {"fullName": "{{repo}}"}}}], "request": {"repo": {"fullName": "{{repo}}"}}},
    {"method": "IsFollowingRepo", "setup": [{"call": "UserService/FollowRepo", "request": {"repo": {"fullName": "{{repo}}"}}}], "request": {"repo": {"fullName": "{{repo}}"}}},
    {"method": "ListFollowedRepos", "setup": [{"call": "UserService/FollowRepo", "request": {"repo": {"fullName": "{{repo}}"}}}], "request": {"page": {"pageSize": 10}}},
    {"method": "ListRepoFollowers", "setup": [{"call": "UserService/FollowRepo", "request": {"repo": {"fullName": "{{repo}}"}}}], "request": {"repo": {"fullName": "{{repo}}"}, "page": {"pageSize": 10}}},
    {"method": "ListUserFeedEvents", "request": {}},
    {"method": "ListUserAchievements", "request": {"login": "{{userName}}"}},
    {"method": "RenameUserLogin", "request": {"newLogin": "rename-user-login-fixture"}},
    {"method": "DeleteUserAccount", "request": {"confirmLogin": "rename-user-login-fixture", "reason": "DeleteUserAccount fixture"}, "expect": "INVALID_STATE", "note": "The caller is the dev user, the sole owner of org dev; deleting the account is refused (sole_org_owner). Deleting the dev user would break every fixture after it, and no other user can be the caller."}
  ]
}
